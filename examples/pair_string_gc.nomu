// Task 176.3a oracle: a value aggregate holding a `String` by value — `Pair { s: String; n: Int }` — held
// live across a moving collection. The shaped `word0` (the heap StringStorage pointer) sits inside the Pair
// slot; frame-root placement must record the slot and relocate the shaped sub-field in place through the
// aggregate's value-layout descriptor, or `p.s.hash` reads a stale buffer and diverges from the `-c nogc`
// baseline. Before 176.3a the slot was unrecorded — the shaped sub-field invisible to the collector. The
// garbage `Box` arrays drive collections while `p` is live. Run with NOMU_NO_ESCAPE=1 so they are heap.
struct Box {
  var v: Int
}
struct Pair {
  var s: String
  var n: Int
}
fun main() {
  let p = Pair(s: concat("hello", " world"), n: 7)
  var i = 0
  var checksum = 0
  while i < 2000 {
    var xs: Array<Box> = []
    var w = 0
    while w < 1024 {
      xs.append(Box(v: w))
      w = w + 1
    }
    checksum = checksum + p.s.hash + p.n
    i = i + 1
  }
  print(checksum)
  print("\n")
}
