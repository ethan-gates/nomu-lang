// M4.13: the Nomu standard library. `abs`, `max`, `min` are written in Nomu
// (src/stdlib/core.nomu), compiled alongside this program, and callable with no
// import — the first dogfooding of a Nomu-written stdlib.

fun main() {
    print(abs(0 - 7))          // 7
    print(max(3, 9))           // 9
    print(min(3, 9))           // 3
    print(max(abs(0 - 4), 2))  // 4  — composed
}
