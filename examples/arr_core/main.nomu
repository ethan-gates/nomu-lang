class Box {
  var v: Int
}


fun main() {
    let a: Array<Int> = [10, 20, 30]
    print(a.count)          // 3
    print(a[0])             // 10
    print(a[2])             // 30
    var i = 0
    var sum = 0
    while i < a.count {
        sum = sum + a[i]
        i = i + 1
    }
    print(sum)              // 60
    let xs = [Box(v: 100), Box(v: 200)]
    print(xs[1].v)          // 200 — reference elements
}
