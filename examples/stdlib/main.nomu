// The Nomu standard library, written in Nomu: `abs`, `max`, `min` come from `std/math` (an explicit
// import); the generic `Option<T>` is in the prelude (`std`'s default module, implicitly imported).

import std/math

fun main() {
    print(abs(-7))             // 7
    print(max(3, 9))           // 9
    print(min(3, 9))           // 3
    print(max(abs(-4), 2))     // 4  — composed

    // `Option<T>` is a prelude citizen — no definition, no import.
    let found: Option<Int> = .some(value: max(2, 5))
    switch found {
    case .some(let v): print(v)      // 5
    case .none:        print(0)
    }
    let missing: Option<Int> = .none
    switch missing {
    case .some(let v): print(v)
    case .none:        print(min(8, 1))   // 1
    }
}
