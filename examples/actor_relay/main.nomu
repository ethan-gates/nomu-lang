// Actor regression (M6 · 6.4 · fire-and-forget mailbox). Exercises the paths a single-actor demo
// doesn't, and doubles as a stress reproducer for the M:N park protocol:
//   - many concurrent senders serialized through one mailbox — the total is exact regardless of
//     interleaving (single-drain + FIFO),
//   - actor -> actor message-send: a Relay handler forwards into a Sum actor, so a pool worker
//     draining Relay sends to Sum's mailbox. That inter-actor traffic is what surfaced the park race
//     the lock-handoff protocol fixes.
//
// Determinism without request-reply: the final `report` is routed *through* the relay. The workers
// are joined before `finish` is sent, so Relay's mailbox holds 400 `forward`s then `finish` (FIFO);
// Relay drains them in order, sending `add` x400 then `report` to Sum — and since Relay is the sole
// sender to Sum, per-sender FIFO means Sum applies all 400 adds before it reports. Prints 400 under
// both NoGC and GenImmix, stable across runs. Drain-to-quiescence keeps the program alive until done.

actor Sum {
    var total: Int = 0
    on add(n: Int) { total += n }
    on report() { print(total) }
}

actor Relay {
    var sink: Sum
    on forward(n: Int) { sink.add(n: n) }   // actor -> actor: forwards into the shared Sum
    on finish() { sink.report() }            // ordered after all forwards this Relay has drained
}

fun worker(r: Relay) -> Int {
    var i = 0
    while i < 100 {
        r.forward(n: 1)
        i = i + 1
    }
    return i
}

fun runWorkers(r: Relay) {
    spawn let a = worker(r)
    spawn let b = worker(r)
    spawn let c = worker(r)
    spawn let d = worker(r)
}

fun main() {
    let s = Sum()
    let r = Relay(sink: s)
    runWorkers(r)   // 400 forwards enqueued on Relay (workers joined)
    r.finish()      // FIFO after them → Relay sends report to Sum after all 400 adds → prints 400
}
