// Task 150.3.10.1 / 150.3.13 — multi-carrier self-hosted allocation, with collection. Four worker fibers
// each keep a sliding window of 64 live Boxes while allocating 6M Boxes (the rest garbage). Under
// NOMU_RUNTIME=selfhost NOMU_CARRIERS=4 they run on four carriers at once, bumping per-carrier TLABs and
// refilling the shared Immix block pool CONCURRENTLY — the race the 150.3.10.1 split closes. Total
// live+garbage (4 × 6M × 16 B = 384 MiB ≫ 256 MiB heap) forces repeated defrag collections while all four
// carriers allocate: the collector stops every carrier, evacuates survivors across four stacks, resets all
// four TLABs, and (150.3.13) keeps each completed-but-unjoined worker's result box rooted until main joins it.
// Each worker returns a checksum over its live window; the sum is order/address-independent, so it must match
// MMTk NoGC exactly. Run with NOMU_NO_ESCAPE=1 so the Boxes are real heap objects.
class Box {
  var v: Int
}

fun worker(id: Int) -> Int {
  var xs: Array<Box> = []
  var w = 0
  while w < 64 {
    xs.append(Box(v: id))
    w = w + 1
  }
  var i = 0
  while i < 6000000 {                // 4 workers × 6M × 16 B = 384 MiB ≫ 256 MiB heap → repeated collection
    xs[i % 64] = Box(v: i + id)      // overwrite → old Box garbage; new Box escapes into this worker's buffer
    i = i + 1
  }
  var s = 0
  var j = 0
  while j < 64 {
    s = s + xs[j].v                  // reads through the (possibly relocated) buffer + Box pointers
    j = j + 1
  }
  return s % 100000
}

fun main() {
  spawn let a = worker(1)
  spawn let b = worker(2)
  spawn let c = worker(3)
  spawn let d = worker(4)
  print((a + b + c + d) % 1000000)   // deterministic — identical under MMTk and the self-hosted allocator
  print("\n")
}
