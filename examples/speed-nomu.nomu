

fun test_speed() {
    var count = 1

    // 100 million iterations
    for i in range(10000) {
        for j in range(10000) {
            if count > 10000 {
                count = (count - i) / 2
            } else {
                count = (count + j) * 3
            }
        }
    }
}

test_speed()
