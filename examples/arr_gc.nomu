// M6 stdlib · Slice 4 — arrays under the moving collector. Builds a live Array<Box> by appending
// (reallocating + evacuating the variable-size buffer) while allocating garbage to force collections.
// Every surviving Box must be relocated and its pointer inside the buffer updated; the buffer itself
// relocates too. Run under NOMU_GC_STRESS=<bytes> and it must match the NoGC output.
class Box {
  var v: Int
}

fun main() {
  var xs: Array<Box> = []
  var i = 0
  while i < 200 {
    xs.append(Box(v: i))       // live: enters the array (buffer → Box, a traced chain)
    let junk = Box(v: 0 - 1)   // garbage: dead after this iteration
    i = i + 1
  }
  var sum = 0
  var j = 0
  while j < xs.count {
    sum = sum + xs[j].v        // reads through the relocated buffer + relocated Box pointers
    j = j + 1
  }
  print(xs.count)              // 200
  print(sum)                   // 0+1+...+199 = 19900
}
