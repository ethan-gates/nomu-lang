// `task f(x)` runs a call on a new fiber; `join()` waits for its result. Arguments are evaluated where the
// task starts, so `plus(base, 5)` sees `base` as it is then.

fun sq(n : Int) -> Int{return n * n}

fun plus(a: Int, b: Int) -> Int{return a + b}

fun main() {
    let base = 10
    let a = task sq(3)              // 9,  concurrent
    let b = task sq(4)              // 16, concurrent
    let c = task plus(base, 5)      // 15
    print(a.join() + b.join())      // 25
    print(c.join())                 // 15
}
