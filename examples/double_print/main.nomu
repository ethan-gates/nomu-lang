// `print(Double)` on edge values (suite case `double-print`): the fewest significant digits that read back
// to the same value, always with a decimal point, including subnormals, the largest finite value, values
// needing all 17 digits, signed zero, infinities and NaN. Nomu has no exponent literals, so the extremes
// are built by repeated halving and doubling, which is exact.
fun pow2(n: Int) -> Double {
    var x = 1.0
    var i = 0
    while i < n {
        x = x * 2.0
        i = i + 1
    }
    var j = 0
    while j > n {
        x = x / 2.0
        j = j - 1
    }
    return x
}

fun main() {
    print(0.1)
    print(1.0 / 3.0)
    print(2.0 / 3.0)
    print(100.0)
    print(123456789.0)
    print(1000000000000000000000.0)
    print(10000000000000000000000.0)
    print(0.0000001)
    print(0.000001)
    print(pow2(0 - 1074))
    print(pow2(0 - 1022))
    print((2.0 - pow2(0 - 52)) * pow2(1023))
    print(0.1 + 0.2)
    print(0.0)
    let z = 0.0
    print(0.0 - z)
    print(1.0 / z)
    print((0.0 - 1.0) / z)
    print(z / z)
    print(time_monotonic() > 0)
}
