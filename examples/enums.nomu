// M4.10: enum value construction (qualified + leading-dot) and `let` fields.

enum Shape { case circle(radius: Int) case rect(w: Int, h: Int) }
enum Color { case red case green case blue }

struct Config {
    let scale: Int      // immutable field
    var offset: Int     // mutable field
}

fun area(s: Shape) -> Int {
    switch s {
    case .circle(let r):      return 3 * r * r
    case .rect(let w, let h): return w * h
    }
}

fun colorCode(c: Color) -> Int {
    switch c {
    case .red:   return 1
    case .green: return 2
    case .blue:  return 3
    }
}

fun makeCircle(r: Int) -> Shape {
    return .circle(radius: r)          // leading-dot, inferred from the return type
}

fun main() {
    let c = Shape.circle(radius: 10)   // qualified, with payload
    print(area(c))                     // 300
    let r: Shape = .rect(w: 3, h: 4)   // leading-dot, inferred from the annotation
    print(area(r))                     // 12
    print(area(makeCircle(r: 5)))      // 75
    print(area(.rect(w: 2, h: 5)))     // leading-dot in argument position -> 10
    print(colorCode(Color.blue))       // qualified, no payload -> 3
    print(colorCode(.red))             // leading-dot, no payload -> 1

    var cfg = Config(scale: 2, offset: 7)
    cfg.offset = 10                    // var field: allowed
    print(cfg.scale + cfg.offset)      // 12
}
