// Shareability: what a `task` is passed must be shareable — primitives, structs whose
// fields are shareable, deeply immutable classes, actors. A class with a mutable field
// stays on its own fiber.

struct Point {
    var x: Int
    var y: Int
}

fun sumPoint(p: Point) -> Int {
    return p.x + p.y
}

fun twice(n: Int) -> Int {
    return n * 2
}

fun applyOffset(offset: Int, x: Int) -> Int {
    let addOffset = { (y: Int) -> Int in return y + offset }
    return apply(addOffset, x)
}

fun apply(f: (Int) -> Int, x: Int) -> Int {
    return f(x)
}

fun main() {
    // Structs are value types — shareable across task boundaries.
    let p = Point(x: 3, y: 4)
    let s = task sumPoint(p)
    print(s.join())   // 7

    // Primitives (Int) are shareable.
    let base = 10
    let d = task twice(base)
    print(d.join())   // 20

    // A closure value is not passed to a task yet (its captures are not in its type); the task builds it.
    let r = task applyOffset(5, 100)
    print(r.join())   // 105
}

