// `readLine` parks the calling fiber until stdin has a line, so its carrier keeps running other fibers. The
// suite writes stdin only once the ticker has printed its three ticks (suite case `read-line`, built with
// `test.runtime_prelude`): `main` waits for its first line while they print, even on one carrier. Then: a
// second line, an unterminated last line returned whole, and end of input as an empty string.

// Tell the harness to write stdin (the suite case's `stdin_after`): stderr is unbuffered, so the line
// arrives as it is written.
fun signalReady() {
  let buf = RawPtr.alloc(bytes: 16, align: 8)
  let n = Runtime.copyLiteral(to: buf, "ready\n")
  let w = Runtime.writeFd(fd: 2, buf: buf, count: n)
  buf.free()
}

fun ticker() -> Int {
  var i = 0
  while i < 3 {
    sleep(50)
    print("tick\n")
    i = i + 1
  }
  signalReady()
  return i
}

fun show(s: String) {
  print("got '")
  print(s)
  print("' ")
  print(s.count)
  print("\n")
}

fun main() {
  spawn let t = ticker()
  show(readLine())
  show(readLine())
  show(readLine())
  show(readLine())
  print(t)
  print("\n")
}
