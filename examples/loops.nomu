// Loops (`design/loops.md`): the pre-tested `while` loop with `break` and `continue`.
// Iteration is `var i = 0; while i < n { …; i += 1 }` until `for … in` and ranges land.

fun sumTo(n: Int) -> Int {
    var i = 1
    var sum = 0
    while i <= n {
        sum += i
        i += 1
    }
    return sum
}

fun main() {
    print(sumTo(100))            // 5050

    // break / continue: print odd numbers below 6, stop at 6.
    var i = 0
    while i < 100 {
        i += 1
        if i == 6 { break }
        if i == i / 2 * 2 { continue }   // skip evens
        print(i)                 // 1, 3, 5
    }

    // nested loops; the inner `break` targets the innermost loop only.
    var r = 0
    while r < 3 {
        var c = 0
        while c < 3 {
            if c == 2 { break }
            print(r * 10 + c)    // 0 1  10 11  20 21
            c += 1
        }
        r += 1
    }
}
