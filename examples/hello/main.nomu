struct Point {
    var x : Int
    var y : Int
}

enum Shape {
    case circle(radius: Int)
    case rect(w: Int, h: Int)
}

fun area(s: Shape) -> Int {

    switch
        s {
        case.circle(let r):
        return 3 * r * r case.rect(let w, let h):
            return w * h
        }
}

fun main() { let p = Point(x : 3, y : 4) print(p.x) }
