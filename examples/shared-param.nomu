// The `shared` bound (M5 5.3.2). A generic function that forwards its type
// parameter across a task boundary declares `<shared T>`; inside the body a
// `shared T` may cross the boundary, and every caller must pass a shareable type.

struct Pair {
    let a: Int
    let b: Int
}

fun onTask<shared T>(x: T) -> T {
    spawn let r = x        // ok: T is `shared`, so it may cross the task boundary
    return r
}

fun main() {
    // Int is shareable → the `shared` bound is satisfied.
    let n = onTask(41)
    print(n)               // 41

    // A value struct with shareable fields is shareable too.
    let p = onTask(Pair(a: 1, b: 2))
    print(p.a)             // 1
}

