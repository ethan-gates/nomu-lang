// The actor run-queue entries as GC roots under a moving collection.
//
// `blast` creates many short-lived Worker actors. Each gets `nMsgs` fire-and-forget `add` messages and a
// final `report`, then its handle is dropped at the end of the loop iteration — so from that point the
// actor, its mailbox, and every queued message are reachable ONLY through the run queues, where a scheduled
// mailbox waits as a tagged entry: the carrier's slot and ring, and past the ring's 256 the global queue, bound
// to a mailbox fiber (fib+192). With one carrier the sends all run before any drain, so the whole backlog of
// mailboxes sits in those queues while the drain begins.
//
// Each `add` handler allocates a throwaway sliding window of Boxes (garbage the moment the handler returns),
// so draining the backlog over-allocates far past the 256 MiB heap and forces repeated collections WHILE
// later workers' mailboxes are still queued. Those queued mailboxes carry live messages whose `self`
// receiver and `v` arg must survive each collection. Absent the roots, a collection mid-drain reclaims or moves
// a queued mailbox and its messages, and the surviving actors' sums diverge (or the program faults on a stale
// pointer).
//
// Each Worker sums the values it receives (0..nMsgs-1 in FIFO order, so 1225) and reports it to a Tally, which
// prints how many reported and how many were wrong once all have. Which actor reports first is the scheduler's
// choice, so the output does not depend on it. Run with NOMU_NO_ESCAPE=1 so the garbage Boxes are real heap
// objects.
class Box {
  var v: Int
}

actor Worker {
  var sum: Int = 0
  on add(v: Int) {
    sum = sum + v
    // Throwaway garbage: a sliding window of Boxes that escapes into `xs`, then dies at handler return.
    var xs: Array<Box> = []
    var w = 0
    while w < 256 {
      xs.append(Box(v: w))
      w = w + 1
    }
  }
  on report(tag: Int, tally: Tally) {
    tally.done(tag: tag, sum: sum)
  }
}

actor Tally {
  var n: Int = 0
  var bad: Int = 0
  on done(tag: Int, sum: Int) {
    if sum != 1225 {
      bad = bad + 1
    }
    n = n + 1
    if n == 2000 {
      print(n)
      print(" reported, ")
      print(bad)
      print(" wrong\n")
    }
  }
}

fun blast(nActors: Int, nMsgs: Int, tally: Tally) {
  var a = 0
  while a < nActors {
    let w = Worker()
    var i = 0
    while i < nMsgs {
      w.add(v: i)
      i = i + 1
    }
    w.report(tag: a, tally: tally)     // FIFO after the adds → reports this actor's sum once its mailbox drains
    a = a + 1
    // w is dropped here: the mailbox + its queued messages live only in the run queues now.
  }
}

fun main() {
  blast(2000, 50, Tally())        // 2000 actors × (50 adds × 256 garbage Boxes) ≈ 400 MiB ≫ 256 MiB heap
}
