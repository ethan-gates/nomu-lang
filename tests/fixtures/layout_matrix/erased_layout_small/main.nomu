import pkg/lib

fun bit(b: Bool) -> Int {
  if b { return 1 }
  return 0
}
fun main() {
  let tb = make(true)
  print(bit(tb.v))
  print(bit(getV(tb)))
  print(bit(getB(tb)))
  print(" ")
  let tu = make(200.uint8)
  print(tu.v.int)
  print(" ")
  print(getV(tu).int)
  print(" ")
  let ts = make("a string longer than fifteen bytes")
  print(ts.v)
  print(" ")
  print(getV(ts))
  print("\n")
  let nested = make(make(true))
  print(bit(nested.v.v))
  print(bit(getV(getV(nested))))
  print(" ")
  let m = makeMix(9.uint8, "mixed")
  print(m.a.int)
  print(" ")
  print(mixA(m).int)
  print(" ")
  print(m.b)
  print(" ")
  print(mixB(m))
  print(" ")
  print(mixSmall(m).int)
  print(" ")
  let m2 = makeMix(true, 5)
  print(bit(mixA(m2)))
  print(" ")
  print(mixB(m2))
  print("\n")
  print(valueOf(leftOf(3.uint8), 0.uint8).int)
  print(" ")
  print(valueOf(leftOf("left"), "none"))
  print(" ")
  print(bit(valueOf(leftOf(true), false)))
  print("\n")
  let w = makeWrap(5.uint8)
  print(bit(w.tag))
  print(bit(w.inner.a))
  print(bit(w.inner.v))
  print(" ")
  print(w.n)
  print(" ")
  print(wrapN(w))
  print(" ")
  print(bit(wrapInnerA(w)))
  print(" ")
  print(w.v.int)
  print(" ")
  print(wrapV(w).int)
  print(" ")
  let ws = makeWrap("wrapped")
  print(wrapN(ws))
  print(" ")
  print(wrapV(ws))
  print("\n")
}
