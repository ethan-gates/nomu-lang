// A recursive enum: `node` holds two `Tree`s, so its payload is boxed automatically and `Tree` is
// one word, null for `leaf`.
enum Tree {
    case leaf
    case node(left: Tree, right: Tree)
}

fun main() {
    let t = Tree.leaf
    switch t {
    case .leaf:
        print(1)
    case .node(let l, let r):
        print(2)
    }
}
