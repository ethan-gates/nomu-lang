// One-byte fields (Bool, UInt8) packed beside references and Strings, across collections: in a struct, a class,
// an enum payload, an array of structs, an actor message, and a channel of Bool, whose element slot is one byte.
// Every managed word must sit where its descriptor says, so the collector finds and moves it.
class Box {
  var v: Int
}
struct Cell {
  var lit: Bool
  var s: String
  var tag: UInt8
  var box: Box
  var seen: Bool
}
class Holder {
  var a: Bool
  var cell: Cell
  var b: UInt8
  var box: Box
}
enum Slot {
  case full(flag: Bool, s: String, box: Box)
  case empty(n: UInt8)
}
actor Sink {
  var sum: Int = 0
  on put(a: Bool, n: UInt8, box: Box, s: String) {
    if a { sum = sum + box.v + n.int + s.count }
    var junk: Array<Box> = []
    var w = 0
    while w < 32 {
      junk.append(Box(v: w))
      w = w + 1
    }
  }
  on report(want: Int) {
    if sum != want {
      print("sink ")
      print(sum)
      print(" want ")
      print(want)
      print("\n")
    }
  }
}
fun text(i: Int) -> String {
  return "dense-field-string-".concat("abcdefghij")
}
fun cell(i: Int) -> Cell {
  return Cell(lit: i % 2 == 0, s: text(i), tag: (i % 251).uint8, box: Box(v: i), seen: i % 3 == 0)
}
fun check(c: Cell, i: Int) -> Int {
  var bad = 0
  if c.lit != (i % 2 == 0) { bad = bad + 1 }
  if c.tag.int != i % 251 { bad = bad + 1 }
  if c.box.v != i { bad = bad + 1 }
  if c.seen != (i % 3 == 0) { bad = bad + 1 }
  if c.s.count != 29 { bad = bad + 1 }
  return bad
}
fun produce(ch: Channel<Bool>, n: Int) {
  var i = 0
  while i < n {
    ch.send(i % 3 == 0)
    i = i + 1
  }
}
fun main() {
  var bad = 0
  var cells: Array<Cell> = []
  var holders: Array<Holder> = []
  var slots: Array<Slot> = []
  var i = 0
  while i < 3000 {
    cells.append(cell(i))
    holders.append(Holder(a: i % 2 == 1, cell: cell(i), b: (i % 7).uint8, box: Box(v: i * 2)))
    if i % 2 == 0 {
      slots.append(Slot.full(flag: true, s: text(i), box: Box(v: i)))
    } else {
      slots.append(Slot.empty(n: (i % 5).uint8))
    }
    i = i + 1
  }
  i = 0
  while i < 3000 {
    bad = bad + check(cells[i], i)
    let h = holders[i]
    bad = bad + check(h.cell, i)
    if h.a != (i % 2 == 1) { bad = bad + 1 }
    if h.b.int != i % 7 { bad = bad + 1 }
    if h.box.v != i * 2 { bad = bad + 1 }
    switch slots[i] {
    case .full(let flag, let s, let box):
      if !flag || s.count != 29 || box.v != i { bad = bad + 1 }
    case .empty(let n):
      if n.int != i % 5 { bad = bad + 1 }
    }
    i = i + 1
  }
  let sink = Sink()
  var want = 0
  i = 0
  while i < 3000 {
    sink.put(a: i % 2 == 0, n: (i % 9).uint8, box: Box(v: i), s: text(i))
    if i % 2 == 0 { want = want + i + i % 9 + 29 }
    i = i + 1
  }
  sink.report(want: want)
  let ch = Channel<Bool>.make(capacity: 4)
  fiber produce(ch, 3000)
  var trues = 0
  i = 0
  while i < 3000 {
    switch ch.receive() {
    case .some(let v):
      if v { trues = trues + 1 }
    case .none:
      bad = bad + 1
    }
    i = i + 1
  }
  if trues != 1000 { bad = bad + 1 }
  print("bad ")
  print(bad)
  print("\n")
}
