// Nomu's own memory routines (`memcpy`/`memmove`, `memset`, `bzero`, `memcmp` in the asm floor, task 104):
// every size 0 to 300 at each alignment, larger sizes that go to libSystem's routines, and overlapping
// copies in both directions, each checked byte by byte against a plain loop, with the bytes around the
// destination checked untouched. Prints the number of mismatches, 0 when all hold.
let guard = 64

fun fill(p: RawPtr, n: Int, seed: Int) {
  var i = 0
  while i < n {
    p.store(((i * 7 + seed) % 251).uint8, toByteOffset: i)
    i = i + 1
  }
}

fun byteAt(p: RawPtr, i: Int) -> Int {
  let b: UInt8 = p.load(fromByteOffset: i)
  return b.int
}

// Mismatches in [0, n) of `p` against `q`, and in the guards around `p` against 238.
fun diff(p: RawPtr, q: RawPtr, n: Int) -> Int {
  var bad = 0
  var i = 0
  while i < n {
    if byteAt(p, i) != byteAt(q, i) {
      bad = bad + 1
    }
    i = i + 1
  }
  i = 1
  while i <= guard {
    if byteAt(p, 0 - i) != 238 {
      bad = bad + 1
    }
    if byteAt(p, n + i - 1) != 238 {
      bad = bad + 1
    }
    i = i + 1
  }
  return bad
}

fun setAll(p: RawPtr, n: Int, v: Int) {
  var i = 0
  while i < n {
    p.store(v.uint8, toByteOffset: i)
    i = i + 1
  }
}

fun sign(c: Int) -> Int {
  if c < 0 {
    return 0 - 1
  }
  if c > 0 {
    return 1
  }
  return 0
}

// Copy, zero and compare `n` bytes with the destination at `dOff` and the source at `sOff`.
fun check(n: Int, dOff: Int, sOff: Int, src0: RawPtr, dst0: RawPtr, want: RawPtr) -> Int {
  var bad = 0
  let src = src0.advanced(by: guard + sOff)
  let dst = dst0.advanced(by: guard + dOff)
  fill(src, n, n + sOff)
  // copy
  setAll(dst0, n + 2 * guard + 8, 238)
  dst.copyBytes(from: src, byteCount: n)
  bad = bad + diff(dst, src, n)
  // compare: equal, then one byte raised and lowered at the start, middle and end
  if dst.compareBytes(with: src, byteCount: n) != 0 {
    bad = bad + 1
  }
  if n > 0 {
    var k = 0
    while k < 3 {
      var at = 0
      if k == 1 {
        at = n / 2
      }
      if k == 2 {
        at = n - 1
      }
      let old = byteAt(dst, at)
      dst.store(((old + 1) % 256).uint8, toByteOffset: at)
      var expect = 1
      if old == 255 {
        expect = 0 - 1
      }
      if sign(dst.compareBytes(with: src, byteCount: n)) != expect {
        bad = bad + 1
      }
      dst.store(old.uint8, toByteOffset: at)
      k = k + 1
    }
  }
  // zero
  setAll(dst0, n + 2 * guard + 8, 238)
  setAll(want, n, 0)
  dst.zeroBytes(n)
  bad = bad + diff(dst, want, n)
  return bad
}

// Copy `n` bytes within one buffer, `shift` bytes forward or back, against a copy made through a third
// buffer.
fun overlap(n: Int, shift: Int, forward: Bool, buf: RawPtr, tmp: RawPtr) -> Int {
  let base = buf.advanced(by: guard)
  setAll(buf, n + shift + 2 * guard, 238)
  fill(base, n + shift, n)
  var from = base
  var to = base.advanced(by: shift)
  if forward == false {
    from = base.advanced(by: shift)
    to = base
  }
  var i = 0
  while i < n {
    tmp.store(byteAt(from, i).uint8, toByteOffset: i)
    i = i + 1
  }
  to.copyBytes(from: from, byteCount: n)
  var bad = 0
  i = 0
  while i < n {
    if byteAt(to, i) != byteAt(tmp, i) {
      bad = bad + 1
    }
    i = i + 1
  }
  return bad
}

fun main() {
  let cap = 200000
  let src = RawPtr.alloc(bytes: cap + 2 * guard + 16, align: 16)
  let dst = RawPtr.alloc(bytes: cap + 2 * guard + 16, align: 16)
  let want = RawPtr.alloc(bytes: cap + 16, align: 16)
  var bad = 0
  var n = 0
  while n <= 300 {
    var d = 0
    while d < 4 {
      var s = 0
      while s < 4 {
        bad = bad + check(n, d, s, src, dst, want)
        s = s + 1
      }
      d = d + 1
    }
    n = n + 1
  }
  bad = bad + check(1000, 1, 3, src, dst, want)
  bad = bad + check(4096, 0, 0, src, dst, want)
  bad = bad + check(65537, 3, 1, src, dst, want)
  bad = bad + check(cap, 0, 2, src, dst, want)
  n = 0
  while n <= 200 {
    var shift = 1
    while shift < 10 {
      bad = bad + overlap(n, shift, true, src, want)
      bad = bad + overlap(n, shift, false, src, want)
      shift = shift + 3
    }
    n = n + 1
  }
  bad = bad + overlap(5000, 7, true, src, want)
  bad = bad + overlap(5000, 7, false, src, want)
  print("bad ")
  print(bad)
  print("\n")
}
