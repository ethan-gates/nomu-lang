// A public generic enum and functions over it, compiled once (erased) in this dependency (task
// 100.4.3.3.4). The tagged buffer layout — tag word + a payload sized to the largest case — is derived
// at runtime from T's VWT; construction stamps the tag and copies the payload, a match reads the tag
// and extracts the payload field, all by VWT-derived offset.
public enum Opt<T> {
    case some(value: T)
    case none
}

public fun wrapOpt<T>(x: T) -> Opt<T> {
    return .some(value: x)
}

public fun getOr<T>(o: Opt<T>, d: T) -> T {
    switch o {
    case .some(let v): return v
    case .none:        return d
    }
}
