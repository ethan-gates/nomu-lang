// Values large enough to pass by pointer, across stack moves and collections. `walk` takes one and returns one,
// recursing, so its frame is over the limit and it splits into a wrapper and a body: the wrapper passes both
// pointers along, and needs no frame the size of the value. The arrays make the value carry managed words.
struct Big {
  var s: Array<Int>
  var f0: Int
  var f1: Int
  var f2: Int
  var f3: Int
  var f4: Int
  var f5: Int
  var f6: Int
