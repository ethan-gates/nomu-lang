  var f67: Int
  var f68: Int
  var f69: Int
  var f70: Int
  var f71: Int
  var f72: Int
  var f73: Int
  var f74: Int
  var f75: Int
  var f76: Int
  var f77: Int
  var f78: Int
  var f79: Int
  var t: Array<Int>
  var n: Int
}
fun pause(n: Int, rounds: Int) {
  if rounds == 0 {
    if n % 50 == 0 {
      sleep(1)
    }
    return
  }
  let x = [n]
  pause(n, rounds - 1)
  if x[0] != n {
    print("unreachable")
  }
}
fun walk(b: Big, depth: Int) -> Big {
  if depth == 0 {
    pause(b.n, 25)
    return b
  }
  let r = walk(b, depth - 1)
  pause(r.n + depth, 25)
  return Big(s: r.s, f0: r.f0, f1: r.f1, f2: r.f2, f3: r.f3, f4: r.f4, f5: r.f5, f6: r.f6, f7: r.f7, f8: r.f8, f9: r.f9, f10: r.f10, f11: r.f11, f12: r.f12, f13: r.f13, f14: r.f14, f15: r.f15, f16: r.f16, f17: r.f17, f18: r.f18, f19: r.f19, f20: r.f20, f21: r.f21, f22: r.f22, f23: r.f23, f24: r.f24, f25: r.f25, f26: r.f26, f27: r.f27, f28: r.f28, f29: r.f29, f30: r.f30, f31: r.f31, f32: r.f32, f33: r.f33, f34: r.f34, f35: r.f35, f36: r.f36, f37: r.f37, f38: r.f38, f39: r.f39, f40: r.f40, f41: r.f41, f42: r.f42, f43: r.f43, f44: r.f44, f45: r.f45, f46: r.f46, f47: r.f47, f48: r.f48, f49: r.f49, f50: r.f50, f51: r.f51, f52: r.f52, f53: r.f53, f54: r.f54, f55: r.f55, f56: r.f56, f57: r.f57, f58: r.f58, f59: r.f59, f60: r.f60, f61: r.f61, f62: r.f62, f63: r.f63, f64: r.f64, f65: r.f65, f66: r.f66, f67: r.f67, f68: r.f68, f69: r.f69, f70: r.f70, f71: r.f71, f72: r.f72, f73: r.f73, f74: r.f74, f75: r.f75, f76: r.f76, f77: r.f77, f78: r.f78, f79: r.f79, t: r.t, n: r.n + 1)
}
fun main() {
  var i = 0
  var bad = 0
  while i < 1000 {
    let b = Big(s: [i], f0: 0, f1: 1, f2: 2, f3: 3, f4: 4, f5: 5, f6: 6, f7: 7, f8: 8, f9: 9, f10: 10, f11: 11, f12: 12, f13: 13, f14: 14, f15: 15, f16: 16, f17: 17, f18: 18, f19: 19, f20: 20, f21: 21, f22: 22, f23: 23, f24: 24, f25: 25, f26: 26, f27: 27, f28: 28, f29: 29, f30: 30, f31: 31, f32: 32, f33: 33, f34: 34, f35: 35, f36: 36, f37: 37, f38: 38, f39: 39, f40: 40, f41: 41, f42: 42, f43: 43, f44: 44, f45: 45, f46: 46, f47: 47, f48: 48, f49: 49, f50: 50, f51: 51, f52: 52, f53: 53, f54: 54, f55: 55, f56: 56, f57: 57, f58: 58, f59: 59, f60: 60, f61: 61, f62: 62, f63: 63, f64: 64, f65: 65, f66: 66, f67: 67, f68: 68, f69: 69, f70: 70, f71: 71, f72: 72, f73: 73, f74: 74, f75: 75, f76: 76, f77: 77, f78: 78, f79: 79, t: [i + 1], n: i)
    let r = walk(b, 1 + i % 3)
    if r.s[0] != i || r.t[0] != i + 1 || r.f79 != 79 || r.n != i + 1 + i % 3 {
      bad = bad + 1
    }
    i = i + 1
  }
  print("bad ")
  print(bad)
  print("\n")
}
