// Compiled-once code allocating generic classes, across moving collections: the nodes hold arrays, and the queue
// lives across parks while the collector moves what it reaches.
import pkg/lib

fun fresh(i: Int) -> Array<Int> {
  return [i]
}
fun main() {
  let q = filled(fresh(-1), 3)
  var bad = 0
  var i = 0
  while i < 3 {
    if q.pop(fresh(0))[0] != -1 {
      bad = bad + 1
    }
    i = i + 1
  }
  i = 0
  while i < 40000 {
    q.push(fresh(i))
    if i % 1000 == 0 {
      sleep(1)
    }
    if i % 2 == 1 {
      let a = q.pop(fresh(0))[0]
      let b = q.pop(fresh(0))[0]
      if a != i - 1 || b != i {
        bad = bad + 1
      }
    }
    i = i + 1
  }
  if q.count != 0 {
    bad = bad + 1
  }
  print("bad ")
  print(bad)
  print("\n")
}
