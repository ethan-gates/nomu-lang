// Results too large for the return registers, across stack moves and collections. Each comes back through a
// pointer into the caller's frame, which the callee holds across stops: a direct and recursive call, a call
// whose result is returned at once, a closure and an interface method. The structs hold arrays, so the
// result carries managed words too.
struct Big {
  var s: Array<Int>
  var a: Int
  var b: Int
  var c: Int
  var d: Int
  var e: Int
  var f: Int
  var g: Int
  var h: Int
  var t: Array<Int>
  var n: Int
}
// Parks now and then, and allocates, with the callers' result pointers live. Recursive so it stays a call.
fun pause(n: Int, rounds: Int) {
  if rounds == 0 {
    if n % 50 == 0 {
      sleep(1)
    }
    return
  }
  let x = [n]
  pause(n, rounds - 1)
  if x[0] != n {
    print("unreachable")
  }
}
fun built(n: Int) -> Big {
  let s = [n]
  pause(n, 25)
  return Big(s: s, a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, t: [n + 1], n: n)
}
fun deep(n: Int, depth: Int) -> Big {
  if depth == 0 {
    return built(n)
  }
  let r = deep(n, depth - 1)
  pause(n + depth, 25)
  return Big(s: r.s, a: r.a, b: r.b, c: r.c, d: r.d, e: r.e, f: r.f, g: r.g, h: r.h, t: r.t, n: r.n + 1)
}
fun forwarded(n: Int) -> Big {
  return deep(n, 1)
}
interface Maker {
  fun make(n: Int) -> Big
}
struct Plain: Maker {
  var depth: Int
  fun make(n: Int) -> Big {
    return deep(n, depth)
  }
}
fun viaClosure(f: (Int) -> Big, n: Int) -> Big {
  return f(n)
}
fun check(b: Big, base: Int, n: Int) -> Int {
  if b.s[0] != base || b.t[0] != base + 1 || b.a != 1 || b.h != 8 || b.n != n {
    return 1
  }
  return 0
}
fun main() {
  let m: any Maker = Plain(depth: 2)
  var i = 0
  var bad = 0
  while i < 1000 {
    bad = bad + check(deep(i, 3), i, i + 3)
    bad = bad + check(forwarded(i), i, i + 1)
    bad = bad + check(m.make(i), i, i + 2)
    bad = bad + check(viaClosure({ (n: Int) -> Big in return deep(n, 2) }, i), i, i + 2)
    i = i + 1
  }
  print("bad ")
  print(bad)
  print("\n")
}
