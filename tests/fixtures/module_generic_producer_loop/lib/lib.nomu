// A non-POD `T` composed into a producer-internal buffer *inside a loop*, held across a moving GC each
// iteration (task 100.4.3.6 — the loop case / hazard (b)). `loopHold` constructs a fresh `Box<T>` every
// iteration and holds it across a spin that requests a minor collection. The shadow node for the box's
// `T`-component is entry-hoisted (one storage slot), so each iteration's push must be unwound at the
// back-edge — without that, iteration two re-pushes the same node onto itself, cycling the shadow chain
// and hanging the next root walk.
package struct Box<T> {
    var value: T
}

package fun spin(n: Int) -> Int {
    var i = 0
    var acc = 0
    var asked = false
    var ticket = 0
    while i < n || (asked && !rtGcCollected(ticket)) {
        if i == 1000 {
            ticket = rtGcRequest(1)    // collect at a poll of this loop, with the caller held mid-spin
            asked = true
        }
        acc = acc + (i % 7)
        i = i + 1
    }
    return acc
}

package fun loopHold<T>(x: T, iters: Int) -> T {
    var r = x
    var i = 0
    while i < iters {
        let b = Box(value: x)
        let j = spin(200000)
        r = b.value
        i = i + 1
    }
    return r
}
