// `core` is ambient (task 174): its substrate type `ManagedBuffer` resolves bare in every module, with no
// import.
fun main() {
    let b = ManagedBuffer<Int, Int>.create(capacity: 3)
    let e = b.elementPtr(at: 1)
    e.store(9, toByteOffset: 0)
    let v: Int = e.load(fromByteOffset: 0)
    print(b.capacity())
    print("\n")
    print(v)
    print("\n")
}
