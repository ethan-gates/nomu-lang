// Non-generic instance methods on imported types, called across a module boundary (task 100.4.3.5.1 /
// 100.4.3.5.2). The bodies live here; the consumer resolves the calls against the reconstructed
// (body-free) method signatures and links to the producer's symbol. Covers a value (struct) receiver —
// by-value `self` — and a reference (class) receiver — pointer `self` — a method taking an argument,
// and (100.4.3.5.2) a **mutating** value method whose inferred mutating-ness crosses in the `.nmi`, so
// the consumer passes `self` by pointer and the mutation sticks.
public struct Pt {
    var x: Int
    var y: Int
    fun sum() -> Int { return x + y }
    fun scaled(by: Int) -> Int { return (x + y) * by }
    fun shift(by: Int) {
        x = x + by
        y = y + by
    }
}

public class Counter {
    var n: Int
    fun doubled() -> Int { return n + n }
}
