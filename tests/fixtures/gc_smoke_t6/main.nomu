// M7 · §7.0.5 T6 — safepoint coverage after a tier transform (invariant I9). The compute fiber's spin loop
// is produced by *inlining*: the bare loop lives in a separate `loopSum` (a multi-block callee), which
// multi-block inlining (7.5) splices into `spin`. The resulting loop has no call or allocation in its body,
// so its only safepoint is the loop-header poll. T6 proves that poll survives the inline transform — the
// stop-the-world still stops the carrier while it spins in the inlined loop.
//
// Suite case `stw-inlined-loop` (two or more carriers, built with `test.runtime_prelude`): `spin` raises a
// flag just before the loop, with no poll between the flag and the loop; `parker` waits for the flag,
// requests a minor collection (`rtGcRequest`), and parks holding its own root. The collection stops the
// spinning carrier in the inlined loop and the parked fiber, and moves both roots — 777 (the inlined loop's
// live Box) and 888 (the parked fiber's). If inlining dropped the poll, the carrier would never reach a
// safepoint and the stop-the-world would hang, so completion is part of the assertion.
class Box {
  var v: Int
}
// A bare compute loop, no calls or allocations inside — the field load `x.v` is not a safepoint.
// Multi-block (entry / header / body / exit), so it inlines into `spin` via 7.5 phase B.
fun loopSum(x: Box) -> Int {
  var i = 0
  var acc = 0
  while i < 200000000 {         // long loop → a back-edge poll each iteration; x live across it
    acc = acc + x.v
    i = i + 1
  }
  return acc
}
// The carrier body. After inlining, `spin`'s CFG *contains* loopSum's loop — an inlined loop whose
// only safepoint is the loop-header poll.
fun spin(x: Box, inLoop: RawPtr) -> Int {
  inLoop.atomicStore(1, toByteOffset: 0)   // the next poll is the inlined loop's
  return loopSum(x)
}
fun parker(inLoop: RawPtr) -> Int {
  let p = Box(v: 888)
  while inLoop.atomicLoad(fromByteOffset: 0) == 0 {
  }
  rtGcRequest(1)                // the spinner is in the inlined loop
  sleep(20)                     // park holding p live across the safepoint
  return p.v
}
fun main() {
  let inLoop = RawPtr.alloc(bytes: 8, align: 8)
  inLoop.atomicStore(0, toByteOffset: 0)
  fiber let s = spin(Box(v: 777), inLoop)   // a carrier runs the inlined compute loop
  fiber let q = parker(inLoop)              // another fiber requests the collection, then parks holding a root
  print(s + q)                              // joins both
}
