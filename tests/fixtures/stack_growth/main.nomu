// Deep recursion on several fibers at once: each stack grows by moving, many times, while its frames hold
// managed objects and the fibers park at the bottom. Every frame's object must survive the moves for the
// sums to come out right (task 104).
class Box {
  var v: Int
}

fun down(n: Int, b: Box) -> Int {
  if n == 0 {
    sleep(1)
    return b.v
  }
  let c = Box(v: b.v + 1)
  return b.v + down(n - 1, c)
}

// The Box is made on the task's own fiber: a mutable class is not shareable, so it cannot be passed in.
fun start(n: Int) -> Int {
  return down(n, Box(v: 0))
}

fun main() {
  let a = task start(100000)
  let b = task start(200000)
  let c = task start(300000)
  print(down(50000, Box(v: 0)))
  print("\n")
  print(a.join())
  print("\n")
  print(b.join())
  print("\n")
  print(c.join())
  print("\n")
}
