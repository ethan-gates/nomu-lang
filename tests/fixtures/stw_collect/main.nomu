// A moving collection while a fiber spins in a loop holding a live object. `worker` allocates 500 dead Boxes
// (garbage), then holds one live Box (111) across a busy loop. Partway through the loop it requests a minor
// collection (`rtGcRequest`) and keeps spinning until it has run, so it stops at a poll of this loop: the minor moves the live Box out of
// the nursery, fixes up the worker's stack slot in place, and reclaims the garbage. The worker resumes and
// reads the moved Box → 111. Output is unchanged by the collection (moving is transparent), which is the
// fixup-correctness proof. Built with `test.runtime_prelude` (for `rtGcRequest`) and escape analysis off.
class Box {
  var v: Int
}

fun spin(n: Int) -> Int {
  var i = 0
  var acc = 0
  var asked = false
  var ticket = 0
  while i < n || (asked && !rtGcCollected(ticket)) {
    if i == 1000 {
      ticket = rtGcRequest(1)  // collect at a poll of this loop, with the worker mid-loop
      asked = true
    }
    acc = acc + (i % 7)
    i = i + 1
  }
  return acc
}

fun makeGarbage(n: Int) -> Int {
  var i = 0
  var s = 0
  while i < n {
    let g = Box(v: i)          // dead after this iteration — reclaimed by the collection
    s = s + g.v
    i = i + 1
  }
  return s
}

fun worker() -> Int {
  let keep = Box(v: 111)       // live across the collection — force-all moves it; its stack slot is fixed up
  let g = makeGarbage(500)
  let j = spin(2000000)        // the collection runs inside this loop
  return keep.v + (g % 1) + (j % 1)
}

fun main() {
  fiber let x = worker()
  print(x)                     // 111 — keep survived the move and its slot was fixed up
  print("\n")
}
