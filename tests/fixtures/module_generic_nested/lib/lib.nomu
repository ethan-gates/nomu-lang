// Two public generics where one calls the other: `relay<T>` calls `echo<T>` (task 100.5.4). Under
// `--mono` the consumer injects both `.bir` bodies; `relay`'s reference to `echo` was canonicalized to
// the origin-keyed name at export, so the injected `relay<Int>` calls the injected `echo<Int>` and both
// specialize transitively (whole-tree, matching whole-program mono).
package fun echo<T>(x: T) -> T {
    return x
}

package fun relay<T>(x: T) -> T {
    return echo(x)
}
