class Box {
  var v: Int
}
// Allocates a Box and spins, so a nursery collection lands between reads.
fun churn(i: Int) -> Int {
  let b = Box(v: i)
  var k = 0
  var t = 0
  while k < 100 {
    t = t + k
    k = k + 1
  }
  return t + b.v
}
fun probe(s: String) -> Int {
  return s.byte(at: 5).int + s.byte(at: 20).int
}
fun heapString() -> String {
  return "seed".concat("-heap-string-xxxxxxxxxxxxxxxx")
}
fun report(bad: Int) {
  print("bad ")
  print(bad)
  print("
")
}
// A struct holding only a plain managed pointer (an `Array`), whose slot address escapes as a mutating
// method's `self`: the slot stays in memory, where the statepoint rewrite does not look.
struct Bag {
  var xs: Array<Int>
  var n: Int
  fun run(count: Int) -> Int {
    var i = 0
    var bad = 0
    var t = 0
    while i < count {
      t = t + churn(i)
      if xs[0] != 4242 {
        bad = bad + 1
      }
      n = n + 1
      i = i + 1
    }
    return bad
  }
}
fun main() {
  var g = Bag(xs: [4242, 17], n: 0)
  report(g.run(count: 1000000))
}
