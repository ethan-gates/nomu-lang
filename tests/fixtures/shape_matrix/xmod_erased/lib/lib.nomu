class Box {
  var v: Int
}
package fun churn(i: Int) -> Int {
  let b = Box(v: i)
  var k = 0
  var t = 0
  while k < 100 {
    t = t + k
    k = k + 1
  }
  return t + b.v
}
package fun probe(s: String) -> Int {
  return s.byte(at: 5).int + s.byte(at: 20).int
}
// Erased across modules: no `mono`, so the consumer calls the witness path.
package fun hold<T>(x: T, i: Int) -> T {
  var t = churn(i)
  t = t + churn(i + 1)
  return x
}
package fun loopCheck(s: String, want: Int, n: Int) -> Int {
  var i = 0
  var bad = 0
  var t = 0
  while i < n {
    t = t + churn(i)
    if probe(s) != want {
      bad = bad + 1
    }
    i = i + 1
  }
  return bad
}
