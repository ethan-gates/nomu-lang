class Box {
  var v: Int
}
// Allocates a Box and spins, so a nursery collection lands between reads.
fun churn(i: Int) -> Int {
  let b = Box(v: i)
  var k = 0
  var t = 0
  while k < 100 {
    t = t + k
    k = k + 1
  }
  return t + b.v
}
fun probe(s: String) -> Int {
  return s.byte(at: 5).int + s.byte(at: 20).int
}
fun heapString() -> String {
  return "seed".concat("-heap-string-xxxxxxxxxxxxxxxx")
}
fun report(bad: Int) {
  print("bad ")
  print(bad)
  print("
")
}

// The value crosses a call that collects, then comes back as the return.
fun pass(s: String, i: Int) -> String {
  var t = churn(i)
  t = t + churn(i + 1)
  return s
}
fun main() {
  let want = probe(heapString())
  var i = 0
  var bad = 0
  while i < 1000000 {
    let r = pass(heapString(), i)
    let u = churn(i)
    if probe(r) != want {
      bad = bad + 1
    }
    i = i + 1
  }
  report(bad)
}
