// Concrete value types holding references: a struct with a class field, an enum with a class payload, a
// struct holding that enum. Each is kept as a local, in an array, in a class field, passed and returned,
// and read back after allocation that forces collections (the legs move and promote what they reach).
class Box {
  var v: Int
}
struct Pair {
  var box: Box
  var n: Int
}
enum Slot {
  case empty
  case full(box: Box)
}
struct Cell {
  var slot: Slot
  var tag: Int
}
class Keeper {
  var pair: Pair
  var cell: Cell
}
// Allocates a Box and spins, so a collection lands between reads.
fun churn(i: Int) -> Int {
  let b = Box(v: i)
  var k = 0
  var t = 0
  while k < 100 {
    t = t + k
    k = k + 1
  }
  return t + b.v
}
fun slotValue(s: Slot) -> Int {
  switch s {
  case .full(let b):
    return b.v
  case .empty:
    return -1
  }
}
fun makeCell(v: Int) -> Cell {
  return Cell(slot: Slot.full(box: Box(v: v)), tag: v)
}
fun pairSum(p: Pair) -> Int {
  return p.box.v + p.n
}
fun report(bad: Int) {
  print("bad ")
  print(bad)
  print("\n")
}
fun main() {
  let pair = Pair(box: Box(v: 10), n: 1)
  let cell = makeCell(v: 20)
  let keeper = Keeper(pair: Pair(box: Box(v: 30), n: 2), cell: makeCell(v: 40))
  var pairs: Array<Pair> = []
  var cells: Array<Cell> = []
  var j = 0
  while j < 50 {
    pairs.append(Pair(box: Box(v: j), n: j))
    cells.append(makeCell(v: j * 3))
    j = j + 1
  }
  var bad = 0
  var t = 0
  var i = 0
  while i < 150000 {
    t = t + churn(i)
    if pairSum(pair) != 11 { bad = bad + 1 }
    if slotValue(cell.slot) != 20 || cell.tag != 20 { bad = bad + 1 }
    if pairSum(keeper.pair) != 32 { bad = bad + 1 }
    if slotValue(keeper.cell.slot) != 40 { bad = bad + 1 }
    let k = i % 50
    if pairSum(pairs[k]) != k + k { bad = bad + 1 }
    if slotValue(cells[k].slot) != k * 3 { bad = bad + 1 }
    let fresh = makeCell(v: i)
    t = t + churn(i)
    if slotValue(fresh.slot) != i { bad = bad + 1 }
    i = i + 1
  }
  if t == 42 { print("\n") }
  report(bad)
}
