class Box {
  var v: Int
}
// Allocates a Box and spins, so a nursery collection lands between reads.
fun churn(i: Int) -> Int {
  let b = Box(v: i)
  var k = 0
  var t = 0
  while k < 100 {
    t = t + k
    k = k + 1
  }
  return t + b.v
}
fun probe(s: String) -> Int {
  return s.byte(at: 5).int + s.byte(at: 20).int
}
fun heapString() -> String {
  return "seed".concat("-heap-string-xxxxxxxxxxxxxxxx")
}
fun report(bad: Int) {
  print("bad ")
  print(bad)
  print("
")
}
fun main() {
  var xs: Array<Option<String>> = []
  xs.append(Option<String>.some(value: heapString()))
  let want = probe(heapString())
  var i = 0
  var bad = 0
  var t = 0
  while i < 1000000 {
    t = t + churn(i)
    switch xs[0] {
    case .some(let s):
      if probe(s) != want {
        bad = bad + 1
      }
    case .none: bad = bad + 1
    }
    i = i + 1
  }
  report(bad)
}
