fun run(depth: Int) -> Int {
  var xs: Array<Int> = []
  var i = 0
  while i < 7 {
    xs.append(i)
    i = i + 1
  }
  var c = Counter(n: 0)
  c.bump(xs)
  return wide(depth, xs) + c.n
}

fun main() {
  fiber let a = run(50)
  fiber let b = run(200)
  fiber let c = run(400)
  print(run(10))
  print("\n")
  print(a)
  print("\n")
  print(b)
  print("\n")
  print(c)
  print("\n")
}
