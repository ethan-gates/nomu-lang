// A dependency's signature names a type from a third module (task 174.7). `maker` returns `shapes` types;
// this module imports only `maker`, yet reads the fields, calls the method and matches the enum. The
// interface records each foreign type's origin, so the consumer resolves it without importing `shapes`.
import pkg/maker

fun main() {
    let p = origin(3, 4)
    print(p.x)
    print("\n")
    print(p.sum())
    print("\n")
    switch tag(5) {
    case .some(let v): print(v)
    case .empty: print(0)
    }
    print("\n")
    switch tag(-1) {
    case .some(let v): print(v)
    case .empty: print(0)
    }
    print("\n")
}
