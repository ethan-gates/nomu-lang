import std/time

// Many short fibers, each recursing a little before it returns (task 104.5.1): what spawning, growing and
// freeing a stack cost when fibers live briefly. Each round starts 100,000 fibers in waves of 1,000 (start
// a wave, join it) at one recursion depth, from none (no growth from the starting size) to deep enough to
// grow several times, and prints its time per fiber. A Go counterpart runs the same rounds.

fun down(n: Int, x: Int) -> Int {
    if n == 0 {
        return x
    }
    let r = down(n - 1, x + 1)
    return r * 3 + x
}

fun leaf(depth: Int, seed: Int) -> Int {
    return down(depth, seed)
}

fun main() {
    let fibers = 100000
    let wave = 1000
    var depths: Array<Int> = [0, 16, 64, 256, 1024]
    var d = 0
    while d < 5 {
        let depth = depths[d]
        let t = Time()
        let t0 = t.now
        var sum = 0
        var started = 0
        while started < fibers {
            var tasks: Array<Task<Int>> = []
            var i = 0
            while i < wave {
                tasks.append(task leaf(depth, started + i))
                i = i + 1
            }
            i = 0
            while i < wave {
                sum = sum + tasks[i].join()
                i = i + 1
            }
            started = started + wave
        }
        let ns = t.ns_diff(t0, t.now)
        print("spawn_grow depth ")
        print(depth)
        print(" fibers ")
        print(fibers)
        print(" ns ")
        print(ns)
        print(" ns/fiber ")
        print(ns / fibers)
        print("\n")
        if sum == 42 {
            print("\n")
        }
        d = d + 1
    }
}
