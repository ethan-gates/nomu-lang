import std/time

// Items flow through a chain of 8 stage actors, each doing `work` loop iterations, to a hub actor that
// fed them. Each stage holds its successor. Rounds grow the stage's work; each prints its total time for 20,000 items. Measures a chain of
// handoffs where every stage stays busy.

fun spin(work: Int, seed: Int) -> Int {
    var x = seed
    var i = 0
    while i < work {
        x = x * 6364136223846793005 + 1442695040888963407
        i += 1
    }
    return x
}

actor Stage {
    var next: Option<Stage>
    on item(v: Int, i: Int, work: Int, items: Int, first: Stage, hub: Hub) {
        let w = spin(work: work, seed: v)
        switch next {
        case .some(let n):
            n.item(v: w, i: i + 1, work: work, items: items, first: first, hub: hub)
        case .none:
            hub.done(v: w, work: work, items: items, first: first, me: hub)
        }
    }
}

actor Hub {
    var got: Int = 0
    var sum: Int = 0
    var t0: Int = 0
    on start(work: Int, items: Int, first: Stage, me: Hub) {
        got = 0
        t0 = Time().now
        var i = 0
        while i < items {
            first.item(v: i, i: 0, work: work, items: items, first: first, hub: me)
            i += 1
        }
    }
    on done(v: Int, work: Int, items: Int, first: Stage, me: Hub) {
        sum = sum + v
        got += 1
        if got == items {
            let t = Time()
            print("pipeline_actor work ")
            print(work)
            print(" items ")
            print(items)
            print(" ns ")
            print(t.ns_diff(t0, t.now))
            print("\n")
            if work < 1000 {
                var next = work * 10
                if work == 0 {
                    next = 100
                }
                me.start(work: next, items: items, first: first, me: me)
            } else if sum == 1 {
                print("\n")
            }
        }
    }
}

fun main() {
    // Built from the last stage back, each holding its successor; the last has none and replies to the hub.
    let hub = Hub()
    var next: Option<Stage> = .none
    var first = Stage(next: next)
    var s = 1
    while s < 8 {
        next = .some(first)
        first = Stage(next: next)
        s += 1
    }
    hub.start(work: 0, items: 20000, first: first, me: hub)
}
