import std/time

// A few fibers recursing far (task 104.5.1): each of 4 fibers recurses to a depth and returns, so its stack
// grows through every size from the starting one. Rounds at three depths print their time; the deepest
// reaches stacks of tens of MiB. A Go counterpart runs the same rounds.

fun down(n: Int, x: Int) -> Int {
    if n == 0 {
        return x
    }
    let r = down(n - 1, x + 1)
    return r * 3 + x
}

fun main() {
    let fibers = 4
    var depths: Array<Int> = [10000, 100000, 1000000]
    var d = 0
    while d < 3 {
        let depth = depths[d]
        let t = Time()
        let t0 = t.now
        var sum = 0
        var tasks: Array<Task<Int>> = []
        var i = 0
        while i < fibers {
            tasks.append(task down(depth, i))
            i = i + 1
        }
        i = 0
        while i < fibers {
            sum = sum + tasks[i].join()
            i = i + 1
        }
        let ns = t.ns_diff(t0, t.now)
        print("deep_recursion depth ")
        print(depth)
        print(" fibers ")
        print(fibers)
        print(" ns ")
        print(ns)
        print("\n")
        if sum == 42 {
            print("\n")
        }
        d = d + 1
    }
}
