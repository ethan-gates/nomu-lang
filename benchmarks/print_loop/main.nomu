// Printing in a loop: three million integers, each formatted into the runtime's stdout buffer, written out with
// `write` when it fills (task 271; it was a libc `printf` per call, run on the carrier's stack, task 104.3.3). Run
// with stdout sent to /dev/null.
fun main() {
  var i = 0
  while i < 3000000 {
    print(i)
    print("\n")
    i = i + 1
  }
}
