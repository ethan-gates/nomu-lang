class Counter {
  var n: Int
  fun get() -> Int { return n }
  fun bump() { n += 1 }
}
class Person {
  var name: String
  var age: Int
  fun greet() -> String { return concat("hi ", name) }
}
fun poke(c: Counter) {
  c.bump()
  c.bump()
}
fun main() {
  let c = Counter(n: 5)
  print(c.get())
  poke(c)
  print(c.get())
  print(c.n)
  let p = Person(name: "ana", age: 30)
  print(p.greet())
  print(p.age)
}
