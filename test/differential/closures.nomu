fun apply(f: (Int) -> Int, x: Int) -> Int {
  return f(x)
}
fun main() {
  let base = 10
  let add = { (x: Int) -> Int in return x + base }
  print(add(5))
  print(add(90))

  let n = 7
  let sq = { () -> Int in return n * n }
  print(sq())

  let k = 3
  print(apply(f: { (m: Int) -> Int in return m * k }, x: 10))
}
