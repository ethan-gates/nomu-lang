// 8.2.5 — `any A & B` composition: a composite witness (one table pointer per interface); a
// requirement dispatches through its owning interface's sub-table. Order-independent.

interface Drawable {
    fun draw() -> String
}
interface Named {
    var name: String { get }
}

struct Circle: Drawable, Named {
    var name: String
    fun draw() -> String { return "O" }
}

fun show(x: any Drawable & Named) -> String {
    return concat(x.name, x.draw())
}

fun main() {
    let c = Circle(name: "circ-")
    print(show(c))                       // circ-O

    let both: any Named & Drawable = c   // same canonical type
    print(both.draw())                   // O
    print(both.name)                     // circ-
}
