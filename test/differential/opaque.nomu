// 8.2.5 — `some I` opaque returns: the concrete underlying is known, so requirement calls
// devirtualize (direct call / stored-field load — no box, no witness), including a `-> Self`
// requirement that hands back the concrete type.

interface Drawable {
    fun draw() -> String
    var name: String { get }
}

struct Circle: Drawable {
    var name: String
    var radius: Int
    fun draw() -> String { return "O" }
}

interface Cloneable {
    fun clone() -> Self
    fun tag() -> String
}

struct Point: Cloneable {
    var x: Int
    fun clone() -> Point { return Point(x: x) }
    fun tag() -> String { return "pt" }
}

fun makeShape() -> some Drawable {
    return Circle(name: "shape", radius: 3)
}

fun makePoint() -> some Cloneable {
    return Point(x: 42)
}

fun main() {
    let s = makeShape()
    print(s.draw())          // O    (direct call)
    print(s.name)            // shape (direct field load)

    let d: some Drawable = Circle(name: "local", radius: 2)
    print(d.draw())          // O
    print(d.name)            // local

    let p = makePoint()
    let twin = p.clone()     // concrete Point (Self -> underlying)
    print(twin.x)            // 42
    print(p.tag())           // pt
}
