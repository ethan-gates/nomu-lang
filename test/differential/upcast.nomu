// 8.2.5 — existential upcast + property set through `any I`. A refining interface's witness
// carries a base pointer, so `any Badge` widens to `any Named`; a settable requirement dispatches
// through the witness set slot; a default reads a requirement by bare name.

interface Named {
    var name: String { get }
    fun greeting() -> String {
        return concat("hi ", name)
    }
}

interface Badge: Named {
    var count: Int { get set }
    fun greeting() -> String {
        return concat("hello ", name)
    }
}

class Person: Badge {
    var name: String
    var count: Int
}

struct Robot {
    var serial: Int
}
extension Robot: Named {
    var name: String {
        return "unit"
    }
}

fun asNamed(n: any Named) -> String {
    return n.greeting()
}

fun main() {
    let b: any Badge = Person(name: "Ada", count: 0)
    b.count = 7                          // set through the witness
    print(b.greeting())                  // hello Ada

    let n: any Named = b                 // upcast any Badge -> any Named
    print(n.greeting())                  // hello Ada
    print(asNamed(b))                    // hello Ada
    print(asNamed(Robot(serial: 42)))    // hi unit
}
