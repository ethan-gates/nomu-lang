struct Point {
  var x: Int
  var y: Int
  fun sum() -> Int { return x + y }
  fun shift(d: Int) {
    x += d
    y += d
  }
  var mag: Int { return x + y }
}
struct Box {
  var origin: Point
  var tag: Int
}
fun main() {
  var p = Point(x: 3, y: 4)
  print(p.x)
  print(p.sum())
  print(p.mag)
  p.shift(d: 10)
  print(p.x)
  print(p.y)
  p.x = 100
  print(p.x)

  var box = Box(origin: Point(x: 1, y: 2), tag: 7)
  print(box.origin.y)
  box.origin.y = 55
  print(box.origin.y)
  print(box.tag)
}
