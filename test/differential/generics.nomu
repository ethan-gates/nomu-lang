// 8.2.5 — generics + `Result`. Whole-program monomorphization runs before codegen, so a generic
// function/type/`Result<T,E>` arrives as concrete named decls the earlier slices already lower —
// this checks the LLVM backend agrees end to end on specialized instances.

struct Box<T> {
    let value: T
}

fun wrap<T>(x: T) -> Box<T> {
    return Box(value: x)
}

fun divide(a: Int, b: Int) -> Result<Int, String> {
    if b == 0 {
        return .err(error: "divide by zero")
    }
    return .ok(value: a / b)
}

fun main() {
    let bi = Box(value: 42)
    print(bi.value)              // 42
    let bs = Box(value: "hi")
    print(bs.value)              // hi

    print(wrap(8).value)         // 8
    print(wrap("gen").value)     // gen

    let some: Option<Int> = .some(value: 7)
    switch some {
    case .some(let v): print(v)  // 7
    case .none:        print(0)
    }

    let good = divide(10, 2)
    switch good {
    case .ok(let v):  print(v)   // 5
    case .err(let e): print(e)
    }

    let bad = divide(1, 0)
    switch bad {
    case .ok(let v):  print(v)
    case .err(let e): print(e)   // divide by zero
    }
}
