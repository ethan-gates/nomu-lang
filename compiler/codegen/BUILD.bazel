load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "codegen",
    srcs = glob(["sources/*.swift"]),
    module_name = "codegen",
    deps = ["//compiler/frontend"],
    visibility = ["//visibility:public"],
)

swift_test(
    name = "codegen_tests",
    srcs = glob(["tests/*.swift"]),
    deps = ["//compiler/codegen"],
)
