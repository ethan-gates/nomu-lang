load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")

# The module/package model: module identity, module directory listing, and package manifests. Planning
# builds over them is the planner's (//src/planner). See design/plans/tasks/100-modules.md.
swift_library(
    name = "modules",
    srcs = glob(["sources/*.swift"]),
    module_name = "modules",
    visibility = ["//visibility:public"],
)

swift_test(
    name = "modules_tests",
    srcs = glob(["tests/*.swift"]),
    deps = [":modules"],
)
