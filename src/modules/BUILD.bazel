load("@rules_swift//swift:swift.bzl", "swift_library")

# The module/package model: module identity, mechanical pkg-path resolution, directory discovery,
# and the dependency graph (acyclic check + topological order). Pure logic over the AST; the driver
# orchestrates parsing and calls these. See design/plans/tasks/100-modules.md.
swift_library(
    name = "modules",
    srcs = glob(["sources/*.swift"]),
    module_name = "modules",
    deps = ["//src/support", "//src/frontend/ast"],
    visibility = ["//visibility:public"],
)
