load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")

# Implementation module: the pass manager + the four M7 passes (precise escape analysis, devirt,
# bounds-check elimination, inlining/specialization). Scaffolded at 7.2.1, filled from 7.3 on
# (m7-spec.md §7.3–§7.5). Analyses/transforms over `ssair`.
swift_library(
    name = "ssairpasses",
    srcs = glob(["sources/*.swift"]),
    module_name = "ssairpasses",
    deps = ["//src/support", "//src/midend/ssair"],
    visibility = ["//visibility:public"],
)

# Verifier tests: each builds a module that breaks one GC-precision invariant (I1–I3) and asserts the
# verifier reports it, plus a well-formed module that passes clean (§7.0.5 "no crash is not a pass").
swift_test(
    name = "ssairpasses_tests",
    srcs = glob(["tests/*.swift"]),
    deps = ["//src/support", "//src/frontend/ast", "//src/midend/ssair", ":ssairpasses"],
)
