load("@rules_swift//swift:swift.bzl", "swift_library")

# Embed the runtime's asm floor and the Nomu prelude, runtime and std sources into a Swift constants file,
# so nomuc carries them and stays a single relocatable binary (M4.13; m4.13-spec.md §3).
# The .s/.nomu files are the editable source of truth; this only bundles them.
genrule(
    name = "embedded_sources",
    srcs = [
        "//src/stdlib:core.nomu",
        "//src/stdlib:runtime_files",
        "//src/stdlib:std_modules",
        "rtasm_arm64.s",
    ],
    outs = ["EmbeddedSources.swift"],
    tools = ["embed.sh"],
    cmd = "bash $(location embed.sh) $@ " +
          "$(location //src/stdlib:core.nomu) " +
          "$(location rtasm_arm64.s) " +
          "$(locations //src/stdlib:runtime_files) -- " +
          "$(locations //src/stdlib:std_modules)",
)

swift_library(
    name = "embedded",
    srcs = [":embedded_sources"],
    module_name = "embedded",
    visibility = ["//visibility:public"],
)
