load("@rules_swift//swift:swift.bzl", "swift_library")

# Build facts embedded in the compiler: the git commit it was built from (task 190, D4), read from Bazel's
# stable workspace status (`tools/workspace_status.sh`). Always stamped, so every build carries its commit.
genrule(
    name = "build_info_swift",
    outs = ["BuildInfo.swift"],
    cmd = """
commit=$$(sed -n 's/^STABLE_NOMU_GIT_COMMIT //p' bazel-out/stable-status.txt)
{
  echo '// GENERATED from the Bazel workspace status — do not edit.'
  echo 'public enum BuildInfo {'
  echo "    // The git commit the compiler was built from; \\"unstamped\\" outside a git checkout."
  echo "    public static let gitCommit = \\"$${commit:-unstamped}\\""
  echo '}'
} > $@
""",
    stamp = 1,
)

swift_library(
    name = "buildinfo",
    srcs = [":build_info_swift"],
    module_name = "buildinfo",
    visibility = ["//visibility:public"],
)
