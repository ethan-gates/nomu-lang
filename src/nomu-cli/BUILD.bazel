load("@rules_swift//swift:swift.bzl", "swift_binary")

swift_binary(
    name = "nomuc",
    srcs = glob(["sources/*.swift"]),
    copts = [
        "-cxx-interoperability-mode=default",
        "-Xcc",
        "-std=c++17",
    ],
    # M6 · 6.1.0 — embed the Rust GC archive into nomuc as a Mach-O section so nomuc stays a single
    # atomic file; the driver extracts it (via //src/gcembed) to a cache file at link time.
    data = ["//src/gcbinding:nomu_gc"],
    linkopts = ["-Wl,-sectcreate,__DATA,__nomu_gc,$(location //src/gcbinding:nomu_gc)"],
    deps = [
        "//src/driver",
        "//src/gcbinding:nomu_gc",  # M6 · 6.1.0 — link the Rust GC binding into the compiler build
        "//src/gcembed",            # M6 · 6.1.0 — embedded-section reader
    ],
    visibility = ["//visibility:public"]
)
