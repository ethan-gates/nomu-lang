load("@rules_swift//swift:swift.bzl", "swift_binary")
load("//bazel:opt_binary.bzl", "opt_binary")

swift_binary(
    name = "nomu",
    srcs = glob(["sources/*.swift"]),
    copts = [
        "-cxx-interoperability-mode=default",
        "-Xcc",
        "-std=c++17",
    ],
    deps = [
        "//src/driver",
        "//src/cli",                        # the subcommand argument parser (task 186)
        "//src/settings",                   # the compiler's settings, read from a job file
    ],
    visibility = ["//visibility:public"]
)

# `nomu` built optimized whatever the build's mode, for tests that run it.
opt_binary(
    name = "nomu_opt",
    binary = ":nomu",
    visibility = ["//visibility:public"],
)
