load("@rules_swift//swift:swift.bzl", "swift_binary")

swift_binary(
    name = "nomu",
    srcs = glob(["sources/*.swift"]),
    copts = [
        "-cxx-interoperability-mode=default",
        "-Xcc",
        "-std=c++17",
    ],
    # M6 · 6.1.1 — embed the Rust GC archive into the `nomu` binary as a Mach-O section so it stays a single
    # atomic file; the driver extracts it (via //src/runtime/gcembed) to a cache file at link time. nomu_gc is
    # a dep only so `$(location)` can resolve the archive path for -sectcreate — the compiler references none
    # of its symbols, so nothing from it links into the compiler.
    linkopts = ["-Wl,-sectcreate,__DATA,__nomu_gc,$(location //src/runtime/gcbinding:nomu_gc)"],
    deps = [
        "//src/driver",
        "//src/cli",                        # the subcommand argument parser (task 186)
        "//src/runtime/gcbinding:nomu_gc",  # provides the embedded archive path (not linked for symbols)
        "//src/runtime/gcembed",            # reads the binary's embedded __nomu_gc section at link time
    ],
    visibility = ["//visibility:public"]
)
