# Nomu's own passes inside LLVM's code generator (C++ against LLVM's API), registered from the Swift backend
# through a C header.
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")

cc_library(
    name = "llvmpasses",
    srcs = [
        "CallBundles.cpp",
        "FrameAddressSplit.cpp",
        "LargeValues.cpp",
        "ReferenceAggregates.cpp",
        "StackChecks.cpp",
        "TrackFrameAddresses.cpp",
    ],
    hdrs = ["include/NomuLLVMPasses.h"],
    copts = ["-std=c++17"],
    includes = ["include"],
    aspect_hints = [":swift_module"],
    visibility = ["//src/llvmgen:__pkg__"],
    deps = [
        "@llvm-project//llvm:Analysis",
        "@llvm-project//llvm:CodeGen",
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:Passes",
        "@llvm-project//llvm:Support",
        "@llvm-project//llvm:Target",
        "@llvm-project//llvm:TransformUtils",
    ],
)

# Imported from Swift as `NomuLLVMPasses`.
swift_interop_hint(
    name = "swift_module",
    module_name = "NomuLLVMPasses",
)
