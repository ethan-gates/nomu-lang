load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")

# Symbol mangling (task 203): Rust's v0 scheme for every symbol a Nomu object exports. Its own library so the
# encoder's tests run without LLVM.
swift_library(
    name = "mangle",
    srcs = glob(["sources/*.swift"]),
    module_name = "mangle",
    deps = ["//src/support", "//src/frontend/ast"],
    visibility = ["//visibility:public"],
)

swift_test(
    name = "mangle_tests",
    srcs = glob(["tests/*.swift"]),
    deps = [":mangle", "//src/support"],
)
