load("@rules_swift//swift:swift.bzl", "swift_library")

# Syntactic interface module: Token (lex→parse), the untyped AST (parser output), and ASTDump.
# The format that `parse` produces and `sema` consumes — see design/m7-spec.md §7.1.
swift_library(
    name = "ast",
    srcs = glob(["sources/*.swift"]),
    module_name = "ast",
    deps = ["//src/support"],
    visibility = ["//visibility:public"],
)
