load("@rules_swift//swift:swift.bzl", "swift_library")

# Typed mid-level IR interface module: NOIR (Sema's output, codegen's input) + NOIRDump.
# The format `sema` produces and `midend`/`llvmgen` consume — see design/plans/m7-spec.md §7.1.
# Depends on `ast` for BinOp (NOIR reuses the AST binary-op enum).
swift_library(
    name = "noir",
    srcs = glob(["sources/*.swift"]),
    module_name = "noir",
    deps = ["//src/support", "//src/frontend/ast"],
    visibility = ["//visibility:public"],
)
