plan for nomu.mpbasic:app

workspaces
  nomu.mpbasic
  nomu.nomu

job nomu.nomu:runtime
  package runtime at @nomu.nomu/runtime (product)
  files runtime.nomu
  library, host-cache, runtime-subset
  out $cache/nomu/<key>/runtime/runtime
job nomu.nomu:std/prelude
  package std at @nomu.nomu/std (product)
  files prelude.nomu
  library, host-cache
  out $cache/nomu/<key>/std/prelude/prelude
job nomu.mpbasic:greet
  package greetlib at @nomu.mpbasic/greet (product)
  files lib.nomu
  library
  out @nomu.mpbasic/build/greet/greet
  import lib.nomu (implicit) std → nomu.nomu:std/prelude (package std)
  sees nomu.nomu:std/prelude
job nomu.mpbasic:app
  package app at @nomu.mpbasic/app
  files main.nomu
  binary
  out @nomu.mpbasic/build/app/app
  import main.nomu (implicit) std → nomu.nomu:std/prelude (package std)
  import main.nomu:5:1 greetlib → nomu.mpbasic:greet (package greetlib)
  sees nomu.nomu:std/prelude, nomu.mpbasic:greet

runtime archive $cache/runtime/<key>/nomu-runtime.a
link @nomu.mpbasic/build/app/app from 4 objects
