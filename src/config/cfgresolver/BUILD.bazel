load("@rules_swift//swift:swift.bzl", "swift_binary", "swift_library", "swift_test")

# `cfgresolver` (task 198): resolves a fixture tree of `cfg.yaml` files under a fixed made-up schema (a bakery)
# and prints the configuration record, one module's final values, or the builtin dump. Its golden tests cover
# the configuration library end to end without the compiler. `bazel run //src/config/cfgresolver -- --help`.
swift_library(
    name = "cfgresolver_lib",
    srcs = glob(["sources/*.swift"]),
    module_name = "cfgresolver",
    deps = ["//src/config", "//src/yaml", "//src/cli"],
    visibility = ["//visibility:public"],
)

swift_binary(
    name = "cfgresolver",
    srcs = ["main/main.swift"],
    deps = [":cfgresolver_lib"],
)

swift_test(
    name = "cfgresolver_tests",
    srcs = glob(["tests/*.swift"]),
    data = glob(["tests/cases/**"]),
    deps = [":cfgresolver_lib"],
)
