# M8.1 · 8.1.1 — LLVM toolchain bring-up. Smoke target proving @llvm-project links.
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_swift//swift:swift.bzl", "swift_binary", "swift_library")

# 8.1.2 — prove Swift drives LLVM's C API (LLVM_C module) against @llvm-project.
swift_library(
    name = "llvmswift",
    srcs = ["LLVMBridge.swift", "Lowering.swift"],
    module_name = "LLVMBridge",
    # C++ mode required even for LLVM's C API: LLVM_C transitively pulls LLVM_Config, whose
    # Clang module `requires cplusplus`. The C headers don't hit the C++ template pitfalls
    # (e.g. Support/Format.h) that break importing LLVM's C++ modules directly.
    copts = [
        "-cxx-interoperability-mode=default",
        "-Xcc",
        "-std=c++17",
    ],
    visibility = ["//visibility:public"],  # 8.1.4: the driver's --backend=llvm path deps on this
    deps = [
        "//src/frontend",  # 8.1.5: IRModule / the typed IR that IRToLLVM lowers
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:Analysis",  # LLVMVerifyModule
        # 8.1.4 object emission (llvm-c/TargetMachine.h): the TargetMachine C API lives in
        # :Target; :AllTargetsCodeGens registers the host backend that LLVMInitializeNativeTarget
        # / …AsmPrinter dispatch to (TargetInfo + Target + TargetMC + AsmPrinter).
        "@llvm-project//llvm:Target",
        "@llvm-project//llvm:CodeGen",
        "@llvm-project//llvm:MC",
        "@llvm-project//llvm:AllTargetsCodeGens",
        # 8.4.1: the new-PM runner (LLVMRunPasses) + all transform libraries, incl.
        # RewriteStatepointsForGC (Scalar) and mem2reg/sroa (Utils/Scalar). The GC pass
        # pipeline (mem2reg/sroa → rewrite-statepoints-for-gc) is driven from here.
        "@llvm-project//llvm:Passes",
    ],
)

swift_binary(
    name = "llvmswift_smoke",
    srcs = ["main.swift"],
    # cxx-interop is viral: importing LLVMBridge re-resolves the LLVM_C Clang module here too.
    copts = [
        "-cxx-interoperability-mode=default",
        "-Xcc",
        "-std=c++17",
    ],
    deps = [":llvmswift"],
)

cc_binary(
    name = "llvm_smoke",
    srcs = ["llvm_smoke.cpp"],
    deps = [
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:Support",
    ],
)
