load("@rules_swift//swift:swift.bzl", "swift_binary")

# compiler-test — the integration-suite harness (task 155). A Swift tool on the standard library,
# Foundation (JSON reports, Process env, DispatchQueue), Darwin (posix_spawn for the
# process-group-isolated, timeout-bounded runs) and the repository's YAML library (the manifest). One
# command compiles and runs whole-program fixtures from the YAML manifest in tests/suite. Design:
# design/plans/tasks/155-integration-suite-harness.md.
swift_binary(
    name = "compiler-test",
    srcs = glob(["sources/*.swift"]),
    deps = ["//src/yaml"],
    visibility = ["//visibility:public"],
)
