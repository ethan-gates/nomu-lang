// The M:N scheduler: run queue, carriers, timers, actor mailboxes, the live-fiber registry, the
// stop-the-world handshake, and the entry points generated code calls.
// Part of the `runtime` module; see README.md.

// ---- The M:N scheduler (task 128.1.9) ----
// The machinery proved rung-by-rung in the tests/fixtures/scheduler_*.nomu fixtures, consolidated here into one
// canonical scheduler that runs real GC-registered user programs. Generated code and the codegen-emitted
// process entry `main` call the `nomuSched*` functions below. A stop-the-world
// over the carriers (128.3.2) parks each fiber at a recorded user-frame anchor, and the collector runs
// rtWalkFrom over the live-fiber registry.
//
// The lock protocol is the lock-coupled park (concurrency.md §2): the carrier switches into a fiber with
// the scheduler lock HELD; the fiber releases it only after switch-in, runs lock-free, then re-acquires it
// to suspend/complete and switches back to the carrier while holding it — so a fiber's context is fully
// saved before any waker (which must hold the same lock to enqueue) can re-queue it.
//
// Off-heap layouts (byte offsets):
//   Sched: 0 runq-head · 8 runq-tail · 16 unused (the mutex word moved to 256) · 24 wake-gen · 32 active · 40 stopping
//                 · 48 timer-mutex · 56 timer-gen · 64 timer-count · 72 timer-entries (ptr)
//                 · 80 mbox-sched-head · 88 mbox-sched-tail · 96 active-drains · 104 mbfiber-free
//                 · 112 mbfiber-count · 120 drain-fn-ptr (nomu_actor_drain) · 128 registry-head
//                 · 136 stw-request · 144 stw-ack · 152 stw-gen · 160 ncarriers   (STW handshake, 128.3.2)
//                 · 168 gc-request   (OOM initiator → GC coordinator signal, 150.3.11)
//                 · 176 gc-kind      (collection kind for the coordinator: 1 minor, 0 major/defrag, 150.4.3;
//                                     bit 8 reserved for a concurrent request — rtGcRaise)
//                 · 200 drainers   (mailbox fibers able to pop the scheduled-mailbox queue: readied or
//                                   running in their loop, and not parked in a handler or on the free list)
//                 · 208 mbox-pops  (pops of the scheduled-mailbox queue; a searcher reads it to age the queue)
//   (384B, 64-aligned) Words written on every handoff sit on cache lines of their own, apart from the words
//   a searching carrier spins on (run-queue head, stop, stop-the-world): 256 the scheduler lock's mutex word;
//   320 sleeping (carriers asleep on the wake-gen futex) · 328 searching (1 while a woken carrier looks for
//   work; see rtSchedWake).
//   Timer entry (16B): 0 expiry-ns · 8 fiber
//   Mailbox (ABI with codegen): 0 header · 8 mb_head · 16 mb_tail · 24 scheduled · 32 sched_next
//   Message (ABI with codegen): 0 header · 8 next · 16 thunk · 24 self · args…
//     Both are GC objects codegen allocates (it supplies their pointer maps). An actor object is class-shaped
//     with its mailbox in its last slot, which codegen loads at the send, so the runtime never parses an
//     actor. mb_head, mb_tail, next, self and sched_next are GC-scanned (they chain live queued messages and
//     the scheduled-mailbox queue, kept live with the receiver); thunk, a code pointer, is not.
//   Fiber (304B): 0..167 ctx buffer · 168 state · 176 next-link · 184 entry · 192 arg · 200 sched
//                 · 208 stackBase · 216 result · 224 joiner · 232 carrierCtx · 240 reg-next · 248 reg-prev
//                 · 256 pool-next · 264 anchor-sp · 272 anchor-pc · 280 registered · 288 shadow-top (typed roots, 100.4.3.6)
//                 · 296 drainer (0 a user fiber; a mailbox fiber: 1 counted in sched drainers, 2 not counted)
//   state: 0 ready · 1 running · 2 parked · 3 done      mutex-word: 0 unlocked · 1 locked · 2 contended
//   anchor-sp/anchor-pc (task 128.3.2): the user-frame (sp, pc) captured by the C dispatch shim at the
//   point the fiber stopped (a park at join/sleep, or a safepoint poll) — a statepoint return address the
//   pcsp walk (rtWalkFrom) can match. Set before the fiber parks; the STW walk reads it.

// A 3-state futex mutex on the word at `m` (Drepper "mutex1": uncontended CAS fast path, a __ulock_wait
// slow path). Used for both the scheduler lock (sched+256) and the timer lock (sched+48).
fun rtSchedMutexLockAt(m: RawPtr) {
  var c: Int = m.atomicCas(0, 1, atByteOffset: 0)
  if c != 0 {
    if c != 2 {
      c = m.atomicExchange(2, atByteOffset: 0)
    }
    while c != 0 {
      Runtime.futexWait(at: m, expected: 2, timeoutMicros: 0)
      c = m.atomicExchange(2, atByteOffset: 0)
    }
  }
}

fun rtSchedMutexUnlockAt(m: RawPtr) {
  let prev: Int = m.atomicExchange(0, atByteOffset: 0)
  if prev == 2 {
    Runtime.futexWake(at: m, all: false)
  }
}

// The scheduler lock (sched+256). Held continuously across the carrier↔fiber boundary; user bodies run free.
fun rtSchedLock(sched: RawPtr) {
  rtSchedMutexLockAt(sched.advanced(by: 256))
}

fun rtSchedUnlock(sched: RawPtr) {
  rtSchedMutexUnlockAt(sched.advanced(by: 256))
}

// Make `fib` runnable and wake a carrier for it (a plain unpark, no in-flight save to race — used by the
// timer thread to fire a sleeper it has already removed from the heap).
fun rtSchedUnpark(sched: RawPtr, fib: RawPtr) {
  rtSchedLock(sched)
  fib.store(0, toByteOffset: 168)
  rtSchedEnqueue(sched, fib)
  rtSchedUnlock(sched)
  rtSchedWake(sched, false)
}

// Intrusive run queue (head at sched+0, tail at sched+8, link at fib+176). Touched only under the lock.
fun rtSchedEnqueue(sched: RawPtr, fib: RawPtr) {
  fib.store(RawPtr.null, toByteOffset: 176)
  let tail: RawPtr = sched.load(fromByteOffset: 8)
  if tail.isNull {
    sched.store(fib, toByteOffset: 0)
    sched.store(fib, toByteOffset: 8)
  } else {
    tail.store(fib, toByteOffset: 176)
    sched.store(fib, toByteOffset: 8)
  }
}

fun rtSchedDequeue(sched: RawPtr) -> RawPtr {
  let h: RawPtr = sched.load(fromByteOffset: 0)
  if h.isNull {
    return h
  }
  let nx: RawPtr = h.load(fromByteOffset: 176)
  sched.store(nx, toByteOffset: 0)
  if nx.isNull {
    sched.store(RawPtr.null, toByteOffset: 8)
  }
  h.store(RawPtr.null, toByteOffset: 176)
  return h
}

// Make `fib` runnable from the fiber running on this carrier: it goes in this carrier's run-queue slot
// (carrier record +104) to run next here, and a fiber already there moves to the run queue. The readier
// usually parks moments later, so the pair continues on this carrier; a searcher takes the slot's fiber if
// the readier keeps running (rtSchedSlotSteal). With NOMU_SLOT=0, or off a carrier, it goes on the run
// queue. The caller then wakes a carrier (rtSchedWake), as after rtSchedEnqueue, so a searcher is up to take
// the fiber if the readier keeps running (Go's `wakep`; task 234.3 chose this over a monitor). Caller holds
// the scheduler lock.
fun rtSchedReadyNext(sched: RawPtr, fib: RawPtr) {
  fib.store(0, toByteOffset: 168)
  let rec = Runtime.carrierLocal()
  if rtSlotOn == 0 || rec.isNull {
    rtSchedEnqueue(sched, fib)
    return
  }
  let old: RawPtr = rec.load(fromByteOffset: 104)
  rec.store(fib, toByteOffset: 104)
  if old.isNull {
  } else {
    rtSchedEnqueue(sched, old)
  }
}

// Choose this carrier's next fiber. Every NOMU_GLOBAL_CHECK picks the run queue's head comes first;
// otherwise the slot, then the run queue's head, then a fiber stolen from another carrier's slot. A fiber
// from the slot inherits the current slice; once the slice has run past NOMU_SLICE_NS it goes to the back of
// the run queue instead. Records when the chosen fiber starts (rec+112) and when a new slice begins
// (rec+120). Caller holds the scheduler lock.
fun rtSchedPick(sched: RawPtr, rec: RawPtr, picks: Int) -> RawPtr {
  if rtSlotOn == 0 {
    return rtSchedDequeue(sched)
  }
  var fib = RawPtr.null
  if picks % rtGlobalCheck == 0 {
    fib = rtSchedDequeue(sched)
  }
  let now = Runtime.ticks()
  var inherit = false
  if fib.isNull {
    let sl: RawPtr = rec.load(fromByteOffset: 104)
    if sl.isNull {
    } else {
      rec.store(RawPtr.null, toByteOffset: 104)
      let start: Int = rec.load(fromByteOffset: 120)
      if now - start > rtSliceTicks {
        rtSchedEnqueue(sched, sl)
        fib = rtSchedDequeue(sched)
        let more: RawPtr = sched.load(fromByteOffset: 0)
        if more.isNull {
        } else {
          rtSchedWake(sched, false)
        }
      } else {
        fib = sl
        inherit = true
      }
    }
  }
  if fib.isNull {
    fib = rtSchedDequeue(sched)
  }
  if fib.isNull {
    fib = rtSchedSlotSteal(rec, now)
  }
  if fib.isNull {
  } else {
    rec.atomicStore(now, toByteOffset: 112)
    if inherit {
    } else {
      rec.store(now, toByteOffset: 120)
    }
  }
  return fib
}

// Take a fiber from another carrier's slot whose current fiber has run past NOMU_SLOT_STEAL_NS (`now` in
// ticks), or null. Caller holds the scheduler lock.
fun rtSchedSlotSteal(mine: RawPtr, now: Int) -> RawPtr {
  var r: RawPtr = rtCarriers.load(fromByteOffset: 0)
  while !r.isNull {
    if r.toInt() != mine.toInt() {
      let sl: RawPtr = r.load(fromByteOffset: 104)
      if sl.isNull {
      } else {
        let st: Int = r.atomicLoad(fromByteOffset: 112)
        if now - st > rtSlotStealTicks {
          r.store(RawPtr.null, toByteOffset: 104)
          return sl
        }
      }
    }
    r = r.load(fromByteOffset: 96)
  }
  return RawPtr.null
}

// Whether another carrier's slot holds a fiber a searcher may take (rtSchedSlotSteal's test, read
// without the lock).
fun rtSchedSlotStealable(mine: RawPtr, now: Int) -> Bool {
  var r: RawPtr = rtCarriers.load(fromByteOffset: 0)
  while !r.isNull {
    if r.toInt() != mine.toInt() {
      let sl: Int = r.atomicLoad(fromByteOffset: 104)
      if sl != 0 {
        let st: Int = r.atomicLoad(fromByteOffset: 112)
        if now - st > rtSlotStealTicks {
          return true
        }
      }
    }
    r = r.load(fromByteOffset: 96)
  }
  return false
}

// Wake idle carriers after making work runnable. `all` (stop, stop-the-world) wakes every sleeper. Otherwise
// one carrier is woken, and only when one is asleep and none is already searching: a woken carrier searches
// (spins briefly for work, rtSchedLoop) and wakes the next itself if it finds more than it takes, so one
// search covers a burst of readyings. Without this, every readying made a system call, and with idle
// carriers woke one to find the work already taken (task 234).
//
// No work is lost: the work was enqueued under the scheduler lock before this runs. A carrier counts itself
// sleeping under that lock before it sleeps, so a skipped wake (none sleeping) means every carrier will
// look at the queue again; a searcher clears `searching` under the lock and rechecks the queue before it
// sleeps, so a wake skipped for a searcher is seen by that recheck. The wake-gen bump closes the
// unlock→futexWait window.
fun rtSchedWake(sched: RawPtr, all: Bool) {
  let gw = sched.advanced(by: 24)
  if all {
    gw.atomicFetchAdd(1, atByteOffset: 0)
    Runtime.futexWake(at: gw, all: true)
    return
  }
  let sleeping: Int = sched.atomicLoad(fromByteOffset: 320)
  if sleeping == 0 {
    return
  }
  let was: Int = sched.atomicCas(0, 1, atByteOffset: 328)
  if was != 0 {
    return
  }
  gw.atomicFetchAdd(1, atByteOffset: 0)
  Runtime.futexWake(at: gw, all: false)
}

// How long a woken carrier searches before sleeping again, in ns (NOMU_SEARCH_NS). Long enough to span many
// fiber switches, so back-to-back readyings find it searching rather than wake another.
fun rtSchedSearchNanos() -> Int {
  return rtSearchNanos
}

// Spin until runnable work appears (on the run queue, or in another carrier's slot it may take), the stop
// or stop-the-world flag is raised, or `until` passes. Reads without the lock; the caller takes the lock
// and picks. It also watches the scheduled-mailbox queue, and stops when the queue needs a fiber: it is
// non-empty with no drainer, or no drainer has popped it for NOMU_MBOX_AGE_NS. It then returns the pop count it judged the
// queue at (the caller rechecks it under the lock); otherwise -1.
fun rtSchedSpin(sched: RawPtr, until: Int) -> Int {
  let mine = Runtime.carrierLocal()
  let watchSlots = rtSlotOn != 0
  // Other carriers' slots are written on every handoff: look at them once a microsecond, well inside the
  // steal age, so the spin does not pull their cache lines away on every pass.
  var nextSlotCheck = 0
  let age = rtMboxAgeNanos
  var seenPops = -1
  var seenAt = 0
  var res = -1
  var go = true
  while go {
    let h: Int = sched.atomicLoad(fromByteOffset: 0)
    let stp: Int = sched.atomicLoad(fromByteOffset: 40)
    let stw: Int = sched.atomicLoad(fromByteOffset: 136)
    if h != 0 || stp != 0 || stw != 0 {
      go = false
    } else {
      let now = Runtime.monotonicNanos()
      var slotReady = false
      if watchSlots && now >= nextSlotCheck {
        nextSlotCheck = now + 1000
        slotReady = rtSchedSlotStealable(mine, Runtime.ticks())
      }
      if now > until {
        go = false
      } else if slotReady {
        go = false
      } else {
        let mh: Int = sched.atomicLoad(fromByteOffset: 80)
        if mh == 0 {
          seenPops = -1
        } else {
          let pops: Int = sched.atomicLoad(fromByteOffset: 208)
          let dr: Int = sched.atomicLoad(fromByteOffset: 200)
          if dr == 0 {
            res = pops
            go = false
          } else if pops != seenPops {
            seenPops = pops
            seenAt = now
          } else if now - seenAt > age {
            res = pops
            go = false
          }
        }
      }
    }
  }
  return res
}

// Wake the timer thread (it waits on the timer-gen word at sched+56): bump the word, then futexWake.
fun rtSchedWakeTimer(sched: RawPtr) {
  let tg = sched.advanced(by: 56)
  tg.atomicFetchAdd(1, atByteOffset: 0)
  Runtime.futexWake(at: tg, all: false)
}

// Raise the stop flag and wake everyone (idle carriers, the timer thread and the GC coordinator) so they
// exit for the join.
fun rtSchedSignalStop(sched: RawPtr) {
  sched.atomicStore(1, toByteOffset: 40)
  rtSchedWake(sched, true)
  rtSchedWakeTimer(sched)
  Runtime.futexWake(at: sched.advanced(by: 168), all: false)
}

// ---- Timer heap (min-heap on the timer-entries buffer; entry i at i*16: expiry +0, fiber +8). Touched
// only under the timer lock at sched+48. Backs fiberSleep (rt_sleep_ms). ----

fun rtSchedHeapSwap(ents: RawPtr, a: Int, b: Int) {
  let ea = a * 16
  let eb = b * 16
  let x1: Int = ents.load(fromByteOffset: ea)
  let f1: RawPtr = ents.load(fromByteOffset: ea + 8)
  let x2: Int = ents.load(fromByteOffset: eb)
  let f2: RawPtr = ents.load(fromByteOffset: eb + 8)
  ents.store(x2, toByteOffset: ea)
  ents.store(f2, toByteOffset: ea + 8)
  ents.store(x1, toByteOffset: eb)
  ents.store(f1, toByteOffset: eb + 8)
}

fun rtSchedTimerPush(sched: RawPtr, expiry: Int, fib: RawPtr) {
  let ents: RawPtr = sched.load(fromByteOffset: 72)
  var i: Int = sched.load(fromByteOffset: 64)
  sched.store(i + 1, toByteOffset: 64)
  ents.store(expiry, toByteOffset: i * 16)
  ents.store(fib, toByteOffset: i * 16 + 8)
  var go = true
  while go {
    if i == 0 {
      go = false
    } else {
      let p = (i - 1) / 2
      let ep: Int = ents.load(fromByteOffset: p * 16)
      let ei: Int = ents.load(fromByteOffset: i * 16)
      if ep <= ei {
        go = false
      } else {
        rtSchedHeapSwap(ents, p, i)
        i = p
      }
    }
  }
}

// Remove the earliest-deadline entry (caller checked count > 0); writes its expiry/fiber to out+0 / out+8.
fun rtSchedTimerPopMin(sched: RawPtr, out: RawPtr) {
  let ents: RawPtr = sched.load(fromByteOffset: 72)
  let x0: Int = ents.load(fromByteOffset: 0)
  let f0: RawPtr = ents.load(fromByteOffset: 8)
  out.store(x0, toByteOffset: 0)
  out.store(f0, toByteOffset: 8)
  var n: Int = sched.load(fromByteOffset: 64) - 1
  sched.store(n, toByteOffset: 64)
  if n > 0 {
    let xl: Int = ents.load(fromByteOffset: n * 16)
    let fl: RawPtr = ents.load(fromByteOffset: n * 16 + 8)
    ents.store(xl, toByteOffset: 0)
    ents.store(fl, toByteOffset: 8)
    var i = 0
    var go = true
    while go {
      let l = 2 * i + 1
      let r = 2 * i + 2
      var s = i
      let es: Int = ents.load(fromByteOffset: s * 16)
      if l < n {
        let el: Int = ents.load(fromByteOffset: l * 16)
        if el < es {
          s = l
        }
      }
      let es2: Int = ents.load(fromByteOffset: s * 16)
      if r < n {
        let er: Int = ents.load(fromByteOffset: r * 16)
        if er < es2 {
          s = r
        }
      }
      if s == i {
        go = false
      } else {
        rtSchedHeapSwap(ents, i, s)
        i = s
      }
    }
  }
}

// The timer thread: sleep on the timer-gen futex until the earliest deadline (or a push), then unpark the
// due fiber. Exits on the stop flag. A raw thread that touches only off-heap memory (no user code), so it
// needs no mutator registration.
fun rtSchedTimerMain(sched: RawPtr) -> RawPtr {
  rtFaultThreadStart(2, 0)
  let out = RawPtr.alloc(bytes: 16, align: 8)
  var go = true
  while go {
    let stp: Int = sched.atomicLoad(fromByteOffset: 40)
    if stp != 0 {
      go = false
    } else {
      rtSchedMutexLockAt(sched.advanced(by: 48))
      let count: Int = sched.load(fromByteOffset: 64)
      if count == 0 {
        let tg = sched.advanced(by: 56)
        let gen: Int = tg.atomicLoad(fromByteOffset: 0)
        rtSchedMutexUnlockAt(sched.advanced(by: 48))
        Runtime.futexWait(at: tg, expected: gen, timeoutMicros: 1000000)
      } else {
        let ents: RawPtr = sched.load(fromByteOffset: 72)
        let next: Int = ents.load(fromByteOffset: 0)
        let now: Int = Runtime.monotonicNanos()
        if next <= now {
          rtSchedTimerPopMin(sched, out)
          rtSchedMutexUnlockAt(sched.advanced(by: 48))
          let f: RawPtr = out.load(fromByteOffset: 8)
          rtSchedUnpark(sched, f)
        } else {
          let tg = sched.advanced(by: 56)
          let gen: Int = tg.atomicLoad(fromByteOffset: 0)
          rtSchedMutexUnlockAt(sched.advanced(by: 48))
          // At least 1 µs: a timeout of 0 means no timeout, so a deadline under 1 µs away would otherwise
          // wait for the next push.
          var waitUs: Int = (next - now) / 1000
          if waitUs < 1 {
            waitUs = 1
          }
          Runtime.futexWait(at: tg, expected: gen, timeoutMicros: waitUs)
        }
      }
    }
  }
  return sched
}

// Allocate + seed a fresh fiber: a 128 KB stack (rtStackNew) and a handle whose first
// switch-in lands in rtSchedFiberMain. Created parked; the spawner readies and enqueues it.
fun rtSchedFiberNew(sched: RawPtr, entry: RawPtr, arg: RawPtr) -> RawPtr {
  let stack = rtStackNew()
  let stackTop = stack.advanced(by: rtStackBytes)
  let fib = RawPtr.alloc(bytes: 304, align: 16)
  fib.store(2, toByteOffset: 168)
  fib.store(RawPtr.null, toByteOffset: 176)
  fib.store(entry, toByteOffset: 184)
  fib.store(arg, toByteOffset: 192)
  fib.store(sched, toByteOffset: 200)
  fib.store(stack, toByteOffset: 208)
  fib.store(RawPtr.null, toByteOffset: 216)
  fib.store(RawPtr.null, toByteOffset: 224)
  fib.store(RawPtr.null, toByteOffset: 232)
  fib.store(RawPtr.null, toByteOffset: 240)   // reg-next
  fib.store(RawPtr.null, toByteOffset: 248)   // reg-prev
  fib.store(RawPtr.null, toByteOffset: 256)   // pool-next
  fib.store(RawPtr.null, toByteOffset: 264)   // anchor-sp
  fib.store(0, toByteOffset: 272)             // anchor-pc
  fib.store(RawPtr.null, toByteOffset: 288)   // shadow-top — typed-root list head (erased non-POD T, 100.4.3.6)
  fib.store(0, toByteOffset: 296)             // drainer: none
  Runtime.fiberInit(context: fib, stackTop: stackTop, entry: Runtime.ofFunc(rtSchedFiberMain), arg: fib)
  return fib
}

// Fiber trampoline: resume with the lock held, release it, run the user body (via callEntry — the subset
// scheduler → non-subset user body boundary), re-acquire to record completion, wake any joiner, drive the
// active count to quiescence, and switch back to the carrier that ran us (holding the lock).
fun rtSchedFiberMain(fib: RawPtr) -> RawPtr {
  let sched: RawPtr = fib.load(fromByteOffset: 200)
  rtSchedUnlock(sched)
  let entry: RawPtr = fib.load(fromByteOffset: 184)
  let arg: RawPtr = fib.load(fromByteOffset: 192)
  // The argument (a spawn's managed closure environment) is rooted at fib+192 only until the fiber starts;
  // from here the entry's own frames hold it. Clear the word so the walk never roots a stale copy.
  fib.store(RawPtr.null, toByteOffset: 192)
  let res = Runtime.callEntry(entry, arg: arg)
  rtSchedLock(sched)
  fib.store(res, toByteOffset: 216)
  fib.store(3, toByteOffset: 168)
  // Stay in the live-fiber registry (150.3.13): the result box at fib+216 is a managed object reachable only
  // from here until the joiner reads it, so the STW walk must keep rooting it. The final (scope-exit) join
  // drops the fiber from the registry once the box is no longer needed.
  let joiner: RawPtr = fib.load(fromByteOffset: 224)
  if joiner.isNull {
  } else {
    rtSchedReadyNext(sched, joiner)
    rtSchedWake(sched, false)
  }
  let r: Int = sched.atomicFetchAdd(-1, atByteOffset: 32)
  if r == 1 {
    let ad: Int = sched.atomicLoad(fromByteOffset: 96)     // stay alive while actor drains are outstanding
    if ad == 0 {
      rtSchedSignalStop(sched)
    }
  }
  let carrierCtx: RawPtr = fib.load(fromByteOffset: 232)
  Runtime.ctxSwitch(from: fib, to: carrierCtx)
  return fib
}

// A carrier with nothing to run, about to sleep while mailboxes are queued behind a busy drainer, searches
// instead (when no other carrier is), so it can take them once they age. Caller holds the scheduler lock.
fun rtSchedMboxBecomeSearcher(sched: RawPtr) -> Bool {
  let h: RawPtr = sched.load(fromByteOffset: 80)
  if h.isNull {
    return false
  }
  let was: Int = sched.atomicCas(0, 1, atByteOffset: 328)
  return was == 0
}

// The carrier loop: hold the lock, switch into each ready fiber (recording it in this carrier's record), or
// sleep on the wake-gen futex when the queue is empty. Exit when the stop flag is raised.
fun rtSchedLoop(sched: RawPtr, myCtx: RawPtr) {
  let rec = rtCarrier()
  rtSchedLock(sched)
  var searching = false
  var searchUntil = 0
  var picks = 0
  var go = true
  while go {
    let stp: Int = sched.atomicLoad(fromByteOffset: 40)
    if stp != 0 {
      go = false
    } else {
      let stwReq: Int = sched.atomicLoad(fromByteOffset: 136)
      if stwReq != 0 {
        // Stop-the-world in progress: this carrier is quiescent (no fiber on-CPU), so ack and wait.
        rtSchedUnlock(sched)
        rtSchedStwParkCarrier(sched)
        rtSchedLock(sched)
      } else {
        picks += 1
        let fib = rtSchedPick(sched, rec, picks)
        var readied = false
        if fib.isNull {
          // Mailboxes are queued and no drainer will pop them, so ready one here.
          if rtSchedMboxUnserved(sched) {
            readied = rtSchedMboxReady(sched)
          }
        }
        if readied {
        } else if fib.isNull {
          if searching {
            if Runtime.monotonicNanos() < searchUntil {
              rtSchedUnlock(sched)
              let agedAt = rtSchedSpin(sched, searchUntil)
              rtSchedLock(sched)
              if agedAt >= 0 {
                // The scheduled-mailbox queue went unserved while this carrier spun: ready a mailbox
                // fiber for it if nothing has popped it since.
                let mh: RawPtr = sched.load(fromByteOffset: 80)
                let pops: Int = sched.load(fromByteOffset: 208)
                let dr: Int = sched.load(fromByteOffset: 200)
                if mh.isNull {
                } else if dr == 0 || pops == agedAt {
                  rtSchedMboxReady(sched)
                }
              }
            } else {
              // Give up the search; the loop rechecks the queue under the lock before sleeping.
              sched.atomicStore(0, toByteOffset: 328)
              searching = false
            }
          } else if rtSchedMboxBecomeSearcher(sched) {
            searching = true
            searchUntil = Runtime.monotonicNanos() + rtSchedSearchNanos()
          } else {
            let gw = sched.advanced(by: 24)
            let gen: Int = gw.atomicLoad(fromByteOffset: 0)
            sched.atomicFetchAdd(1, atByteOffset: 320)
            rtSchedUnlock(sched)
            Runtime.futexWait(at: gw, expected: gen, timeoutMicros: 1000000)
            rtSchedLock(sched)
            sched.atomicFetchAdd(-1, atByteOffset: 320)
            let srch: Int = sched.atomicLoad(fromByteOffset: 328)
            if srch != 0 {
              searching = true
              searchUntil = Runtime.monotonicNanos() + rtSchedSearchNanos()
            }
          }
        } else {
          if searching {
            // Found work: end the search, and pass it on if more is queued.
            sched.atomicStore(0, toByteOffset: 328)
            searching = false
            let more: RawPtr = sched.load(fromByteOffset: 0)
            if more.isNull {
            } else {
              rtSchedWake(sched, false)
            }
          }
          // A mailbox fiber resumed after parking in a handler can pop the scheduled queue again.
          let drn: Int = fib.load(fromByteOffset: 296)
          if drn == 2 {
            fib.store(1, toByteOffset: 296)
            let dr: Int = sched.load(fromByteOffset: 200)
            sched.atomicStore(dr + 1, toByteOffset: 200)
          }
          fib.store(myCtx, toByteOffset: 232)
          fib.store(1, toByteOffset: 168)
          rec.store(fib, toByteOffset: 64)
          if rtStackMoveOn {
            rtStackMove(fib)                         // the stress mode: a new stack at every resume
          }
          Runtime.ctxSwitch(from: myCtx, to: fib)
          // If the fiber stopped at a safepoint for STW (state 4), this carrier acks and waits, then
          // switches back into it to resume past the poll — repeating if another STW round follows.
          var fst: Int = fib.load(fromByteOffset: 168)
          while fst == 4 {
            rtSchedUnlock(sched)
            rtSchedStwParkCarrier(sched)
            rtSchedLock(sched)
            fib.store(1, toByteOffset: 168)
            rec.store(fib, toByteOffset: 64)
            if rtStackMoveOn {
              rtStackMove(fib)
            }
            Runtime.ctxSwitch(from: myCtx, to: fib)
            fst = fib.load(fromByteOffset: 168)
          }
          // A mailbox fiber back here while still a drainer parked inside a handler: it cannot pop the
          // scheduled queue until it resumes.
          let drAfter: Int = fib.load(fromByteOffset: 296)
          if drAfter == 1 {
            fib.store(2, toByteOffset: 296)
            let dr: Int = sched.load(fromByteOffset: 200)
            sched.atomicStore(dr - 1, toByteOffset: 200)
          }
        }
      }
    }
  }
  rtSchedUnlock(sched)
}

// A carrier thread's entry (started via threadCreate). `carg` is [0] sched · [8] context buffer · [16] the
// carrier's number.
fun rtSchedCarrierMain(carg: RawPtr) -> RawPtr {
  let index: Int = carg.load(fromByteOffset: 16)
  rtFaultThreadStart(1, index)
  let sched: RawPtr = carg.load(fromByteOffset: 0)
  let ctx: RawPtr = carg.load(fromByteOffset: 8)
  rtSchedLoop(sched, ctx)
  return carg
}

// ---- Actor mailbox + capped mailbox-fiber pool (task 128.1.8 machinery, consolidated). Fire-and-forget
// message send: nomuSchedActorSend enqueues a message and returns; a pool of ≤64 reusable mailbox fibers
// drains scheduled mailboxes by running the codegen-emitted nomu_actor_drain (which pops via the C
// rt_mailbox_pop → nomuSchedMailboxPop and runs each message's thunk). The mailbox/message byte offsets are
// the ABI with codegen (the layout table above). The global scheduled-mailbox queue lives in the Sched; the STW
// walk roots its head and tail (nomuSchedStwCollectDefrag). ----

// Pop the head of the global scheduled-mailbox queue (mailbox sched_next at +32), or null. Caller holds
// the scheduler lock; the returned mailbox stays scheduled — the caller is now its drainer.
fun rtSchedMboxSchedPop(sched: RawPtr) -> RawPtr {
  let mb: RawPtr = sched.load(fromByteOffset: 80)
  if mb.isNull {
    return mb
  }
  let nx: RawPtr = mb.load(fromByteOffset: 32)
  sched.store(nx, toByteOffset: 80)
  if nx.isNull {
    sched.store(RawPtr.null, toByteOffset: 88)
  }
  mb.store(RawPtr.null, toByteOffset: 32)
  let pops: Int = sched.load(fromByteOffset: 208)
  sched.atomicStore(pops + 1, toByteOffset: 208)
  return mb
}

// A mailbox fiber: seeded to land here on first switch-in, resumed inside the loop thereafter. Unlike a
// user fiber, it runs with the scheduler lock HELD at every loop top: it pops a scheduled mailbox under the lock, drops the lock to drain it, re-takes it; when
// none remain it parks on the free-list (switching to the carrier holding the lock).
fun rtSchedMailboxFiberMain(fib: RawPtr) -> RawPtr {
  let sched: RawPtr = fib.load(fromByteOffset: 200)
  let drainPtr: RawPtr = sched.load(fromByteOffset: 120)
  var go = true
  while go {
    let mb = rtSchedMboxSchedPop(sched)
    if mb.isNull {
      let freeHead: RawPtr = sched.load(fromByteOffset: 104)
      fib.store(freeHead, toByteOffset: 256)                          // pool_next = free
      sched.store(fib, toByteOffset: 104)                             // free = self
      fib.store(2, toByteOffset: 168)                                 // parked
      fib.store(RawPtr.null, toByteOffset: 264)                       // idle: no roots — STW walk skips it
      fib.store(2, toByteOffset: 296)                                 // no longer a drainer
      let dr: Int = sched.load(fromByteOffset: 200)
      sched.atomicStore(dr - 1, toByteOffset: 200)
      let carrierCtx: RawPtr = fib.load(fromByteOffset: 232)
      Runtime.ctxSwitch(from: fib, to: carrierCtx)                                     // hand lock to scheduler; resume with it held
    } else {
      // More mailboxes are queued behind this one: let a searcher come, in case this drain runs long.
      let more: RawPtr = sched.load(fromByteOffset: 80)
      if more.isNull {
      } else {
        rtSchedWake(sched, false)
      }
      rtSchedUnlock(sched)
      Runtime.callEntry(drainPtr, arg: mb)                                          // nomu_actor_drain(mb), lock-free
      rtSchedLock(sched)
    }
  }
  return fib
}

// Allocate a fresh mailbox fiber, seeded to enter rtSchedMailboxFiberMain. Infrastructure — not counted
// in `active`. Caller holds the scheduler lock.
fun rtSchedMailboxFiberNew(sched: RawPtr) -> RawPtr {
  let stack = rtStackNew()
  let stackTop = stack.advanced(by: rtStackBytes)
  let fib = RawPtr.alloc(bytes: 304, align: 16)
  fib.store(0, toByteOffset: 168)
  fib.store(RawPtr.null, toByteOffset: 176)
  fib.store(sched, toByteOffset: 200)
  fib.store(stack, toByteOffset: 208)
  fib.store(RawPtr.null, toByteOffset: 232)
  fib.store(RawPtr.null, toByteOffset: 256)
  fib.store(RawPtr.null, toByteOffset: 264)   // anchor-sp (set when a handler parks / stops at a safepoint)
  fib.store(0, toByteOffset: 272)             // anchor-pc
  fib.store(RawPtr.null, toByteOffset: 288)   // shadow-top — typed-root list head (erased non-POD T, 100.4.3.6)
  fib.store(0, toByteOffset: 296)             // drainer: none
  rtSchedRegInsert(sched, fib)                // in the registry so a handler stopped mid-drain is STW-walked
  Runtime.fiberInit(context: fib, stackTop: stackTop, entry: Runtime.ofFunc(rtSchedMailboxFiberMain), arg: fib)
  return fib
}

// Ready a mailbox fiber to pop the scheduled queue: a free one, else a new one up to the cap (64). Counts
// it as a drainer. Returns false at the cap with all busy (a busy fiber pops the queue when it frees).
// Caller holds the scheduler lock.
fun rtSchedMboxReady(sched: RawPtr) -> Bool {
  var f: RawPtr = sched.load(fromByteOffset: 104)
  if f.isNull {
    let cnt: Int = sched.load(fromByteOffset: 112)
    if cnt >= 64 {
      return false
    }
    f = rtSchedMailboxFiberNew(sched)
    sched.store(cnt + 1, toByteOffset: 112)
  } else {
    let pn: RawPtr = f.load(fromByteOffset: 256)
    sched.store(pn, toByteOffset: 104)                           // free = f->pool_next
    f.store(RawPtr.null, toByteOffset: 256)
    f.store(RawPtr.null, toByteOffset: 288)                       // reset shadow-top on reuse (typed roots)
  }
  f.store(0, toByteOffset: 168)
  f.store(1, toByteOffset: 296)
  let dr: Int = sched.load(fromByteOffset: 200)
  sched.atomicStore(dr + 1, toByteOffset: 200)
  rtSchedEnqueue(sched, f)
  return true
}

// A send scheduled a mailbox (its 0→1 edge); see that a mailbox fiber will pop it. The send readies none: a
// drainer already running pops the queue next (in a ping-pong, the sender's own fiber, moments later), and
// with no drainer an idle carrier readies one (rtSchedLoop), so the send only wakes a carrier when there is
// no drainer. A busy drainer's backlog reaches other carriers through searchers (NOMU_MBOX_AGE_NS). Readying
// a fiber on every send instead split a two-actor ping-pong across carriers and grew the pool to its cap
// (task 234). Caller holds the scheduler lock.
fun rtSchedMailboxDispatch(sched: RawPtr) {
  let dr: Int = sched.load(fromByteOffset: 200)
  if dr == 0 {
    rtSchedWake(sched, false)
  }
}

// Whether an idle carrier should ready a mailbox fiber now: mailboxes are queued and no
// drainer will pop them. Caller holds the scheduler lock.
fun rtSchedMboxUnserved(sched: RawPtr) -> Bool {
  let h: RawPtr = sched.load(fromByteOffset: 80)
  if h.isNull {
    return false
  }
  let dr: Int = sched.load(fromByteOffset: 200)
  return dr == 0
}

// ---- Live-fiber registry + self-hosted STW root walk (task 128.3.2). The registry (head at sched+128,
// intrusive doubly-linked through fib reg-next/reg-prev) tracks every live user fiber so a stop-the-world
// can enumerate them; each parked fiber carries a user-frame anchor its C dispatch shim captured, which
// rtWalkFrom reads directly — no libunwind. Maintained under the scheduler lock (insert on spawn, remove
// on completion). ----

fun rtSchedRegInsert(sched: RawPtr, fib: RawPtr) {
  let head: RawPtr = sched.load(fromByteOffset: 128)
  fib.store(RawPtr.null, toByteOffset: 248)   // prev = null (new head)
  fib.store(head, toByteOffset: 240)          // next = old head
  if head.isNull {
  } else {
    head.store(fib, toByteOffset: 248)        // old head's prev = fib
  }
  sched.store(fib, toByteOffset: 128)
  fib.store(1, toByteOffset: 280)             // registered = 1 (150.3.13: gate for idempotent remove)
}

// Idempotent: a fiber's structured scope-exit join may finalize it more than once (nested scopes re-run
// joinSpawns over the same binding), so removing an already-removed fiber is a no-op (150.3.13).
fun rtSchedRegRemove(sched: RawPtr, fib: RawPtr) {
  let reg: Int = fib.load(fromByteOffset: 280)
  if reg == 0 {
    return
  }
  fib.store(0, toByteOffset: 280)
  let prev: RawPtr = fib.load(fromByteOffset: 248)
  let next: RawPtr = fib.load(fromByteOffset: 240)
  if prev.isNull {
    sched.store(next, toByteOffset: 128)      // fib was the head
  } else {
    prev.store(next, toByteOffset: 240)
  }
  if next.isNull {
  } else {
    next.store(prev, toByteOffset: 248)
  }
}

// Store the user-frame anchor (captured by a C dispatch shim) into the current fiber. Called from a Nomu
// park path just before ctxSwitchTo, so the STW walk finds a valid anchor on every parked fiber.
fun rtSchedSetAnchor(fib: RawPtr, anchorSp: RawPtr, anchorPc: Int) {
  fib.store(anchorSp, toByteOffset: 264)
  fib.store(anchorPc, toByteOffset: 272)
}

// A carrier acknowledges the stop-the-world and waits for resume. Called by a carrier that has reached a
// quiescent point under an active STW (idle at the loop top, or after its running fiber parked at a
// safepoint). Bumps the ack count (waking the initiator, which waits on it) and sleeps on the stw-gen
// futex until the initiator bumps it at resume. One ack per carrier per STW.
//
// Resume is the stw-gen bump, read before the ack. Waiting on the request flag (+136) instead loses a round:
// a carrier still waking from one STW can find the next STW's request already set, keep waiting without
// acking it, and the initiator — which reset the ack count at resume — waits for that ack forever.
//
// The ack word (+144) is the stw-gen it counts for, in its high 32 bits (rtStwAckTag), over the count in its
// low 32. A carrier adds its ack only while the tag matches the stw-gen it read. Without the tag, a carrier
// that read the request just before the initiator cleared it, and acked just after the initiator reset the
// count, would add its ack to the next STW's count, which could then start with a fiber still running. With
// it, that late ack finds the next STW's tag and is dropped, and the carrier returns at the stw-gen bump.
fun rtSchedStwParkCarrier(sched: RawPtr) {
  let gw = sched.advanced(by: 152)
  let g: Int = gw.atomicLoad(fromByteOffset: 0)
  let ack = sched.advanced(by: 144)
  let tag = rtStwAckTag(g)
  var acked = false
  var trying = true
  while trying {
    let w: Int = ack.atomicLoad(fromByteOffset: 0)
    if w - w % 4294967296 != tag {
      trying = false                                          // that STW has resumed: a late ack
    } else {
      let was: Int = ack.atomicCas(w, w + 1, atByteOffset: 0)
      if was == w {
        acked = true
        trying = false
      }
    }
  }
  if acked {
    Runtime.futexWake(at: ack, all: true)                     // the initiator waits on the ack count
  }
  while gw.atomicLoad(fromByteOffset: 0) == g {
    Runtime.futexWait(at: gw, expected: g, timeoutMicros: 1000000)
  }
}

// The ack word's tag for stw-gen `g`: its high 32 bits (the generation modulo 2^31, so the word stays
// positive). The futex the initiator waits on compares the low 32 bits, the count.
fun rtStwAckTag(g: Int) -> Int {
  return g % 2147483648 * 4294967296
}

// The stop-the-world flag: an `Int`, nonzero while a collection asks running fibers to stop. Codegen's
// inline poll reads it by symbol (`nomu_static_rtStopWorld`) at every loop back-edge; the GC coordinator
// (rtGcCoordinatorMain) writes it.
let rtStopWorld = Runtime.staticStorage(bytes: 8, align: 8)

// The safepoint slow path under the Nomu plan (called from __nomu_gc_poll_slow when `rtStopWorld` is
// set). The running fiber records the user-frame anchor its C poll shim captured, marks itself
// safepoint-stopped (state 4), and switches to its carrier — which then acks the STW and waits. On resume
// the carrier switches back in and this returns, so the fiber continues past the poll. The carrier holds
// the scheduler lock across the switch (the lock-coupled protocol), released here after switch-back-in.
fun nomuSchedSafepoint(sched: RawPtr, anchorSp: RawPtr, anchorPc: Int) {
  let self = rtCurrentFiber()
  rtSchedSetAnchor(self, anchorSp, anchorPc)
  rtSchedLock(sched)
  self.store(4, toByteOffset: 168)               // safepoint-stopped
  let carrierCtx: RawPtr = self.load(fromByteOffset: 232)
  Runtime.ctxSwitch(from: self, to: carrierCtx)
  rtSchedUnlock(sched)
}

// ---- Entry points generated code calls (symbols nomu_fn_nomuSched*) ----

// Allocate + init a scheduler. Returns the opaque Sched handle; the runtime's is the startup global `rtSched`.
fun nomuSchedNew() -> RawPtr {
  let sched = RawPtr.alloc(bytes: 384, align: 64)
  sched.store(RawPtr.null, toByteOffset: 0)
  sched.store(RawPtr.null, toByteOffset: 8)
  sched.store(0, toByteOffset: 16)
  sched.store(0, toByteOffset: 256)                      // mutex-word
  sched.store(0, toByteOffset: 24)
  sched.store(0, toByteOffset: 32)
  sched.store(0, toByteOffset: 40)
  sched.store(0, toByteOffset: 48)                       // timer-mutex
  sched.store(0, toByteOffset: 56)                       // timer-gen
  sched.store(0, toByteOffset: 64)                       // timer-count
  let ents = RawPtr.alloc(bytes: 256 * 16, align: 8)     // timer heap (256 entries, matching the C runtime)
  sched.store(ents, toByteOffset: 72)
  sched.store(RawPtr.null, toByteOffset: 80)             // mbox-sched-head
  sched.store(RawPtr.null, toByteOffset: 88)             // mbox-sched-tail
  sched.store(0, toByteOffset: 96)                       // active-drains
  sched.store(RawPtr.null, toByteOffset: 104)            // mbfiber-free (pool free-list)
  sched.store(0, toByteOffset: 112)                      // mbfiber-count
  sched.store(RawPtr.null, toByteOffset: 120)            // drain-fn-ptr (set when an actor is created)
  sched.store(RawPtr.null, toByteOffset: 128)            // live-fiber registry head
  sched.store(0, toByteOffset: 136)                      // stw-request
  sched.store(0, toByteOffset: 144)                      // stw-ack
  sched.store(0, toByteOffset: 152)                      // stw-gen
  sched.store(0, toByteOffset: 160)                      // ncarriers (set at boot)
  sched.store(0, toByteOffset: 168)                      // gc-request  (OOM→coordinator signal, 150.3.11)
  sched.store(0, toByteOffset: 176)                      // gc-kind
  sched.store(0, toByteOffset: 320)                      // sleeping
  sched.store(0, toByteOffset: 328)                      // searching
  sched.store(0, toByteOffset: 200)                      // drainers
  sched.store(0, toByteOffset: 208)                      // mbox-pops
  return sched
}

// Sleep the current fiber for `ms` milliseconds: register the deadline on the timer heap and park, holding
// the scheduler lock across both so the timer thread's unpark cannot re-queue us before our context is
// saved (lock-handoff spanning scheduler↔timer). Returns `ms`. The C rt_sleep_ms shim dispatches here.
fun nomuSchedSleep(sched: RawPtr, ms: Int, anchorSp: RawPtr, anchorPc: Int) -> Int {
  let self = rtCurrentFiber()
  rtSchedSetAnchor(self, anchorSp, anchorPc)   // user-frame anchor for the STW walk (128.3.2)
  let expiry: Int = Runtime.monotonicNanos() + ms * 1000000
  rtSchedLock(sched)
  rtSchedMutexLockAt(sched.advanced(by: 48))
  rtSchedTimerPush(sched, expiry, self)
  rtSchedMutexUnlockAt(sched.advanced(by: 48))
  rtSchedWakeTimer(sched)
  self.store(2, toByteOffset: 168)
  let carrierCtx: RawPtr = self.load(fromByteOffset: 232)
  Runtime.ctxSwitch(from: self, to: carrierCtx)
  rtSchedUnlock(sched)
  return ms
}

// Park the running fiber until some feeder unparks it (rtSchedUnpark). The caller holds the scheduler lock,
// taken after it registered the fiber with that feeder, so the feeder's unpark cannot re-queue the fiber
// before its context is saved — the lock handoff nomuSchedSleep uses. Returns with the lock released. The
// anchor is the user frame the forwarder captured, for the STW walk. Used by rtReadLine (the stdin poller).
fun nomuSchedParkLocked(sched: RawPtr, anchorSp: RawPtr, anchorPc: Int) {
  let self = rtCurrentFiber()
  rtSchedSetAnchor(self, anchorSp, anchorPc)
  self.store(2, toByteOffset: 168)
  let carrierCtx: RawPtr = self.load(fromByteOffset: 232)
  Runtime.ctxSwitch(from: self, to: carrierCtx)
  rtSchedUnlock(sched)
}

// Spawn a runnable fiber over the given C-ABI entry (void*(void*)). Returns the fiber handle, which the C
// spawn_join shim passes back to nomuSchedJoin. Bumps the active count and wakes an idle carrier.
fun nomuSchedSpawn(sched: RawPtr, entry: RawPtr, arg: RawPtr) -> RawPtr {
  let fib = rtSchedFiberNew(sched, entry, arg)
  sched.atomicFetchAdd(1, atByteOffset: 32)
  rtSchedLock(sched)
  fib.store(0, toByteOffset: 168)
  rtSchedRegInsert(sched, fib)          // track in the live-fiber registry (STW enumeration, 128.3.2)
  rtSchedEnqueue(sched, fib)
  rtSchedUnlock(sched)
  rtSchedWake(sched, false)
  return fib
}

// Await a fiber and return its result. Called from within the joining fiber, which parks lock-coupled
// (identifying itself through its carrier record) if the target has not completed.
fun nomuSchedJoin(sched: RawPtr, target: RawPtr, anchorSp: RawPtr, anchorPc: Int, final: Int) -> RawPtr {
  rtSchedLock(sched)
  let st: Int = target.load(fromByteOffset: 168)
  if st == 3 {
    // already done — fall through holding the lock
  } else {
    let me = rtCurrentFiber()
    rtSchedSetAnchor(me, anchorSp, anchorPc)   // user-frame anchor for the STW walk (128.3.2)
    target.store(me, toByteOffset: 224)
    me.store(2, toByteOffset: 168)
    let carrierCtx: RawPtr = me.load(fromByteOffset: 232)
    Runtime.ctxSwitch(from: me, to: carrierCtx)                 // resumes here holding the lock (lock-coupled)
  }
  // The world is stopped for collection only at safepoints; this runs the join body lock-held without a
  // safepoint, so the box read + registry drop are atomic w.r.t. a collection (150.3.13). `final` (the
  // structured scope-exit join) drops the fiber now that its box is no longer needed; the returned box roots
  // itself on the joiner's stack across the caller's load. Removal is idempotent (rtSchedRegRemove).
  let res: RawPtr = target.load(fromByteOffset: 216)
  if final != 0 {
    rtSchedRegRemove(sched, target)
  }
  rtSchedUnlock(sched)
  return res
}

// Fire-and-forget send: enqueue `msg` on `mailbox` (the ABI offsets above) and return. On the 0→1
// schedule edge, append the mailbox to the global scheduled queue, bump active-drains, and dispatch a
// mailbox fiber. The C rt_actor_send shim dispatches here.
fun nomuSchedActorSend(sched: RawPtr, mailbox: RawPtr, msg: RawPtr) {
  rtSchedLock(sched)
  msg.store(RawPtr.null, toByteOffset: 8)              // msg->next = null
  let tail: RawPtr = mailbox.load(fromByteOffset: 16) // mb_tail
  if tail.isNull {
    mailbox.store(msg, toByteOffset: 8)               // mb_head = msg
  } else {
    tail.store(msg, toByteOffset: 8)                  // mb_tail->next = msg
    rtRememberStore(tail)                             // young msg stored into a maybe-mature tail message
  }
  mailbox.store(msg, toByteOffset: 16)                // mb_tail = msg
  rtRememberStore(mailbox)                            // young msg stored into mb_head/mb_tail of a maybe-mature mailbox
  let sch: Int = mailbox.load(fromByteOffset: 24)     // scheduled
  if sch == 0 {
    mailbox.store(1, toByteOffset: 24)
    mailbox.store(RawPtr.null, toByteOffset: 32)      // sched_next = null
    let stail: RawPtr = sched.load(fromByteOffset: 88)
    if stail.isNull {
      sched.store(mailbox, toByteOffset: 80)
      sched.store(mailbox, toByteOffset: 88)
    } else {
      stail.store(mailbox, toByteOffset: 32)           // stail->sched_next = mailbox
      rtRememberStore(stail)                           // maybe-young mailbox linked into a maybe-mature stail
      sched.store(mailbox, toByteOffset: 88)
    }
    sched.atomicFetchAdd(1, atByteOffset: 96)          // active-drains++
    rtSchedMailboxDispatch(sched)
  }
  rtSchedUnlock(sched)
}

// Pop the next message from `mailbox` (FIFO), or null when empty. On empty, clear scheduled and drop
// active-drains; if that reaches quiescence (no drains, no user fibers), stop. Called from codegen's
// nomu_actor_drain via the C rt_mailbox_pop shim.
fun nomuSchedMailboxPop(sched: RawPtr, mailbox: RawPtr) -> RawPtr {
  rtSchedLock(sched)
  let msg: RawPtr = mailbox.load(fromByteOffset: 8)   // mb_head
  if msg.isNull {
    mailbox.store(0, toByteOffset: 24)                // scheduled = 0 (1→0 edge)
    let r: Int = sched.atomicFetchAdd(-1, atByteOffset: 96)
    if r == 1 {
      let act: Int = sched.atomicLoad(fromByteOffset: 32)
      if act == 0 {
        rtSchedSignalStop(sched)
      }
    }
    rtSchedUnlock(sched)
    return RawPtr.null
  }
  let nx: RawPtr = msg.load(fromByteOffset: 8)        // msg->next
  mailbox.store(nx, toByteOffset: 8)                  // mb_head = next
  if nx.isNull {
    mailbox.store(RawPtr.null, toByteOffset: 16)      // mb_tail = null
  } else {
    rtRememberStore(mailbox)                          // re-linked head (maybe young) into a maybe-mature mailbox
  }
  rtSchedUnlock(sched)
  return msg
}

// Boot the scheduler: spawn the main fiber over the user entry, start ncarriers-1 carrier threads, the timer
// thread and the GC coordinator, run the scheduler loop on the calling thread too, and return once quiescent
// (all carriers exited). Called from the process entry `main`, which codegen emits.
fun nomuSchedBoot(sched: RawPtr, entryFn: RawPtr, ncarriers: Int) {
  sched.store(ncarriers, toByteOffset: 160)           // total carriers, for the STW ack count (128.3.2)
  nomuSchedSpawn(sched, entryFn, RawPtr.null)
  let handles = RawPtr.alloc(bytes: 8 * ncarriers, align: 8)
  var c = 1
  while c < ncarriers {
    let ctx = RawPtr.alloc(bytes: 168, align: 16)
    let carg = RawPtr.alloc(bytes: 24, align: 8)
    carg.store(sched, toByteOffset: 0)
    carg.store(ctx, toByteOffset: 8)
    carg.store(c, toByteOffset: 16)
    let h = handles.advanced(by: 8 * c)
    Runtime.threadCreate(handle: h, entry: Runtime.ofFunc(rtSchedCarrierMain), arg: carg)
    c = c + 1
  }
  // The timer thread (wakeup feeder): one raw thread draining the deadline heap.
  let th = RawPtr.alloc(bytes: 8, align: 8)
  Runtime.threadCreate(handle: th, entry: Runtime.ofFunc(rtSchedTimerMain), arg: sched)
  // The GC coordinator: one raw thread that runs every collection (rtGcCoordinatorMain).
  let gc = RawPtr.alloc(bytes: 8, align: 8)
  Runtime.threadCreate(handle: gc, entry: Runtime.ofFunc(rtGcCoordinatorMain), arg: sched)
  let mainCtx = RawPtr.alloc(bytes: 168, align: 16)
  rtSchedLoop(sched, mainCtx)
  var k = 1
  while k < ncarriers {
    let h = handles.advanced(by: 8 * k)
    Runtime.threadJoin(handle: h)
    k = k + 1
  }
  Runtime.threadJoin(handle: th)
  Runtime.threadJoin(handle: gc)
  rtGcRecordFinish()
}
