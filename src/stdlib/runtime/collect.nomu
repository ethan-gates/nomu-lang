// Collection: forwarding and copying, evacuation, whole-heap and minor collection, and the defrag trigger.
// Part of the `runtime` module; see README.md.

// ---- Forwarding word + copy primitive (task 150 · rung 3, increment 150.3.6) ----
// The mechanism evacuation (150.3.7) is built on. The forwarding record is §10.8 (Decided): the new address
// goes in the stale copy's payload word 0 (offset 8), and header bit 33 flags "forwarded". Header layout:
// bits 0–31 type-id, bit 32 the verifier's mark, bit 33 forwarded, bits 34–35 the collector's mark (rtTryMarkBare). `rtObjTypeId` already strips all high bits, so
// size/kind reads keep working on a marked or forwarded header. Overwriting payload word 0 is sound because
// the object is copied first (size computed before the clobber) and the stale original is only ever read for
// its forwarding pointer afterward. The payload-word-0 slot exists for every managed type — `rtCheckPayloadWord`
// guards that (§10.8): a fixed object is header + ≥1 field (≥16 bytes), an array buffer is header + cap + ….

// The object's total size in bytes from the type tables: fixed size, or 16 + cap*stride for a buffer. Must
// be read before forwarding clobbers payload word 0 (a buffer's cap lives there).
fun rtObjSize(obj: RawPtr) -> Int {
  let tid = rtObjTypeId(obj)
  let kind = rtTypeKind(tid)
  if kind == 0 {
    return rtTypeSize(tid)
  }
  let ecap: Int = obj.load(fromByteOffset: 8)
  let stride = rtTypeStride(tid)
  let elemStart = rtBufElemStart(tid)
  return elemStart + ecap * stride
}

// Copy `bytes` (a multiple of 8) word by word — the whole object including its header.
fun rtCopyWords(dst: RawPtr, src: RawPtr, bytes: Int) {
  var o = 0
  while o < bytes {
    let w: Int = src.load(fromByteOffset: o)
    dst.store(w, toByteOffset: o)
    o = o + 8
  }
}

// Header bit 33 set → the object has been evacuated; payload word 0 holds its new address.
fun rtIsForwarded(obj: RawPtr) -> Bool {
  let h: Int = obj.load(fromByteOffset: 0)
  let hi = h / 4294967296
  let bit33 = hi / 2 - hi / 4 * 2
  if bit33 == 1 {
    return true
  }
  return false
}

// The forwarding address (payload word 0) of an already-forwarded object.
fun rtForwardingPointer(obj: RawPtr) -> RawPtr {
  let p: RawPtr = obj.load(fromByteOffset: 8)
  return p
}

// Flag `obj` forwarded (set header bit 33 if not already) and store its new address in payload word 0.
fun rtSetForwarded(obj: RawPtr, newAddr: RawPtr) {
  let h: Int = obj.load(fromByteOffset: 0)
  let hi = h / 4294967296
  let bit33 = hi / 2 - hi / 4 * 2
  var nh = h
  if bit33 == 0 {
    nh = h + 8589934592
  }
  obj.store(nh, toByteOffset: 0)
  obj.store(newAddr, toByteOffset: 8)
}

// Evacuate `obj`: allocate a fresh slot, copy the object into it, install the forwarding record in the
// original, and return the new address (or null if allocation fails). Size is read before the copy so the
// forwarding clobber of payload word 0 is safe. The copy inherits the original's header (mark bit, no
// forwarded bit — that is set only on the original), which is the end state evacuation wants.
fun rtCopyObject(space: RawPtr, obj: RawPtr) -> RawPtr {
  let size = rtObjSize(obj)
  let dst = rtImmixAlloc(space, size)
  let dstNull = dst.eq(RawPtr.null)
  if dstNull {
    return RawPtr.null
  }
  rtCopyWords(dst, obj, size)
  rtSetForwarded(obj, dst)
  return dst
}

// Count managed types with no payload word (fixed size < 16) — the forwarding record needs payload word 0
// (§10.8). 0 confirms the payload-word-0 forwarding scheme is valid for every managed type in the program.
fun rtCheckPayloadWord() -> Int {
  let tcount = Runtime.gcTypeCount()
  var bad = 0
  var t = 0
  while t < tcount {
    // gcTypeCount() is the descriptor count; a type-id is a descriptor byte offset (task 100.4.7),
    // so ordinal `t` maps to offset `t * record-size` for the accessor reads (task 180: record size from
    // the runtime, one source of truth).
    let off = t * rtDescSize
    let kind = rtTypeKind(off)
    if kind == 0 {
      let sz = rtTypeSize(off)
      if sz < 16 {
        bad = bad + 1
      }
    }
    t = t + 1
  }
  return bad
}

// ---- Evacuation + pointer fixup — the moving collector (task 150 · rung 3, 150.3.7 / 150.3.8) ----
// Forward-during-trace (selfhosted-gc.md §10.6/§10.7): as the tracer visits the graph it copies each
// reachable object in a source block into fresh to-space (rtCopyObject, installing the forwarding record of
// §10.8) and rewrites the slot it came through — and the root — to the survivor's new address. One store
// added to the slot walk 150.2 already built. A block is an evacuation source iff its state byte is 3
// (DEFRAG_SOURCE); everything else is marked in place. The two callers differ only in how they set that
// flag: rtImmixEvacCollect (150.3.7) marks every used block a source (force-all); rtImmixCollectDefrag
// (150.3.8) selects only fragmented blocks within a copy-reserve budget. Runs under the runtime subset's
// noSafepoint (149), which is what makes holding raw pointers into the moving heap across the copy sound —
// it closes 125 §3.3's deferred moving-heap gate.

// The post-evacuation address of `obj`. A candidate (in the Immix heap, in a DEFRAG_SOURCE block, not yet
// forwarded) is copied into to-space and its forwarding record installed; an already-forwarded object yields
// its forwarding pointer; a non-candidate (LOS/off-heap, or in a non-source block) is returned unchanged and
// marked in place by the caller.
fun rtEvacuate(space: RawPtr, obj: RawPtr) -> RawPtr {
  // Range-check before any dereference (150.4.5.1 hardening): an off-heap value — a real LOS/immortal object,
  // or a stale/wild word — is returned unchanged without reading its header. LOS objects never move; a wild
  // word must not fault the collector or be misread as a forwarding record.
  let base: Int = space.load(fromByteOffset: 40)
  let nb: Int = space.load(fromByteOffset: 8)
  let heapEnd = base + nb * 32768
  let a = obj.toInt()
  if a < base {
    return obj                       // off-heap (LOS): never moves
  }
  if a >= heapEnd {
    return obj
  }
  if rtIsForwarded(obj) {
    return rtForwardingPointer(obj)
  }
  let d = a - base
  let bi = d / 32768
  if rtBlockState(space, bi) != 3 {
    return obj                       // non-source (marked in place) or a to-space copy — do not move
  }
  let copy = rtCopyObject(space, obj)
  return copy
}

// Forward-during-trace from `root`: evacuate the root and every reachable source-block object into to-space,
// rewriting each managed slot (and the root itself) to the survivor's address as the trace visits it, and
// line-marking each survivor at its final location so the following sweep reclaims the emptied source blocks
// and keeps the marked-in-place survivors. Returns the root's post-evacuation address. Shared children and
// cycles resolve through the forwarded-bit guard in rtEvacuate and the mark-bit guard here, so every object
// is copied and scanned exactly once.
fun rtImmixEvacMark(space: RawPtr, root: RawPtr) -> RawPtr {
  let rootNull = rtNotObject(root)
  if rootNull {
    return root
  }
  var work = rtGcWorkTake()         // grows on demand (rtStackGrow)
  var wcap = rtGcWorkCap()
  var top = 0
  // Generational: each in-heap survivor is mature after this major, so it is set unlogged here, at its final
  // address (the major wiped the table first). Large and immortal objects have no log bit.
  let unlog = rtGenReserve(space) > 0
  let heapLo: Int = space.load(fromByteOffset: 40)
  let nblocks: Int = space.load(fromByteOffset: 8)
  let heapHi = heapLo + nblocks * 32768
  let newRoot = rtEvacuate(space, root)
  if rtTryMarkBare(newRoot) {
    work.store(newRoot, toByteOffset: 0)
    top = 1
  }
  while top > 0 {
    top = top - 1
    let obj: RawPtr = work.load(fromByteOffset: top * 8)
    let tid = rtObjTypeId(obj)
    let kind = rtTypeKind(tid)
    var nptr = 0
    if kind == 0 {
      nptr = rtOffsetsList(tid, obj)            // each enum field decoded once
    } else {
      nptr = rtLiveCount(tid, obj)
    }
    var size = 0
    if kind == 0 {
      size = rtTypeSize(tid)
    } else {
      let ecap: Int = obj.load(fromByteOffset: 8)
      let stride = rtTypeStride(tid)
      let elemStart = rtBufElemStart(tid)
      size = elemStart + ecap * stride
    }
    rtMarkObjLines(space, obj, size)
    if unlog {
      let a = obj.toInt()
      if a >= heapLo && a < heapHi {
        rtSetUnlogged(space, obj)
      }
    }
    if kind == 0 {
      let offs: RawPtr = rtOffs.load(fromByteOffset: 0)
      var i = 0
      while i < nptr {
        let off = Runtime.loadInt32(offs, at: i * 4)
        let childWord: RawPtr = obj.load(fromByteOffset: off)
        let childTag = rtRefTag(childWord)
        let child = childWord.advanced(by: 0 - childTag)
        let childNull = rtNotObject(child)
        if !childNull {
          let nc = rtEvacuate(space, child)
          obj.store(nc.advanced(by: childTag), toByteOffset: off)
          if rtTryMarkBare(nc) {
            if top == wcap {
              work = rtStackGrow(work, top)
              wcap = wcap + wcap
            }
            work.store(nc, toByteOffset: top * 8)
            top = top + 1
          }
        }
        i = i + 1
      }
    } else {
      let ecap2: Int = obj.load(fromByteOffset: 8)
      let stride2 = rtTypeStride(tid)
      let elemStart = rtBufElemStart(tid)
      var hk = 0
      let nhdr = rtHeaderPtrCount(tid)      // header managed pointers (task 180): evacuate + write back
      while hk < nhdr {
        let hat = 16 + rtHeaderOffsetAt(tid, hk)
        let hchildWord: RawPtr = obj.load(fromByteOffset: hat)
        let hchildTag = rtRefTag(hchildWord)
        let hchild = hchildWord.advanced(by: 0 - hchildTag)
        if !rtNotObject(hchild) {
          let hnc = rtEvacuate(space, hchild)
          obj.store(hnc.advanced(by: hchildTag), toByteOffset: hat)
          if rtTryMarkBare(hnc) {
            if top == wcap {
              work = rtStackGrow(work, top)
              wcap = wcap + wcap
            }
            work.store(hnc, toByteOffset: top * 8)
            top = top + 1
          }
        }
        hk = hk + 1
      }
      var e = 0
      let elemShaped = rtShapedCount(tid) > 0   // per-element live words (shaped elements)
      while e < ecap2 {
        let elemBase = elemStart + e * stride2
        let elemPtr = obj.advanced(by: elemBase)
        var en = nptr
        if elemShaped {
          en = rtLiveCount(tid, elemPtr)
        }
        var i = 0
        while i < en {
          let off = rtLiveOffsetAt(tid, elemPtr, i)
          let at = elemBase + off
          let childWord: RawPtr = obj.load(fromByteOffset: at)
          let childTag = rtRefTag(childWord)
          let child = childWord.advanced(by: 0 - childTag)
          let childNull = rtNotObject(child)
          if !childNull {
            let nc = rtEvacuate(space, child)
            obj.store(nc.advanced(by: childTag), toByteOffset: at)
            if rtTryMarkBare(nc) {
              if top == wcap {
                work = rtStackGrow(work, top)
                wcap = wcap + wcap
              }
              work.store(nc, toByteOffset: top * 8)
              top = top + 1
            }
          }
          i = i + 1
        }
        e = e + 1
      }
    }
  }
  rtGcWorkKeep(work, wcap)
  return newRoot
}

// Point the copy allocator at fresh to-space only for the evacuation trace: reset the bump cursor and skip
// the recyclable scan past every used block, so copies draw from reclaimed-free and never-used blocks (both
// FREE, never a source or a marked-in-place block). Shared setup for both evacuating collectors.
fun rtSetupCopyAllocator(space: RawPtr) {
  let fc: Int = space.load(fromByteOffset: 32)
  space.store(fc, toByteOffset: 104)        // recyclable scan past every used block
  rtCopyWorkersReset(space)                 // no current block → the first copy draws a fresh/free block
}

// Reset the mutator's allocator after a collection: no current block, rescan recyclable from the start so
// reclaimed + recyclable space is reused by the next allocation.
fun rtResetAllocator(space: RawPtr) {
  rtCopyWorkersReset(space)
  space.store(0, toByteOffset: 104)
}

// One force-all evacuating collection from `root` (150.3.7): mark every used block a source, so every live
// object moves to fresh to-space; fix up all slots and the root; reclaim the emptied from-space by the
// 150.3.5 sweep. Returns the root's new address (the root moves — the caller adopts it). The general
// collector (rtImmixCollectDefrag, 150.3.8) selects sources by fragmentation; this is its evacuate-everything
// special case, kept as a maximal-move stress path.
fun rtImmixEvacCollect(space: RawPtr, root: RawPtr) -> RawPtr {
  rtAdvanceMark()
  rtClearAllLines(space)
  let fc: Int = space.load(fromByteOffset: 32)
  var bi = 0
  while bi < fc {
    rtSetBlockState(space, bi, 3)           // every used block is a source
    bi = bi + 1
  }
  space.store(0, toByteOffset: 96)          // free list empty — to-space is fresh (never-used) only
  rtSetupCopyAllocator(space)
  let newRoot = rtImmixEvacMark(space, root)
  rtImmixSweepBlocks(space)
  rtImmixSweepLos(space)
  rtResetAllocator(space)
  rtGcWorkRelease()
  return newRoot
}

// ---- Collection over a multi-mutator root-slot set (driven at a scheduler STW) ----
// The defrag variant over a root-slot set — the general collector generalised to many mutators. Sources
// are chosen by fragmentation within the copy reserve (rtSelectDefragSources), so it never runs out of
// to-space and is non-moving when the heap is near-full, so it runs under heap pressure. Only source-block
// roots move; their slots are fixed up.
fun rtImmixCollectRootsDefrag(space: RawPtr, slotBuf: RawPtr, nslots: Int) -> Int {
  rtAdvanceMark()
  var tp = rtGcPhaseOpen(10)
  let nSources = rtSelectDefragSources(space)
  rtGcPhaseClose(10, tp)
  rtGcCounter(4, nSources)
  tp = rtGcPhaseOpen(11)
  rtClearAllLines(space)
  rtSetupCopyAllocator(space)
  rtGcPhaseClose(11, tp)
  tp = rtGcPhaseOpen(12)
  var i = 0
  while i < nslots {
    let slot: RawPtr = slotBuf.load(fromByteOffset: i * 8)
    let oldWord: RawPtr = slot.load(fromByteOffset: 0)
    let oldTag = rtRefTag(oldWord)
    let old = oldWord.advanced(by: 0 - oldTag)
    let oldNull = rtNotObject(old)
    if !oldNull {
      let new = rtImmixEvacMark(space, old)
      slot.store(new.advanced(by: oldTag), toByteOffset: 0)
    }
    i = i + 1
  }
  rtGcPhaseClose(12, tp)
  tp = rtGcPhaseOpen(13)
  rtImmixSweepBlocks(space)
  rtGcPhaseClose(13, tp)
  tp = rtGcPhaseOpen(14)
  rtImmixSweepLos(space)
  rtGcPhaseClose(14, tp)
  rtResetAllocator(space)
  rtGcWorkRelease()
  return nSources
}

// The generational major (150.4.4, §11.4): rtImmixCollectRootsDefrag plus a post-collection pass that
// re-establishes the log-bit invariant. A major escalated from a nursery-full trigger (mature pressure or a
// promotion that would fail) collects the whole heap — nursery blocks participate as ordinary blocks, so
// rtImmixSweepBlocks resets their state and nurseryUsed@136. After it, every live object is mature and the
// nursery is empty. The log-bit table would hold stale unlogged bits at the old (now freed) addresses of
// moved survivors, which future young objects would inherit and wrongly trip the barrier — the minor treats
// a remembered object as mature and non-moving, so a young object in the remembered set corrupts the next
// minor. So the table is wiped to logged before the trace, and the trace sets each survivor unlogged at its
// final address (rtImmixEvacMark), so freed regions read logged and only mature survivors trip the barrier. A missing unlog on a survivor would silently drop a mature→young pointer in the
// next minor; a stale unlog on a freed region would falsely remember a young object. Only the driver differs
// from the non-generational defrag — this path runs solely under NOMU_NURSERY_RESERVE (the minor is enabled).
fun rtImmixCollectRootsDefragGen(space: RawPtr, slotBuf: RawPtr, nslots: Int) -> Int {
  rtAdvanceMark()
  var tp = rtGcPhaseOpen(10)
  let nSources = rtSelectDefragSources(space)
  rtGcPhaseClose(10, tp)
  rtGcCounter(4, nSources)
  tp = rtGcPhaseOpen(11)
  rtClearAllLines(space)
  rtSetupCopyAllocator(space)
  rtGcPhaseClose(11, tp)
  tp = rtGcPhaseOpen(15)
  rtClearLogTable(space)                       // freed regions read logged; the trace sets survivors unlogged
  rtGcPhaseClose(15, tp)
  tp = rtGcPhaseOpen(12)
  var i = 0
  while i < nslots {
    let slot: RawPtr = slotBuf.load(fromByteOffset: i * 8)
    let oldWord: RawPtr = slot.load(fromByteOffset: 0)
    let oldTag = rtRefTag(oldWord)
    let old = oldWord.advanced(by: 0 - oldTag)
    let oldNull = rtNotObject(old)
    if !oldNull {
      let new = rtImmixEvacMark(space, old)
      slot.store(new.advanced(by: oldTag), toByteOffset: 0)
    }
    i = i + 1
  }
  rtGcPhaseClose(12, tp)
  tp = rtGcPhaseOpen(13)
  rtImmixSweepBlocks(space)
  rtGcPhaseClose(13, tp)
  tp = rtGcPhaseOpen(14)
  rtImmixSweepLos(space)
  rtGcPhaseClose(14, tp)
  rtResetAllocator(space)
  rtGcWorkRelease()
  return nSources
}

// ---- Minor collection — the generational young-space collector (task 150 · 150.4.3, §11.4) ----
// A minor GC evacuates only the nursery (from-space = the NURSERY blocks) into mature Immix, promoting every
// survivor (promote-all, Appel-style). Its root set is the stack roots plus the drained remembered set (the
// per-carrier mod-buffers the write barrier filled) — the mature space is never scanned, which is the whole
// point of the barrier: mature→young pointers are reached through the remembered set, not a mature-heap walk.
// The mature space is not swept. A NURSERY block is turned into a DEFRAG_SOURCE (state 3) so rtMinorClaim
// copies its objects, and the copy allocator draws fresh mature (non-nursery) blocks, so every survivor is
// promoted. Emptied nursery blocks are reclaimed whole. The trace is depth-first over a work stack, the shape
// the parallel minor shares between workers (selfhosted-gc.md §11.7).

// The minor's forwarding states in a nursery object's header, over bit 33 (forwarded) and the collector's mark
// (bits 34–35). A worker claims the object by a CAS to busy (bit 33 with mark value 3, a value the mark never
// takes), copies it, writes the copy's address into payload word 0, then stores forwarded (bit 33, mark 0)
// atomically, so a worker that reads forwarded also reads the address and the copy (selfhosted-gc.md §11.7).
let rtFwdBit = 8589934592                      // 2^33
let rtMarkBits = 51539607552                   // bits 34–35

// The survivor of `obj` for a minor. A nursery object is claimed and copied, or, when another call claimed it,
// its copy is read once published; anything else (mature, off-heap) comes back unchanged. The result is the
// survivor's address plus 1 when this call made the copy, so the caller alone pushes it for scanning. The copy
// goes into worker `w`'s blocks.
fun rtMinorClaim(space: RawPtr, w: RawPtr, obj: RawPtr) -> RawPtr {
  let base: Int = space.load(fromByteOffset: 40)
  let nb: Int = space.load(fromByteOffset: 8)
  let a = obj.toInt()
  if a < base {
    return obj                       // off-heap (LOS): never moves
  }
  if a >= base + nb * 32768 {
    return obj
  }
  if rtBlockState(space, (a - base) / 32768) != 3 {
    return obj                       // mature, or a copy made this minor
  }
  var result = obj
  var trying = true
  while trying {
    let h: Int = obj.atomicLoad(fromByteOffset: 0)
    if (h & rtFwdBit) == 0 {
      let clean = h - (h & rtMarkBits)
      let got: Int = obj.atomicCas(h, clean + rtFwdBit + rtMarkBits, atByteOffset: 0)
      if got == h {
        let size = rtObjSize(obj)                  // a buffer's cap is payload word 0: read before the clobber
        let dst = rtImmixAllocOn(space, w, size)
        if dst.isNull {
          Runtime.fatal("nomu: a minor collection found no room to promote into")
        }
        rtCopyWords(dst, obj, size)
        dst.store(clean + rtMarkValue() * rtMarkUnit, toByteOffset: 0)   // marked this cycle, not forwarded
        obj.store(dst, toByteOffset: 8)
        obj.atomicStore(clean + rtFwdBit, toByteOffset: 0)                // publish: forwarded, word 0 set
        // The copy is mature: its lines are taken until the next major, and it is unlogged, so a store of a
        // young object into it is remembered. Both lie in w's own block, so no other worker writes them, and no
        // worker reads them during the trace, so they follow the publish. The copy is in the heap, so its lines
        // are marked with no range check (rtMarkObjLines has one). Most objects span one or two lines, marked
        // by two stores; a loop over every line compiles to a memset call per object.
        let lines: RawPtr = space.load(fromByteOffset: 16)
        let off = dst.toInt() - base
        let first = off >> 8
        let last = (off + size - 1) >> 8
        lines.store(1.uint8, toByteOffset: first)
        lines.store(1.uint8, toByteOffset: last)
        var li = first + 1
        while li < last {
          lines.store(1.uint8, toByteOffset: li)
          li = li + 1
        }
        rtSetUnlogged(space, dst)
        result = dst.advanced(by: 1)
        trying = false
      }
    } else if (h & rtMarkBits) != rtMarkBits {
      result = obj.load(fromByteOffset: 8)        // forwarded
      trying = false
    }
    // busy: another worker is copying it; read the header again
  }
  return result
}

// Forward one managed slot at `fieldAddr` for a minor GC: claim the referent (copies it to mature iff it is in
// the nursery), rewrite the slot in place, and push a copy this call made onto worker `w`'s work stack (`count`
// entries). Returns the updated count. A mature/off-heap referent is unchanged and not pushed — a minor GC
// never scans the mature space.
fun rtMinorForward(space: RawPtr, w: RawPtr, fieldAddr: RawPtr, count: Int) -> Int {
  let oldWord: RawPtr = fieldAddr.load(fromByteOffset: 0)
  let oldTag = rtRefTag(oldWord)
  let old = oldWord.advanced(by: 0 - oldTag)
  let oldNull = rtNotObject(old)
  if oldNull {
    return count
  }
  let got = rtMinorClaim(space, w, old)
  let won = got.toInt() & 1
  let new = got.advanced(by: 0 - won)
  let moved = !new.eq(old)
  if moved {
    fieldAddr.store(new.advanced(by: oldTag), toByteOffset: 0)      // fix the slot to the survivor's mature address
    if won == 1 {
      rtQueuePush(w.advanced(by: 32), count, new)   // copied here → push for scanning (grows if full)
      return count + 1
    }
  }
  return count
}

// Double a full collector work stack: copy its `count` entries into a buffer twice the size, free the old
// one, and return the new. The mark and unmark passes keep the stack and its capacity in locals and call this
// only when a push finds it full. Raw memory, off the managed heap, so growth under stop-the-world never
// re-enters collection.
fun rtStackGrow(stack: RawPtr, count: Int) -> RawPtr {
  let fresh = RawPtr.alloc(bytes: count * 16, align: 8)
  fresh.copyBytes(from: stack, byteCount: count * 8)
  stack.free()
  return fresh
}

// The collector's work stack, shared by the mark, evacuate and unmark walks: {base @0, capacity @8 in
// entries}, empty (null) between collections. A collection walks once per root slot, and a stack allocated
// and zeroed per walk cost a major 1.6 µs a parked fiber; taken from here, it is allocated once per
// collection and keeps any growth from earlier walks. Walks run one at a time under stop-the-world (or in
// a single-threaded test), so one stack serves the whole runtime.
let rtGcWork = Runtime.staticStorage(bytes: 16, align: 8)

// The work stack's base, allocated at 4096 entries if none is held; its capacity is rtGcWorkCap().
fun rtGcWorkTake() -> RawPtr {
  let base: RawPtr = rtGcWork.load(fromByteOffset: 0)
  if base.eq(RawPtr.null) {
    let fresh = RawPtr.alloc(bytes: 4096 * 8, align: 8)
    rtGcWork.store(fresh, toByteOffset: 0)
    rtGcWork.store(4096, toByteOffset: 8)
    return fresh
  }
  return base
}

fun rtGcWorkCap() -> Int {
  let cap: Int = rtGcWork.load(fromByteOffset: 8)
  return cap
}

// Hand the work stack back after a walk, with the base and capacity any growth left it.
fun rtGcWorkKeep(base: RawPtr, cap: Int) {
  rtGcWork.store(base, toByteOffset: 0)
  rtGcWork.store(cap, toByteOffset: 8)
}

// Free the work stack at the end of a collection, so a stack grown by a deep trace is not held between
// collections.
fun rtGcWorkRelease() {
  let base: RawPtr = rtGcWork.load(fromByteOffset: 0)
  if !base.eq(RawPtr.null) {
    base.free()
  }
  rtGcWork.store(RawPtr.null, toByteOffset: 0)
  rtGcWork.store(0, toByteOffset: 8)
}

// A growable dynamic array behind a stable 2-word handle {base @0, cap @8}, for the minor's work stack and the
// root lists: their sizes are bounded only by the live objects and roots, so a fixed array can overflow. Region/block collectors (Immix, G1,
// MMTk) use growable work stacks for the same reason. `q` is passed by value into the scan helpers, so growth
// must not move the value the callers hold — the handle stays put; only the buffer it points at is realloc'd.
// The buffer is malloc-backed (`RawPtr.alloc`), off the GC heap, so growth during the STW never re-enters
// collection. Doubling keeps the amortized cost O(1) and grows rare (starts at 64Ki entries).
fun rtQueuePush(q: RawPtr, count: Int, obj: RawPtr) {
  var base: RawPtr = q.load(fromByteOffset: 0)
  let cap: Int = q.load(fromByteOffset: 8)
  if count >= cap {
    let newCap = cap + cap
    let newBase = RawPtr.alloc(bytes: newCap * 8, align: 8)
    newBase.copyBytes(from: base, byteCount: count * 8)
    base.free()
    q.store(newBase, toByteOffset: 0)
    q.store(newCap, toByteOffset: 8)
    base = newBase
  }
  base.store(obj, toByteOffset: count * 8)
}

// rtQueuePush for a word that is a number, such as the derived-pointer list's offsets.
fun rtQueuePushInt(q: RawPtr, count: Int, w: Int) {
  rtQueuePush(q, count, RawPtr.null)
  let base: RawPtr = q.load(fromByteOffset: 0)
  base.store(w, toByteOffset: count * 8)
}

// Scan one object's managed slots for a minor GC, forwarding each young referent (rtMinorForward). Used for
// the remembered mature objects (find their young children) and, via the work stack, for the promoted
// objects (a promoted object may still point at other nursery objects). Returns the work stack's new count.
fun rtMinorScanObj(space: RawPtr, w: RawPtr, obj: RawPtr, count0: Int) -> Int {
  var count = count0
  let tid = rtObjTypeId(obj)
  let kind = rtTypeKind(tid)
  var nptr = 0
  if kind == 0 {
    nptr = rtOffsetsListIn(w.advanced(by: 64), tid, obj)   // each enum field decoded once, in w's own list
  } else {
    nptr = rtLiveCount(tid, obj)
  }
  if kind == 0 {
    let offs: RawPtr = w.load(fromByteOffset: 64)
    var i = 0
    while i < nptr {
      let off = Runtime.loadInt32(offs, at: i * 4)
      count = rtMinorForward(space, w, obj.advanced(by: off), count)
      i = i + 1
    }
  } else {
    let ecap: Int = obj.load(fromByteOffset: 8)
    let stride = rtTypeStride(tid)
    let elemStart = rtBufElemStart(tid)
    var hk = 0
    let nhdr = rtHeaderPtrCount(tid)        // header managed pointers (task 180)
    while hk < nhdr {
      count = rtMinorForward(space, w, obj.advanced(by: 16 + rtHeaderOffsetAt(tid, hk)), count)
      hk = hk + 1
    }
    var e = 0
    let elemShaped = rtShapedCount(tid) > 0   // per-element live words (shaped elements)
    while e < ecap {
      let elemBase = elemStart + e * stride
      let elemPtr = obj.advanced(by: elemBase)
      var en = nptr
      if elemShaped {
        en = rtLiveCount(tid, elemPtr)
      }
      var i = 0
      while i < en {
        let off = rtLiveOffsetAt(tid, elemPtr, i)
        count = rtMinorForward(space, w, obj.advanced(by: elemBase + off), count)
        i = i + 1
      }
      e = e + 1
    }
  }
  return count
}

// One minor collection (§11.4). `slotBuf`/`nslots` are the stopped mutators' stack root SLOTS (fixed up in
// place); `remBuf`/`nrem` are the drained remembered set (mature objects the barrier logged). Promote every
// live nursery object into mature Immix, rewrite each slot to its survivor, reclaim the emptied nursery blocks,
// and re-establish the log bits (promoted + remembered objects are unlogged so their next mutation is caught).
// The mature space is neither scanned nor swept. Returns the number of objects promoted.
// The trace starts on the coordinator alone; once it has handled rtGcParallelMin objects and roots with work
// left, it recruits the carriers parked at this stop (rtMinorHelp), up to rtGcThreads workers in all
// (selfhosted-gc.md §11.7).
// Promotions fill the holes of the recyclable blocks the last major left, then clean blocks. Each worker's
// copy cursor keeps its place from one minor to the next and only a major resets it (rtResetAllocator), so each
// hole and the tail of each partly filled block is taken once per major cycle, as Immix's allocator does.
// Each promoted object's lines are marked, so the rule the heap verifier checks holds between majors: a
// reachable object in a recyclable block lies on marked lines, which no allocator hands out.
fun rtImmixCollectMinor(sched: RawPtr, space: RawPtr, slotBuf: RawPtr, nslots: Int, remBuf: RawPtr, nrem: Int) -> Int {
  // From-space = the NURSERY blocks; turn each into a DEFRAG_SOURCE so rtMinorClaim copies its objects.
  let fc: Int = space.load(fromByteOffset: 32)
  var bi = 0
  while bi < fc {
    if rtBlockState(space, bi) == 4 {
      rtSetBlockState(space, bi, 3)
    }
    bi = bi + 1
  }
  // Each remembered object is unlogged here, before the trace, so a store into it next cycle is remembered
  // again. Serial: mature neighbours share a log byte, which two workers would rewrite at once.
  var r = 0
  while r < nrem {
    let robj: RawPtr = remBuf.load(fromByteOffset: r * 8)
    if !robj.isNull {
      rtSetUnlogged(space, robj)
    }
    r = r + 1
  }
  // Open the job. Helpers may join only past the threshold, and while the coordinator's trace is open.
  let job = rtMinorJob
  job.store(space, toByteOffset: 0)
  job.store(slotBuf, toByteOffset: 8)
  job.store(nslots, toByteOffset: 16)
  job.store(remBuf, toByteOffset: 24)
  job.store(nrem, toByteOffset: 32)
  job.store(0, toByteOffset: 40)                 // helpers allowed to join: none until the recruit sizes the team
  job.store(sched, toByteOffset: 56)
  job.store(0, toByteOffset: 72)                 // blocks the copy cursors take in this minor (rtNextHole)
  job.atomicStore(0, toByteOffset: 128)          // the next stack slot to claim
  job.atomicStore(0, toByteOffset: 136)          // the next remembered object to claim
  job.atomicStore(0, toByteOffset: 144)          // the large-object list, unclaimed
  job.atomicStore(0, toByteOffset: 256)          // the pool's lock
  job.store(RawPtr.null, toByteOffset: 264)      // the pool's chunks
  job.atomicStore(0, toByteOffset: 640)          // the pool's chunk count
  job.atomicStore(0, toByteOffset: 384)          // idle workers
  job.atomicStore(0, toByteOffset: 392)          // idle workers asleep
  job.atomicStore(1, toByteOffset: 512)          // joined workers: the coordinator
  job.atomicStore(0, toByteOffset: 520)          // helpers that have left
  job.atomicStore(0, toByteOffset: 576)          // chunks shared, when recording
  job.atomicStore(0, toByteOffset: 584)          // idle sleeps, when recording
  job.atomicStore(0, toByteOffset: 48)          // closed until the coordinator recruits (rtMinorRecruit)
  rtMinorWork(space, job, rtCopyWorker(space, 0), true)
  // The trace is done. Close the job and wait for every helper to leave it before anything else changes. The
  // blocks this minor's copies took size the next minor's team (rtMinorRecruit).
  job.atomicStore(0, toByteOffset: 48)
  let took: Int = job.load(fromByteOffset: 72)
  job.store(took, toByteOffset: 64)
  let jw: Int = job.atomicLoad(fromByteOffset: 512)
  let joined = jw % rtMinorDone
  var left: Int = job.atomicLoad(fromByteOffset: 520)
  while left < joined - 1 {
    Runtime.futexWait(at: job.advanced(by: 520), expected: left, timeoutMicros: 100)
    left = job.atomicLoad(fromByteOffset: 520)
  }
  var promoted = 0
  var promotedBytes = 0
  var wi = 0
  while wi < joined {
    let rec = rtCopyWorker(space, wi)
    let np: Int = rec.load(fromByteOffset: 48)
    let nbytes: Int = rec.load(fromByteOffset: 56)
    promoted = promoted + np
    promotedBytes = promotedBytes + nbytes
    wi = wi + 1
  }
  rtGcCounter(5, promotedBytes)
  rtGcCounter(6, joined)
  if Runtime.gcRecordLevel() > 0 {
    let shared: Int = job.atomicLoad(fromByteOffset: 576)
    let slept: Int = job.atomicLoad(fromByteOffset: 584)
    rtGcCounter(7, shared)
    rtGcCounter(8, slept)
  }
  // Reclaim the emptied nursery blocks (every live object promoted out) onto the free list; mature blocks are
  // left untouched (not swept).
  let tp = rtGcPhaseOpen(9)
  let fl: RawPtr = space.load(fromByteOffset: 88)
  var bj = 0
  while bj < fc {
    if rtBlockState(space, bj) == 3 {
      rtSetBlockState(space, bj, 0)
      let top: Int = space.load(fromByteOffset: 96)
      fl.store(bj, toByteOffset: top * 8)
      space.store(top + 1, toByteOffset: 96)
    }
    bj = bj + 1
  }
  space.store(0, toByteOffset: 136)              // the nursery is empty again
  rtGcPhaseClose(9, tp)
  return promoted
}

// ---- The parallel minor's job (selfhosted-gc.md §11.7) ----
// One job, open while a minor traces; the words several workers write sit on their own 128-byte lines:
//   0 space · 8 stack slots · 16 their count · 24 remembered set · 32 its count · 40 helpers allowed to join
//   48 open: 1 while helpers may join · 56 the scheduler, whose stw-gen futex the parked carriers wait on
//   64 the blocks the last minor's copies took · 72 those this minor's have taken so far (under rtCopyLock)
//   128 the next stack slot to claim · 136 the next remembered object · 144 the large-object list, 1 once claimed
//   256 the pool's lock · 264 its chunks (a list), both touched only under the lock
//   384 idle workers · 392 those asleep on the chunk count
//   512 joined workers, the coordinator included, plus rtMinorDone once the trace is done · 520 helpers that left
//   576 chunks shared · 584 idle sleeps (both counted when the collector records)
//   640 the pool's chunk count, which idle workers poll and sleep on, on a line apart from the lock's
// A chunk is {next @0, count @8, entries @16}, rtMinorChunk entries, malloc-backed.
let rtMinorJob = Runtime.staticStorage(bytes: 768, align: 128)
let rtMinorDone = 1099511627776                  // 2^40
let rtMinorChunk = 256
let rtMinorClaimRange = 64                       // root entries a worker claims at a time
let rtMinorSpins = 64                            // idle checks before a worker sleeps on the chunk count
// The blocks of copies per helper a minor's team is sized by (rtMinorRecruit): 2 MiB. Measured against 8, 16, 32
// blocks and every carrier, on binary-trees and the enum tree at 4 and 8 carriers: the same wall time or
// better, and the least CPU.
let rtMinorBlocksPerHelper = 64

// A parked carrier's turn at an open minor: join it if there is room, trace until the trace is done, then
// leave. Returns at once when no minor is open. Called from rtSchedStwParkCarrier on the carrier's own stack.
fun rtMinorHelp() {
  let job = rtMinorJob
  let open: Int = job.atomicLoad(fromByteOffset: 48)
  if open == 0 {
    return
  }
  let most: Int = job.load(fromByteOffset: 40)
  var idx = -1
  var trying = true
  while trying {
    let jw: Int = job.atomicLoad(fromByteOffset: 512)
    if jw >= rtMinorDone || jw > most {
      trying = false                             // done, or full: the coordinator and `most` helpers
    } else {
      let got: Int = job.atomicCas(jw, jw + 1, atByteOffset: 512)
      if got == jw {
        idx = jw
        trying = false
      }
    }
  }
  if idx < 0 {
    return
  }
  let space: RawPtr = job.load(fromByteOffset: 0)
  rtMinorWork(space, job, rtCopyWorker(space, idx), false)
  job.atomicFetchAdd(1, atByteOffset: 520)
  Runtime.futexWake(at: job.advanced(by: 520), all: true)
}

// Open the job to a team of helpers and wake them, from the carriers parked at this stop (rtMinorHelp). The
// team is one helper for every rtMinorBlocksPerHelper blocks the last minor's copies took, at least one, at most
// rtGcThreads − 1: past what a minor's work can spread over, more helpers spin and contend (HotSpot sizes its
// GC threads by heap size the same way). A minor larger than the last gets a small team once. With
// rtGcParallelMin 0, a stress setting, the team is every helper.
fun rtMinorRecruit(job: RawPtr) {
  let last: Int = job.load(fromByteOffset: 64)
  var n = last / rtMinorBlocksPerHelper
  if n < 1 {
    n = 1
  }
  if n > rtGcThreads - 1 || rtGcParallelMin == 0 {
    n = rtGcThreads - 1                          // the stress setting takes every helper, for the most races
  }
  job.store(n, toByteOffset: 40)
  job.atomicStore(1, toByteOffset: 48)
  let sched: RawPtr = job.load(fromByteOffset: 56)
  let gw = sched.advanced(by: 152)
  if n == rtGcThreads - 1 {
    Runtime.futexWake(at: gw, all: true)
  } else {
    var k = 0
    while k < n {
      Runtime.futexWake(at: gw, all: false)
      k = k + 1
    }
  }
}

// One worker's part of a minor, on worker record `w`: claim ranges of the roots, then trace depth-first from
// its own stack, sharing work through the pool, until every joined worker is idle with the pool empty. The
// coordinator (`coord`) records the phases, and recruits the helpers (rtMinorRecruit) once it has handled
// rtGcParallelMin objects and roots with work to spare: a small minor ends sooner than a helper could wake. When
// the collector records, the worker leaves the objects it scanned and their bytes in its record: each promoted
// object is pushed once and popped once, so the workers' sums are the minor's promotion.
fun rtMinorWork(space: RawPtr, job: RawPtr, w: RawPtr, coord: Bool) {
  rtCopyStackTake(w)
  // The coordinator's roots and objects left before it recruits; -1 once it has, for a helper, or with no
  // helpers to recruit.
  var recruit = -1
  if coord && rtGcThreads > 1 {
    recruit = rtGcParallelMin
    if recruit <= 0 {
      rtMinorRecruit(job)
      recruit = -1
    }
  }
  var count = 0
  // Root source 1 — stack slots. A young root is promoted + its slot fixed up; a mature root is left alone.
  var tp = 0
  if coord {
    tp = rtGcPhaseOpen(4)
  }
  let slotBuf: RawPtr = job.load(fromByteOffset: 8)
  let nslots: Int = job.load(fromByteOffset: 16)
  var claiming = true
  while claiming {
    let i: Int = job.atomicFetchAdd(rtMinorClaimRange, atByteOffset: 128)
    if i >= nslots {
      claiming = false
    } else {
      var end = i + rtMinorClaimRange
      if end > nslots {
        end = nslots
      }
      var s = i
      while s < end {
        let slot: RawPtr = slotBuf.load(fromByteOffset: s * 8)
        count = rtMinorForward(space, w, slot, count)
        s = s + 1
      }
      if recruit > 0 {
        recruit = recruit - (end - i)
        if recruit <= 0 {
          recruit = 0                            // recruited at the trace's first check with work to spare
        }
      }
    }
  }
  // Root source 2 — the remembered set: scan each logged mature object's slots for young referents (unlogged
  // before the trace, rtImmixCollectMinor).
  if coord {
    rtGcPhaseClose(4, tp)
    tp = rtGcPhaseOpen(5)
  }
  let remBuf: RawPtr = job.load(fromByteOffset: 24)
  let nrem: Int = job.load(fromByteOffset: 32)
  claiming = true
  while claiming {
    let i: Int = job.atomicFetchAdd(rtMinorClaimRange, atByteOffset: 136)
    if i >= nrem {
      claiming = false
    } else {
      var end = i + rtMinorClaimRange
      if end > nrem {
        end = nrem
      }
      var r = i
      while r < end {
        let robj: RawPtr = remBuf.load(fromByteOffset: r * 8)
        if !robj.isNull {
          count = rtMinorScanObj(space, w, robj, count)
        }
        r = r + 1
      }
      if recruit > 0 {
        recruit = recruit - (end - i)
        if recruit <= 0 {
          recruit = 0                            // recruited at the trace's first check with work to spare
        }
      }
    }
  }
  // Root source 3 — the large-object space (150.4.5.1.1), walked by the one worker that claims it. LOS objects
  // are off-heap (never in the nursery, never moved) and carry no log bit, so the write barrier's heap-range
  // guard skips stores into them and the remembered set never captures a mature LOS→young pointer (e.g. a large
  // Array<class> that gains a young element). Treat every live LOS object as an old root: scan its managed
  // slots for young referents each minor. Immortal buffers (String bytes) hold no managed pointers, so they
  // are not on this list. A dead-but-unswept LOS object keeps its young referents alive until the next major
  // sweeps it — conservative, not incorrect.
  if coord {
    rtGcPhaseClose(5, tp)
    tp = rtGcPhaseOpen(6)
  }
  let losTaken: Int = job.atomicExchange(1, atByteOffset: 144)
  if losTaken == 0 {
    var los: RawPtr = space.load(fromByteOffset: 64)
    while !los.isNull {
      let losObj = los.advanced(by: 8)               // object starts after the link word (rtLosAlloc)
      count = rtMinorScanObj(space, w, losObj, count)
      los = los.load(fromByteOffset: 0)              // next LOS node
    }
  }
  // The trace: pop each promoted object and scan it for further nursery referents (its young children promote
  // too). An object popped here may have been copied by another worker and shared through the pool, so the
  // copy's lines and log bit were set by its copier (rtMinorClaim). Every 32 objects the worker looks for idle
  // workers and an empty pool, and gives them the bottom of its stack, the work nearest the roots. The
  // coordinator recruits once its scanned objects reach what the roots left of rtGcParallelMin, with work to
  // spare.
  if coord {
    rtGcPhaseClose(6, tp)
    tp = rtGcPhaseOpen(7)
  }
  var scanned = 0
  var scannedBytes = 0
  var tracing = true
  while tracing {
    if count > 0 {
      count = count - 1
      let qbase: RawPtr = w.load(fromByteOffset: 32)
      let obj: RawPtr = qbase.load(fromByteOffset: count * 8)
      scanned = scanned + 1
      if Runtime.gcRecordLevel() > 0 {           // the report's bytes; folds away unless recording
        scannedBytes = scannedBytes + rtObjSize(obj)
      }
      count = rtMinorScanObj(space, w, obj, count)
      if (scanned & 31) == 0 && count >= 2 {    // every 32 objects, with work to spare: share, or recruit
        let idle: Int = job.atomicLoad(fromByteOffset: 384)
        if idle > 0 {
          let pooled: Int = job.atomicLoad(fromByteOffset: 640)
          if pooled == 0 {
            count = rtMinorShare(job, w, count)
          }
        } else if recruit >= 0 && scanned >= recruit {
          rtMinorRecruit(job)
          recruit = -1
        }
      }
    } else {
      count = rtMinorAwait(job, w)
      tracing = count > 0
    }
  }
  if coord {
    rtGcPhaseClose(7, tp)
  }
  w.store(scanned, toByteOffset: 48)
  w.store(scannedBytes, toByteOffset: 56)
}

// Move the bottom of worker `w`'s stack (`count` entries, at least 2) into a chunk on the pool: half, at most a
// chunk. The bottom holds the objects nearest the roots, the most work. Returns the entries left.
fun rtMinorShare(job: RawPtr, w: RawPtr, count: Int) -> Int {
  var n = count / 2
  if n > rtMinorChunk {
    n = rtMinorChunk
  }
  let base: RawPtr = w.load(fromByteOffset: 32)
  let chunk = RawPtr.alloc(bytes: 16 + rtMinorChunk * 8, align: 8)
  chunk.store(n, toByteOffset: 8)
  chunk.advanced(by: 16).copyBytes(from: base, byteCount: n * 8)
  var i = n
  while i < count {
    let e: RawPtr = base.load(fromByteOffset: i * 8)
    base.store(e, toByteOffset: (i - n) * 8)
    i = i + 1
  }
  rtSchedMutexLockAt(job.advanced(by: 256))
  let head: RawPtr = job.load(fromByteOffset: 264)
  chunk.store(head, toByteOffset: 0)
  job.store(chunk, toByteOffset: 264)
  job.atomicFetchAdd(1, atByteOffset: 640)
  rtSchedMutexUnlockAt(job.advanced(by: 256))
  // Wake one sleeper for the chunk; idle workers still spinning see it unwoken. No wake is lost: the count went
  // up before the sleepers are read, and a sleeper counts itself before its wait, which rechecks the count.
  let sleepers: Int = job.atomicLoad(fromByteOffset: 392)
  if sleepers > 0 {
    Runtime.futexWake(at: job.advanced(by: 640), all: false)
  }
  if Runtime.gcRecordLevel() > 0 {
    job.atomicFetchAdd(1, atByteOffset: 576)
  }
  return count - n
}

// Wait, idle, for work or the trace's end, worker `w`'s stack empty. Returns the entries of a chunk taken off
// the pool onto the stack, or 0 when the trace is done. The trace is done once every joined worker is idle with
// the pool empty. A worker leaves idle only by taking a chunk, under the pool's lock, and only a working worker
// adds one; so that state, seen under the lock, holds from then on. The worker that sees it marks the job done
// (rtMinorDone, which also closes it to joins: the CAS fails if a helper joined meanwhile) and wakes the rest.
fun rtMinorAwait(job: RawPtr, w: RawPtr) -> Int {
  let lock = job.advanced(by: 256)
  job.atomicFetchAdd(1, atByteOffset: 384)
  var spins = 0
  while true {
    let pooled: Int = job.atomicLoad(fromByteOffset: 640)
    if pooled > 0 {
      rtSchedMutexLockAt(lock)
      let chunk: RawPtr = job.load(fromByteOffset: 264)
      if !chunk.isNull {
        let next: RawPtr = chunk.load(fromByteOffset: 0)
        job.store(next, toByteOffset: 264)
        job.atomicFetchAdd(-1, atByteOffset: 640)
        job.atomicFetchAdd(-1, atByteOffset: 384)     // no longer idle, under the lock
        rtSchedMutexUnlockAt(lock)
        let n: Int = chunk.load(fromByteOffset: 8)
        let base: RawPtr = w.load(fromByteOffset: 32)   // a stack holds at least a chunk (rtCopyStackTake)
        base.copyBytes(from: chunk.advanced(by: 16), byteCount: n * 8)
        chunk.free()
        return n
      }
      rtSchedMutexUnlockAt(lock)
    }
    let jw: Int = job.atomicLoad(fromByteOffset: 512)
    if jw >= rtMinorDone {
      return 0
    }
    var done = false
    let seen: Int = job.atomicLoad(fromByteOffset: 384)
    if seen == jw {                                     // looks done: confirm under the lock
      rtSchedMutexLockAt(lock)
      let head: RawPtr = job.load(fromByteOffset: 264)
      let idle: Int = job.atomicLoad(fromByteOffset: 384)
      if head.isNull && idle == jw {
        let got: Int = job.atomicCas(jw, jw + rtMinorDone, atByteOffset: 512)
        done = got == jw
      }
      rtSchedMutexUnlockAt(lock)
    }
    if done {
      Runtime.futexWake(at: job.advanced(by: 640), all: true)
      return 0
    }
    spins = spins + 1
    if spins > rtMinorSpins {
      if Runtime.gcRecordLevel() > 0 {
        job.atomicFetchAdd(1, atByteOffset: 584)
      }
      job.atomicFetchAdd(1, atByteOffset: 392)
      Runtime.futexWait(at: job.advanced(by: 640), expected: 0, timeoutMicros: 1000)
      job.atomicFetchAdd(-1, atByteOffset: 392)
    }
  }
  return 0
}

// Drive a major (defrag) collection at an STW: walk every stopped mutator's root SLOTS and run the defrag
// collector over the self-hosted Immix space (heap-pressure-safe). Called by the STW coordinator with the
// world stopped. Returns the number of roots processed (0 before the first managed allocation, while the
// space is null).
fun nomuSchedStwCollectDefrag(sched: RawPtr) -> Int {
  let space = rtSpace
  let spaceNull = space.eq(RawPtr.null)
  if spaceNull {
    return 0
  }
  let collectStart = rtGcRecordEntry(2)
  let roots = rtRootsNew()
  let tw = rtGcPhaseOpen(2)
  let ns = nomuSchedWalkSlots(sched, roots)
  rtGcPhaseClose(2, tw)
  let slots: RawPtr = roots.load(fromByteOffset: 0)
  rtGcCounter(1, ns)
  // When generational is active (rtGenReserve > 0 — the default) a defrag major is also the minor/major
  // escalation target (150.4.4), so re-establish the log-bit invariant post-collection; when disabled
  // (NOMU_NURSERY_RESERVE negative) the plain defrag runs unchanged (the pre-generational path).
  if rtGenReserve(space) > 0 {
    rtImmixCollectRootsDefragGen(space, slots, ns)
  } else {
    rtImmixCollectRootsDefrag(space, slots, ns)
  }
  rtHeapResize(space)           // L from what survived (heap sizing, immix.nomu)
  rtHeapReturnFree(space)       // free blocks past the allowance go back to the OS
  if rtGcVerify {
    rtVerifyHeap(space, slots, ns, RawPtr.null, 0, 2)   // before the run queues' entries are tagged again
  }
  rtRootsFixDerived(roots)
  rtRootsFree(roots)
  rtGcRecordExit(collectStart)
  rtCarriersResetTlabs()        // evacuation may have moved a carrier's block; refill on resume
  rtCarriersResetModBufs()      // the collection consumed the remembered set; start empty next cycle
  rtMsgReclaim()                // the message pool's free lists rebuilt, its empty slabs released
  return ns
}

// Drive a minor (generational) collection at an STW (task 150.4.3): the stopped mutators' stack root slots
// plus the drained per-carrier remembered set (the write barrier's mod-buffers) are the root set; the nursery
// is promoted into mature Immix. Returns the number of objects promoted (0 while the space is null). The
// drain (rtCarriersDrainModBufs) both collects and empties the mod-buffers; the TLABs are reset after the
// collection (their nursery blocks were reclaimed).
fun nomuSchedStwCollectMinor(sched: RawPtr) -> Int {
  let space = rtSpace
  let spaceNull = space.eq(RawPtr.null)
  if spaceNull {
    return 0
  }
  let collectStart = rtGcRecordEntry(1)
  let roots = rtRootsNew()
  let tw = rtGcPhaseOpen(2)
  rtMsgMinor.store(1, toByteOffset: 0)            // queued messages: only those sent since the last collection
  let ns = nomuSchedWalkSlots(sched, roots)
  rtMsgMinor.store(0, toByteOffset: 0)
  rtGcPhaseClose(2, tw)
  let slots: RawPtr = roots.load(fromByteOffset: 0)
  let td = rtGcPhaseOpen(3)
  let remTotal = rtCarriersModBufTotal()
  let rem = RawPtr.alloc(bytes: remTotal * 8 + 8, align: 8)   // exactly the remembered set (+8: never zero bytes)
  let nrem = rtCarriersDrainModBufs(rem)
  rtGcPhaseClose(3, td)
  rtGcCounter(1, ns)
  rtGcCounter(3, nrem)
  if rtGcVerify {
    rtVerifyHeap(space, slots, ns, rem, nrem, 0)
  }
  let n = rtImmixCollectMinor(sched, space, slots, ns, rem, nrem)
  if rtGcVerify {
    rtVerifyHeap(space, slots, ns, RawPtr.null, 0, 1)   // before the run queues' entries are tagged again
  }
  rtRootsFixDerived(roots)
  rtGcCounter(2, n)
  rem.free()
  rtRootsFree(roots)
  rtGcRecordExit(collectStart)
  rtCarriersResetTlabs()        // the reclaimed nursery blocks moved out from under the carriers' TLABs
  rtMsgYoungReset()             // every queued message now references mature objects only
  return n
}

// ---- The GC coordinator ----
// A plain OS thread (never a fiber, so it never stops at a safepoint itself) that runs every collection. It
// sleeps on gc-request (sched+168) until a mutator raises a request (rtGcRaise): a minor when the nursery
// reserve fills, a major at true OOM, a stress collection, or a white-box test's rtGcRequest. The requester
// has already set stw-request (+136) and the kind (+176) under the scheduler lock. The coordinator then stops the world: it
// raises `rtStopWorld`, wakes idle carriers so they ack, and sleeps on the ack count (+144), which each
// carrier's ack bumps and wakes (rtSchedStwParkCarrier), until every carrier has acked. Running fibers see the
// request through their stack limits (the request word, `scheduler.nomu`). With the world
// stopped it reads the kind and runs that collection, then resumes the world: it resets the kind, the ack count and
// the request, clears `rtStopWorld`, and bumps stw-gen (+152), which the parked carriers wait on. It exits
// on the scheduler's stop flag (+40). nomuSchedBoot starts and joins it.
fun rtGcCoordinatorMain(sched: RawPtr) -> RawPtr {
  rtFaultThreadStart(3, 0)
  let req = sched.advanced(by: 168)
  let ack = sched.advanced(by: 144)
  var go = true
  while go {
    let stp: Int = sched.atomicLoad(fromByteOffset: 40)
    let pending: Int = req.atomicLoad(fromByteOffset: 0)
    if stp != 0 {
      go = false
    } else if pending == 0 {
      Runtime.futexWait(at: req, expected: 0, timeoutMicros: 1000000)
    } else {
      req.atomicStore(0, toByteOffset: 0)                 // consume the request (stw-request is already set)
      let ncarriers: Int = sched.atomicLoad(fromByteOffset: 160)
      rtStopWorld.atomicStore(1, toByteOffset: 0)
      rtStopRunningFibers()                               // running fibers stop at their next check or poll
      rtSchedWake(sched, true)                            // idle carriers wake, see the request, and ack
      // The ack word carries this STW's generation tag over the count (rtSchedStwParkCarrier); the futex
      // compares the count, its low 32 bits.
      // A carrier whose fiber is in C acknowledges through its claim (rtClaimInC), looked for on every wake.
      let gen: Int = sched.atomicLoad(fromByteOffset: 152)
      rtClaimInC(sched, gen)
      let ackWord: Int = ack.atomicLoad(fromByteOffset: 0)
      var acked = ackWord % 4294967296
      var waiting = acked < ncarriers
      while waiting {
        Runtime.futexWait(at: ack, expected: acked, timeoutMicros: 1000)
        rtClaimInC(sched, gen)
        let aw: Int = ack.atomicLoad(fromByteOffset: 0)
        acked = aw % 4294967296
        let done: Int = sched.atomicLoad(fromByteOffset: 40)
        waiting = acked < ncarriers && done == 0
      }
      // Read once every carrier has acked: a request that joins this one may still raise the kind to a major
      // until then (rtGcRaise). The program may have ended first, with a fiber still running: no collection.
      let kind: Int = sched.atomicLoad(fromByteOffset: 176)
      if acked < ncarriers {
      } else if kind == 1 && Runtime.gcPlan() == 0 {     // a plan without a nursery compiles the minor out
        nomuSchedStwCollectMinor(sched)
        if rtStackShrinkStress {
          rtStackShrinkAll(sched)
        }
      } else {
        nomuSchedStwCollectDefrag(sched)
        rtStackShrinkAll(sched)                           // stacks shrink at a major, the world still stopped
        rtPoolDrainAll()                                  // and the carriers' pools of records and stacks empty
      }
      // A leak pass to follow, with the world still stopped and the wait objects current (`runtime/leak.nomu`).
      if acked >= ncarriers && sched.atomicLoad(fromByteOffset: 200) != 0 {
        sched.atomicStore(0, toByteOffset: 200)
        rtLeakCheck(sched)
      }
      sched.atomicStore(0, toByteOffset: 176)             // the kind, for the next request
      // Reset the count under the next generation's tag before clearing the request, so a late ack for
      // this STW is dropped instead of counted toward the next.
      let gw = sched.advanced(by: 152)
      let gen: Int = gw.atomicLoad(fromByteOffset: 0)
      ack.atomicStore(rtStwAckTag(gen + 1), toByteOffset: 0)
      sched.atomicStore(0, toByteOffset: 136)
      rtStopWorld.atomicStore(0, toByteOffset: 0)
      gw.atomicFetchAdd(1, atByteOffset: 0)
      Runtime.futexWake(at: gw, all: true)                // resume the parked carriers
    }
  }
  return sched
}

// Available empty blocks for the mutator (never-used below its cap + reclaimed-free) — the heap-pressure
// gauge. Returns -1 before the space exists (no managed allocation yet).
fun nomuGcSpaceAvail() -> Int {
  let space = rtSpace
  let spaceNull = space.eq(RawPtr.null)
  if spaceNull {
    return -1
  }
  return rtNeverUsedBelowCap(space) + space.load(fromByteOffset: 96)
}

// Never-used blocks below the mutator's cap: none once the collector's copies have passed it.
fun rtNeverUsedBelowCap(space: RawPtr) -> Int {
  let fc: Int = space.load(fromByteOffset: 32)
  let left = rtHeapCap(space) - fc
  if left < 0 {
    return 0
  }
  return left
}

// The heap's size in blocks: L and the nursery. 0 when it does not exist.
fun nomuGcSpaceBlocks() -> Int {
  let space = rtSpace
  let spaceNull = space.eq(RawPtr.null)
  if spaceNull {
    return 0
  }
  return rtHeapCap(space)
}

// ---- Copy reserve + defrag trigger — the general collector (task 150 · rung 3, 150.3.8) ----
// The defrag trigger replaces force-all: only fragmented blocks are evacuated, and only as many as fresh
// to-space can absorb (the copy reserve). Fragmentation is read from defragTable — each block's live-line
// count as of the last sweep (§10.6, MMTk's "previous GC mark histogram drives this GC's defrag"). A block
// is a source iff it holds live data but is sparsely filled (0 < lastLiveLines ≤ threshold). The reserve
// bounds the source count by available empty blocks: each source needs at most one to-space block, so
// selecting at most (available − reserve) sources leaves the reserve free even if a source turned out full —
// the guarantee that evacuation never runs out of to-space mid-collection. When the heap is near-full
// (budget 0) no sources are selected and the collection is non-moving. Selection is deterministic (scan
// order), so a collection is reproducible run to run.

// Half a block — a block with at most this many live lines (more than half holes) is fragmented enough to
// evacuate. The fragmentation threshold; tuning it (and the block-selection order) is the defrag policy knob.
fun rtDefragThreshold() -> Int {
  return 64
}

// Select evacuation sources for this collection and mark them DEFRAG_SOURCE (state 3). A block qualifies
// when the last sweep found it sparsely live (0 < count ≤ threshold) and it is still a used block (state
// RECYCLABLE/UNAVAILABLE). At most `budget` blocks are selected — budget is the available empty-block count
// (free list + never-used) minus the copy reserve — so to-space can always absorb the survivors. Returns the
// number selected (0 ⇒ the collection runs non-moving). Freshly allocated blocks with no histogram (count 0)
// are never sources; the first collection therefore never evacuates and only seeds defragTable.
fun rtSelectDefragSources(space: RawPtr) -> Int {
  let fc: Int = space.load(fromByteOffset: 32)
  let flTop: Int = space.load(fromByteOffset: 96)
  let neverUsed = rtNeverUsedBelowCap(space)
  let available = flTop + neverUsed
  var reserve = available / 16
  if reserve < 1 {
    reserve = 1
  }
  var budget = available - reserve
  if budget < 0 {
    budget = 0
  }
  let threshold = rtDefragThreshold()
  let dt: RawPtr = space.load(fromByteOffset: 112)
  var selected = 0
  var bi = 0
  while bi < fc {
    if selected < budget {
      let cnt: UInt8 = dt.load(fromByteOffset: bi)
      let live = cnt.int
      if live > 0 {
        if live <= threshold {
          let st = rtBlockState(space, bi)
          if st != 0 {
            rtSetBlockState(space, bi, 3)   // DEFRAG_SOURCE for this collection
            selected = selected + 1
          }
        }
      }
    }
    bi = bi + 1
  }
  return selected
}

// One collection from `root`, the general Immix collector (150.3.8): select fragmented blocks as evacuation
// sources within the copy reserve, evacuate their live objects to fresh to-space while marking every other
// live object in place, then reclaim the emptied sources + dead blocks by the 150.3.5 sweep (which also
// records the next collection's fragmentation histogram). Returns the root's post-collection address — the
// root moves only if it sat in a source block, so the caller adopts the returned pointer. With zero sources
// this is exactly the non-moving collector (rtImmixCollect); with every used block a source it is force-all
// (rtImmixEvacCollect) — one path, the evacuation set chosen by fragmentation.
fun rtImmixCollectDefrag(space: RawPtr, root: RawPtr) -> RawPtr {
  rtAdvanceMark()
  let nSources = rtSelectDefragSources(space)
  rtClearAllLines(space)
  rtSetupCopyAllocator(space)
  let newRoot = rtImmixEvacMark(space, root)
  rtImmixSweepBlocks(space)
  rtImmixSweepLos(space)
  rtResetAllocator(space)
  rtGcWorkRelease()
  return newRoot
}
