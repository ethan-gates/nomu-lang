// The runtime's startup globals: the run settings read from the environment, the scheduler, and the heap.
// Part of the `runtime` module; see README.md.

// ---- Process-wide runtime state, set once at startup ----
// Startup globals (`tasks/224-globals.md`): `nomu_runtime_init` computes them on the main thread before the
// scheduler boots, in the order their reads require, and they never change after. Generated code reads the
// heap and barrier values by symbol (`nomu_g_<name>`) with invariant loads; C reads `rtSched` as an extern
// until its users move into Nomu.

// Dev/test overrides from the environment; 0 means unset.
// NOMU_NURSERY_RESERVE, in blocks: positive overrides the generational reserve; rtGenReserve resolves it
// against the descriptor's default. (Major-only collection is the `immix` plan, `gc.plan`.)
let rtNurseryReserveOverride = rtEnvNurseryReserve()
// NOMU_MATURE_FLOOR, in blocks: below this many free mature blocks a nursery-full trigger escalates to a
// full defrag major (rtImmixRefill).
let rtMatureFloor = rtPositive(rtEnvMatureFloor())
// NOMU_GC_STRESS, in bytes: every allocation takes the slow path and each carrier requests a collection
// after this many allocated bytes.
let rtGcStress = rtPositive(rtEnvGcStress())
// NOMU_GC_STRESS_MAJOR_EVERY, under NOMU_GC_STRESS: every this many stress collections, process-wide, one is a
// major, so minors and majors alternate whatever the program's live data; 0 leaves the choice to the policy.
let rtGcStressMajorEvery = rtPositive(rtEnvGcStressMajorEvery())
// The stress collections requested so far, for NOMU_GC_STRESS_MAJOR_EVERY (counted atomically by carriers).
let rtGcStressCount = Runtime.staticStorage(bytes: 8, align: 8)
// NOMU_GC_VERIFY: 1 checks the collector's invariants at every collection (gcverify.nomu); off unless set.
let rtGcVerify = rtPositive(rtEnvGcVerify()) > 0
// NOMU_CARRIERS: the number of carrier threads the scheduler boots with; 4 unless set to 1 or more.
let rtCarrierCount = rtEnvCarrierCount()
// NOMU_SLOT: 0 turns off the run-queue slot (rtSchedReadyNext readies onto the run queue instead); on unless set.
let rtSlotOn = rtEnvSlot()
// NOMU_SLOT_STEAL_NS: how long a carrier's current fiber must have run before a searcher may take the fiber
// waiting in its slot; 3000 unless set. NOMU_SLICE_NS: how long a chain of fibers handed through one
// carrier's slot runs before the next one goes to the back of the run queue; 1 ms unless set. Both are
// kept in ticks (`Runtime.ticks()`). NOMU_GLOBAL_CHECK: a carrier takes from the run queue before its slot
// every this many picks; 61 unless set.
let rtSlotStealTicks = rtNanosToTicks(rtEnvSlotStealNanos())
let rtSliceTicks = rtNanosToTicks(rtEnvSliceNanos())
let rtGlobalCheck = rtEnvGlobalCheck()
// NOMU_SEARCH_NS: how long a woken carrier searches before sleeping again; 20000 unless set.
let rtSearchNanos = rtEnvSearchNanos()
// NOMU_PREEMPT: 0 turns off preemption (the monitor, `scheduler.nomu`); on unless set. The monitor's shortest
// period is a quarter of the slice (NOMU_SLICE_NS), in microseconds, at least 50.
let rtPreemptOn = rtEnvPreempt() != 0
let rtMonitorMinMicros = rtMonitorMin(rtEnvSliceNanos())

// The scheduler.
let rtSched = nomuSchedNew()

// The heap: one Immix space over a reservation made once, here, so its descriptor and the write barrier's
// values are constants. The reservation is NOMU_HEAP_MAX, in bytes with an optional suffix (B, KiB, MiB,
// GiB, TiB), or by default the larger of 64 GiB (rtHeapDefaultFloor) and 4× physical RAM, halved until the
// system grants it. Only touched pages cost memory (rtImmixNew). The heap's size is a soft limit inside the
// reservation that follows the live data (heap sizing, immix.nomu): it starts at rtHeapMinimum, 4 MiB, Go's
// starting heap, which is also the smallest reservation. NOMU_GC_PERCENT is r × 100 in that policy, 100
// unless set, as Go's GOGC.
let rtHeapDefaultFloor = 68719476736
let rtHeapMinimum = 4194304
let rtGcPercent = rtEnvGcPercent()
let rtHeapMaxSetting = rtEnvHeapMax()
let rtSpace = rtHeapNew(rtHeapMaxSetting)
let rtHeapReservedBlocks: Int = rtSpace.load(fromByteOffset: 8)
// The write barrier's values, together so its inline fast path (`__nomu_remember`, LLVMGenRuntime.swift) reads
// them from one address: the heap's start @0, the reservation's length in bytes @8, and the log-bit table @16.
// The table covers the whole reservation, one bit per 8-byte region: the byte for address `a` is at
// `table + (a - start) / 64`. A store into an object outside the reservation (large and immortal objects)
// skips the barrier. All zero until filled, which skips every store.
let rtBarrierRange = Runtime.staticStorage(bytes: 24, align: 8)
let rtBarrierRangeFilled = rtBarrierRangeFill(rtSpace, rtHeapReservedBlocks)

// The heap's space: a reservation of `setting` bytes when NOMU_HEAP_MAX gives one, which out of memory ends
// the program when the system refuses; else the default size, halved on each refusal down to the minimum. The
// heap starts at the minimum.
fun rtHeapNew(setting: Int) -> RawPtr {
  var blocks = setting / 32768
  var heap = RawPtr.null
  if setting > 0 {
    heap = Runtime.reserveZeroed(bytes: blocks * 32768, align: 32768)
    if heap.isNull {
      rtOutOfMemoryIn(2, blocks * 32768, RawPtr.null)
    }
  } else {
    var bytes = rtHeapDefaultFloor
    let ram = Runtime.physicalMemory()
    if ram * 4 > bytes {
      bytes = ram * 4
    }
    blocks = bytes / 32768
    heap = Runtime.reserveZeroed(bytes: blocks * 32768, align: 32768)
    while heap.isNull && blocks / 2 * 32768 >= rtHeapMinimum {
      blocks = blocks / 2
      heap = Runtime.reserveZeroed(bytes: blocks * 32768, align: 32768)
    }
    if heap.isNull {
      rtOutOfMemoryIn(1, blocks * 32768, RawPtr.null)
    }
  }
  return rtImmixNew(heap, blocks, rtHeapMinimum / 32768)
}

// NOMU_GC_PERCENT: a positive whole number, 100 when unset. A value it cannot read ends the program.
fun rtEnvGcPercent() -> Int {
  let name = RawPtr.alloc(bytes: 32, align: 8)
  let s = rtEnvValue(name, Runtime.copyLiteral(to: name, "NOMU_GC_PERCENT"))
  if s.isNull {
    return 100
  }
  var n = 0
  var i = 0
  var more = true
  while more {
    let c: UInt8 = s.load(fromByteOffset: i)
    let d = c.int - 48
    if d < 0 || d > 9 || i >= 9 {
      more = false
    } else {
      n = n * 10 + d
      i = i + 1
    }
  }
  let end: UInt8 = s.load(fromByteOffset: i)
  if i == 0 || end.int != 0 || n == 0 {
    let msg = RawPtr.alloc(bytes: 128, align: 8)
    let len = Runtime.copyLiteral(to: msg, "fatal error: NOMU_GC_PERCENT: expected a whole number above 0, such as 100\n")
    Runtime.writeFd(fd: 2, buf: msg, count: len)
    Runtime.exit(2)
  }
  return n
}

// NOMU_HEAP_MAX in bytes: decimal digits and an optional suffix, B, KiB, MiB, GiB or TiB, as Go's GOMEMLIMIT
// reads them; 0 when unset. A value it cannot read, or one below the minimum heap, ends the program.
fun rtEnvHeapMax() -> Int {
  let name = RawPtr.alloc(bytes: 32, align: 8)
  let s = rtEnvValue(name, Runtime.copyLiteral(to: name, "NOMU_HEAP_MAX"))
  if s.isNull {
    return 0
  }
  var n = 0
  var i = 0
  var more = true
  while more {
    let c: UInt8 = s.load(fromByteOffset: i)
    let d = c.int - 48
    if d < 0 || d > 9 || i >= 15 {
      more = false
    } else {
      n = n * 10 + d
      i = i + 1
    }
  }
  let c0: UInt8 = s.load(fromByteOffset: i)
  var unit = 0
  if i > 0 {
    if c0.int == 0 {
      unit = 1
    } else {
      let c1: UInt8 = s.load(fromByteOffset: i + 1)
      if c0.int == 66 && c1.int == 0 {                               // B
        unit = 1
      } else if c1.int == 105 {                                      // ?i…
        let c2: UInt8 = s.load(fromByteOffset: i + 2)
        let c3: UInt8 = s.load(fromByteOffset: i + 3)
        if c2.int == 66 && c3.int == 0 {                             // ?iB
          if c0.int == 75 { unit = 1024 }                            // KiB
          if c0.int == 77 { unit = 1048576 }                         // MiB
          if c0.int == 71 { unit = 1073741824 }                      // GiB
          if c0.int == 84 { unit = 1099511627776 }                   // TiB
        }
      }
    }
  }
  // At most 2^62 bytes, so the product cannot overflow and the reservation's size stays positive.
  if unit == 0 || n > 4611686018427387904 / unit || n * unit < rtHeapMinimum {
    let msg = RawPtr.alloc(bytes: 256, align: 8)
    let len = Runtime.copyLiteral(to: msg, "fatal error: NOMU_HEAP_MAX: expected a size of at least 4MiB, such as 512MiB or 64GiB (suffixes B, KiB, MiB, GiB, TiB)\n")
    Runtime.writeFd(fd: 2, buf: msg, count: len)
    Runtime.exit(2)
  }
  return n * unit
}

fun rtBarrierRangeFill(space: RawPtr, blocks: Int) -> Int {
  let start: Int = space.load(fromByteOffset: 40)
  let table: RawPtr = space.load(fromByteOffset: 144)
  rtBarrierRange.store(start, toByteOffset: 0)
  rtBarrierRange.store(blocks * 32768, toByteOffset: 8)
  rtBarrierRange.store(table, toByteOffset: 16)
  return 1
}

fun rtPositive(v: Int) -> Int {
  if v > 0 {
    return v
  }
  return 0
}

// The value of the environment variable whose name is the `len` bytes at `name`, NUL-terminated here; frees
// `name`. Null when unset.
fun rtEnvValue(name: RawPtr, len: Int) -> RawPtr {
  name.store(0.uint8, toByteOffset: len)
  let v = Runtime.getenv(name: name)
  name.free()
  return v
}

// A NUL-terminated string's leading signed decimal number, as `atol` reads it (no leading spaces); 0 for
// null or no digits.
fun rtEnvParseInt(s: RawPtr) -> Int {
  if s.isNull {
    return 0
  }
  var i = 0
  var sign = 1
  let first: UInt8 = s.load(fromByteOffset: 0)
  if first.int == 45 {
    sign = -1
    i = 1
  }
  var n = 0
  var more = true
  while more {
    let c: UInt8 = s.load(fromByteOffset: i)
    let d = c.int - 48
    if d < 0 || d > 9 {
      more = false
    } else {
      n = n * 10 + d
      i = i + 1
    }
  }
  return sign * n
}

fun rtEnvNurseryReserve() -> Int {
  let name = RawPtr.alloc(bytes: 32, align: 8)
  return rtEnvParseInt(rtEnvValue(name, Runtime.copyLiteral(to: name, "NOMU_NURSERY_RESERVE")))
}

fun rtEnvMatureFloor() -> Int {
  let name = RawPtr.alloc(bytes: 32, align: 8)
  return rtEnvParseInt(rtEnvValue(name, Runtime.copyLiteral(to: name, "NOMU_MATURE_FLOOR")))
}

fun rtEnvGcStress() -> Int {
  let name = RawPtr.alloc(bytes: 32, align: 8)
  return rtEnvParseInt(rtEnvValue(name, Runtime.copyLiteral(to: name, "NOMU_GC_STRESS")))
}

fun rtEnvGcVerify() -> Int {
  let name = RawPtr.alloc(bytes: 32, align: 8)
  return rtEnvParseInt(rtEnvValue(name, Runtime.copyLiteral(to: name, "NOMU_GC_VERIFY")))
}

fun rtEnvGcStressMajorEvery() -> Int {
  let name = RawPtr.alloc(bytes: 32, align: 8)
  return rtEnvParseInt(rtEnvValue(name, Runtime.copyLiteral(to: name, "NOMU_GC_STRESS_MAJOR_EVERY")))
}

fun rtEnvCarrierCount() -> Int {
  let name = RawPtr.alloc(bytes: 32, align: 8)
  let n = rtEnvParseInt(rtEnvValue(name, Runtime.copyLiteral(to: name, "NOMU_CARRIERS")))
  if n >= 1 {
    return n
  }
  return 4
}

// An integer setting from the environment (`v`, rtEnvValue's result): its value when set, else `dflt`.
fun rtEnvIntOr(v: RawPtr, dflt: Int) -> Int {
  if v.isNull {
    return dflt
  }
  return rtEnvParseInt(v)
}

fun rtEnvSlot() -> Int {
  let name = RawPtr.alloc(bytes: 32, align: 8)
  return rtEnvIntOr(rtEnvValue(name, Runtime.copyLiteral(to: name, "NOMU_SLOT")), 1)
}

fun rtEnvSlotStealNanos() -> Int {
  let name = RawPtr.alloc(bytes: 32, align: 8)
  return rtEnvIntOr(rtEnvValue(name, Runtime.copyLiteral(to: name, "NOMU_SLOT_STEAL_NS")), 3000)
}

fun rtEnvSliceNanos() -> Int {
  let name = RawPtr.alloc(bytes: 32, align: 8)
  return rtEnvIntOr(rtEnvValue(name, Runtime.copyLiteral(to: name, "NOMU_SLICE_NS")), 1000000)
}

fun rtEnvPreempt() -> Int {
  let name = RawPtr.alloc(bytes: 32, align: 8)
  return rtEnvIntOr(rtEnvValue(name, Runtime.copyLiteral(to: name, "NOMU_PREEMPT")), 1)
}

fun rtMonitorMin(sliceNanos: Int) -> Int {
  let us = sliceNanos / 4000
  if us < 50 {
    return 50
  }
  return us
}

fun rtEnvGlobalCheck() -> Int {
  let name = RawPtr.alloc(bytes: 32, align: 8)
  let n = rtEnvIntOr(rtEnvValue(name, Runtime.copyLiteral(to: name, "NOMU_GLOBAL_CHECK")), 61)
  if n >= 1 {
    return n
  }
  return 61
}

fun rtEnvSearchNanos() -> Int {
  let name = RawPtr.alloc(bytes: 32, align: 8)
  let n = rtEnvIntOr(rtEnvValue(name, Runtime.copyLiteral(to: name, "NOMU_SEARCH_NS")), 20000)
  if n >= 1 {
    return n
  }
  return 20000
}

// Nanoseconds as `Runtime.ticks()` units, by the system timebase (ticks × numer / denom = ns).
fun rtNanosToTicks(ns: Int) -> Int {
  let tb = RawPtr.alloc(bytes: 8, align: 8)
  tb.store(0, toByteOffset: 0)
  let ok = Runtime.timebase(info: tb)
  let packed: Int = tb.load(fromByteOffset: 0)
  tb.free()
  let numer = packed % 4294967296
  let denom = packed / 4294967296
  if numer == 0 || denom == 0 {
    return ns
  }
  return ns * denom / numer
}

