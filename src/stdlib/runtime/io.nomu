// Program I/O: stdin line input with its poller thread, and the array bounds trap.
// Part of the `runtime` module; see README.md.

// An array subscript out of range: generated code checks every subscript and calls this on a failure. Prints
// the index and length to stderr and aborts; never returns. Its calls are gc-leaf.
fun rtBoundsTrap(idx: Int, len: Int) {
  let msg = rtBufNew(128)
  rtBufGrew(msg, Runtime.copyLiteral(to: rtBufAt(msg, 32), "fatal error: array index "))
  rtBufInt(msg, idx)
  rtBufGrew(msg, Runtime.copyLiteral(to: rtBufAt(msg, 32), " out of range for length "))
  rtBufInt(msg, len)
  let md: RawPtr = msg.load(fromByteOffset: 0)
  let ml: Int = msg.load(fromByteOffset: 8)
  let w = Runtime.writeFd(fd: 2, buf: md, count: ml)
  Runtime.fatal("")
}

// ---- Line input and the stdin poller ----
// `readLine` reads stdin through one line buffer. A fiber whose line is not buffered yet checks readiness
// (`Runtime.poll`); when stdin has nothing to read it joins the waiter list and parks, so its carrier runs
// other fibers meanwhile. One poller thread, started on first use, blocks in kevent(2) on a one-shot read
// event for stdin and, when it fires, unparks every waiter; each re-checks the buffer, and one that still
// finds nothing waits again. Every waiter shares the one kqueue registration: kqueue keys an event by
// (fd, filter), so arming per fiber would overwrite an earlier waiter's wake-up.
//
// Lock order: the stdin lock, then the scheduler lock. A parking fiber takes the scheduler lock before it
// releases the stdin lock, and the poller takes the scheduler lock (rtSchedUnpark) only after releasing the
// stdin lock, so an unpark cannot re-queue a fiber whose context is not saved yet. The stdin lock is never
// held across a park.
//
// rtStdin: 0 lock (futex mutex word) · 8 buffer · 16 head (first unread byte) · 24 end (bytes buffered)
//          · 32 capacity · 40 end of input seen · 48 waiter list · 56 read event armed · 64 kqueue fd
//          · 72 poller started · 80 poller thread handle
// A waiter (16 bytes): 0 fiber · 8 next. A `select`'s `readLine()` case links its own select waiter instead
// (`runtime/channel.nomu`), with its record and the low bit set at 0; the poller claims the record under the
// stdin lock, which rtSelectDone takes to unlink a waiter that was not woken before it frees the record.
let rtStdin = Runtime.staticStorage(bytes: 96, align: 8)

// Read one line from stdin. Returns a raw block the caller frees: the line's byte count at 0, then its bytes
// (without the newline) at 8. At end of input, the unterminated remainder, then empty lines. The anchor is
// the user frame the `readLine` forwarder captured, recorded if the fiber parks.
fun rtReadLine(sched: RawPtr, anchorSp: RawPtr, anchorPc: Int) -> RawPtr {
  // Parks repeatedly, and the stack may move at each: the anchor is kept as an offset from the stack's top.
  let anchorOff = rtAnchorOffset(anchorSp)
  let st = rtStdin
  rtSchedMutexLockAt(st)
  while true {
    let line = rtStdinTryLine(st)
    if line.isNull == false {
      rtSchedMutexUnlockAt(st)
      return line
    }
    // Nothing to read: wait for the poller, then re-check from the top.
    let w = RawPtr.alloc(bytes: 16, align: 8)
    w.store(rtCurrentFiber(), toByteOffset: 0)
    rtStdinWait(st, w)
    rtSchedWaiting(rtCurrentFiber(), rtWaitStdin)
    rtSchedLock(sched)
    rtSchedMutexUnlockAt(st)
    nomuSchedParkLocked(sched, rtAnchorAt(rtCurrentFiber(), anchorOff), anchorPc)   // returns with the scheduler lock released
    rtSchedMutexLockAt(st)
  }
  return RawPtr.null
}

// Put `w` on the waiter list, starting the poller and arming the read event as needed. Called holding the
// stdin lock.
fun rtStdinWait(st: RawPtr, w: RawPtr) {
  rtStdinPollerStart(st)
  let first: RawPtr = st.load(fromByteOffset: 48)
  w.store(first, toByteOffset: 8)
  st.store(w, toByteOffset: 48)
  let armed: Int = st.load(fromByteOffset: 56)
  if armed == 0 {
    rtStdinArm(st)
    st.store(1, toByteOffset: 56)
  }
}

// Take `w` off the waiter list if it is there. Called holding the stdin lock.
fun rtStdinUnwait(st: RawPtr, w: RawPtr) {
  var prev = RawPtr.null
  var cur: RawPtr = st.load(fromByteOffset: 48)
  while cur.isNull == false {
    let next: RawPtr = cur.load(fromByteOffset: 8)
    if cur.eq(w) {
      if prev.isNull {
        st.store(next, toByteOffset: 48)
      } else {
        prev.store(next, toByteOffset: 8)
      }
      return
    }
    prev = cur
    cur = next
  }
}

// The next line if one can be had without waiting, reading stdin when it is readable, else null. Called
// holding the stdin lock.
fun rtStdinTryLine(st: RawPtr) -> RawPtr {
  while true {
    let buf: RawPtr = st.load(fromByteOffset: 8)
    let head: Int = st.load(fromByteOffset: 16)
    let end: Int = st.load(fromByteOffset: 24)
    var i = head
    var found = false
    while !found && i < end {
      let c: UInt8 = buf.load(fromByteOffset: i)
      if c.int == 10 {
        found = true
      } else {
        i = i + 1
      }
    }
    let eof: Int = st.load(fromByteOffset: 40)
    if found || eof != 0 {
      // A line ends at i; at end of input the line is the rest of the buffer, past which i stops.
      let line = rtStdinTake(st, buf, head, i - head)
      var next = i
      if found {
        next = i + 1
      }
      if next >= end {
        st.store(0, toByteOffset: 16)
        st.store(0, toByteOffset: 24)
      } else {
        st.store(next, toByteOffset: 16)
      }
      return line
    }
    if Runtime.poll(fd: 0) == 0 {
      return RawPtr.null
    } else {
      // Readable: read what is there. Holding the stdin lock serializes readers; a readable fd does not
      // block.
      rtStdinReserve(st, 4096)
      let rbuf: RawPtr = st.load(fromByteOffset: 8)
      let rend: Int = st.load(fromByteOffset: 24)
      let cap: Int = st.load(fromByteOffset: 32)
      let n = Runtime.readFd(fd: 0, buf: rbuf.advanced(by: rend), count: cap - rend)
      if n > 0 {
        st.store(rend + n, toByteOffset: 24)
      } else {
        st.store(1, toByteOffset: 40)   // end of input (or a read error, treated the same)
      }
    }
  }
  return RawPtr.null
}

// The number of fibers on the stdin waiter list, for white-box tests built with `test.runtime_prelude`: a
// fiber joins the list before it parks in rtReadLine, so a test waits until its readers are on it before it
// tells the harness to write stdin (the suite's `stdin_after`).
fun rtStdinWaiters() -> Int {
  let st = rtStdin
  rtSchedMutexLockAt(st)
  var n = 0
  var w: RawPtr = st.load(fromByteOffset: 48)
  while !w.isNull {
    n = n + 1
    w = w.load(fromByteOffset: 8)
  }
  rtSchedMutexUnlockAt(st)
  return n
}

// Copy `n` bytes at `buf + from` into a fresh line block: the count at 0, the bytes at 8.
fun rtStdinTake(st: RawPtr, buf: RawPtr, from: Int, n: Int) -> RawPtr {
  let line = RawPtr.alloc(bytes: 8 + n, align: 8)
  line.store(n, toByteOffset: 0)
  if n > 0 {
    line.advanced(by: 8).copyBytes(from: buf.advanced(by: from), byteCount: n)
  }
  return line
}

// Make room for at least `room` more bytes past the buffered end: move the unread bytes to the front of a
// buffer of twice the capacity (8 KiB at first) when they do not fit.
fun rtStdinReserve(st: RawPtr, room: Int) {
  let cap: Int = st.load(fromByteOffset: 32)
  let end: Int = st.load(fromByteOffset: 24)
  if cap - end >= room {
    return
  }
  let buf: RawPtr = st.load(fromByteOffset: 8)
  let head: Int = st.load(fromByteOffset: 16)
  var ncap = 8192
  if cap > 0 {
    ncap = cap * 2
  }
  let nbuf = RawPtr.alloc(bytes: ncap, align: 8)
  if end > head {
    nbuf.copyBytes(from: buf.advanced(by: head), byteCount: end - head)
  }
  if !buf.isNull {
    buf.free()
  }
  st.store(nbuf, toByteOffset: 8)
  st.store(0, toByteOffset: 16)
  st.store(end - head, toByteOffset: 24)
  st.store(ncap, toByteOffset: 32)
}

// Register the one-shot read event for stdin on the poller's kqueue. A `struct kevent` (32 bytes): ident at
// 0, filter (int16) at 8, flags (uint16) at 10, fflags (uint32) at 12, data at 16, udata at 24. EVFILT_READ
// is -1; flags are EV_ADD (0x1) | EV_ONESHOT (0x10).
fun rtStdinArm(st: RawPtr) {
  let ev = RawPtr.alloc(bytes: 32, align: 8)
  ev.store(0, toByteOffset: 0)
  ev.store(1179647, toByteOffset: 8)   // filter 0xFFFF, flags 0x0011, fflags 0
  ev.store(0, toByteOffset: 16)
  ev.store(0, toByteOffset: 24)
  let kq: Int = st.load(fromByteOffset: 64)
  Runtime.kevent(kq: kq, changes: ev, nchanges: 1, events: RawPtr.null, nevents: 0)
  ev.free()
}

// Start the poller thread once: the first waiter to win the flag creates the kqueue and the thread. Called
// with the stdin lock held, so the kqueue exists before any waiter arms it.
fun rtStdinPollerStart(st: RawPtr) {
  let started: Int = st.load(fromByteOffset: 72)
  if started != 0 {
    return
  }
  st.store(1, toByteOffset: 72)
  st.store(Runtime.kqueue(), toByteOffset: 64)
  Runtime.threadCreate(handle: st.advanced(by: 80), entry: Runtime.ofFunc(rtStdinPollerMain), arg: st)
}

// The poller thread: block in kevent until stdin is readable, then take every waiter and unpark it. Runs
// for the life of the process.
fun rtStdinPollerMain(st: RawPtr) -> RawPtr {
  rtFaultThreadStart(4, 0)
  let evs = RawPtr.alloc(bytes: 32 * 8, align: 8)
  while true {
    let kq: Int = st.load(fromByteOffset: 64)
    let n = Runtime.kevent(kq: kq, changes: RawPtr.null, nchanges: 0, events: evs, nevents: 8)
    if n > 0 {
      rtSchedMutexLockAt(st)
      var first: RawPtr = st.load(fromByteOffset: 48)
      st.store(RawPtr.null, toByteOffset: 48)
      st.store(0, toByteOffset: 56)
      // Claim each select waiter under the lock, dropping those another case already won: a dropped one's
      // record may be freed once the lock is released.
      var prev = RawPtr.null
      var c = first
      while !c.isNull {
        let nx: RawPtr = c.load(fromByteOffset: 8)
        let tag: RawPtr = c.load(fromByteOffset: 0)
        var keep = true
        if (tag.toInt() & 1) == 1 {
          let sel = tag.advanced(by: -1)
          let was: Int = sel.atomicCas(0, 1, atByteOffset: 8)
          if was == 0 {
            let index: Int = c.load(fromByteOffset: 56)
            sel.store(index, toByteOffset: 16)
            c.store(1, toByteOffset: 40)
          } else {
            keep = false
          }
        }
        if keep {
          prev = c
        } else if prev.isNull {
          first = nx
        } else {
          prev.store(nx, toByteOffset: 8)
        }
        c = nx
      }
      rtSchedMutexUnlockAt(st)
      var w = first
      while !w.isNull {
        let nx: RawPtr = w.load(fromByteOffset: 8)
        let tag: RawPtr = w.load(fromByteOffset: 0)
        if (tag.toInt() & 1) == 1 {
          let sel = tag.advanced(by: -1)
          rtSchedMutexLockAt(sel)
          rtSchedMutexUnlockAt(sel)
          let fib: RawPtr = sel.load(fromByteOffset: 24)
          rtSchedUnpark(rtSched, fib)
        } else {
          rtSchedUnpark(rtSched, w.load(fromByteOffset: 0))
          w.free()
        }
        w = nx
      }
    }
  }
  return st
}

// ---- Standard output (tasks 271, 270) ----
// `print` and `putByte` copy into a buffer the runtime owns, for every fiber, as libc's `stdout` is. A full buffer,
// a line ended on a terminal (libc's line buffering), and what is left at the program's end go on a queue of
// chunks, and whoever holds the write lock writes the queue out, in order, with `write`. The buffer's lock is held
// only to copy and to queue, never across the `write`: a fiber that may block in `write` (a full pipe) has its
// bytes copied already, holds no managed address, and marks itself in C (rtEnterC), so a stop-the-world goes on
// without it; a fiber waiting for the write lock waits in C too. Copying keeps managed memory out of the call
// that can block: a collection may move a `String` while its bytes are written. At the program's end (its exit,
// a fatal error, a crash: nomuOutFlushAtExit) what is buffered and queued goes out unless another thread holds a
// lock, where waiting could hang the end. A normal end (main returned: nomuOutFlushAtEnd) waits for the locks
// instead, as Go's `main` blocks in its own write: a fiber blocked in `write` finishes, and the rest follows it.
// stderr is not buffered.
//
// rtOut: 0 the buffer's lock (a futex mutex word) · 8 the current chunk, null until first use · 24 whether stdout
// is a terminal: 0 not yet known, 1 a terminal, 2 not · 32 the write lock (a futex mutex word) · 40 the queue's
// head · 48 its tail. A chunk: 0 the next queued · 8 its length · 16 its bytes, rtOutCap of them, or more for one
// `print` larger than that.
let rtOut = Runtime.staticStorage(bytes: 64, align: 8)
let rtOutCap = 65536

fun rtOutChunk(bytes: Int) -> RawPtr {
  let c = RawPtr.alloc(bytes: 16 + bytes, align: 8)
  c.store(RawPtr.null, toByteOffset: 0)
  c.store(0, toByteOffset: 8)
  return c
}

// Whether stdout is a terminal, asked once.
fun rtOutTerminal() -> Bool {
  var t: Int = rtOut.load(fromByteOffset: 24)
  if t == 0 {
    t = 2
    if Runtime.isTerminal(fd: 1) != 0 {
      t = 1
    }
    rtOut.store(t, toByteOffset: 24)
  }
  return t == 1
}

// Queue chunk `c`, the buffer's lock held.
fun rtOutEnqueue(c: RawPtr) {
  let tail: RawPtr = rtOut.load(fromByteOffset: 48)
  if tail.isNull {
    rtOut.store(c, toByteOffset: 40)
  } else {
    tail.store(c, toByteOffset: 0)
  }
  rtOut.store(c, toByteOffset: 48)
}

// Queue the current chunk if it holds anything, the buffer's lock held; a fresh one becomes current on next use.
fun rtOutQueueCurrent() {
  let c: RawPtr = rtOut.load(fromByteOffset: 8)
  if c.isNull == false {
    let len: Int = c.load(fromByteOffset: 8)
    if len > 0 {
      rtOutEnqueue(c)
      rtOut.store(RawPtr.null, toByteOffset: 8)
    }
  }
}

// The current chunk with room for `n` more bytes (n at most rtOutCap), the buffer's lock held: a full one is
// queued and a fresh one made.
fun rtOutRoom(n: Int) -> RawPtr {
  var c: RawPtr = rtOut.load(fromByteOffset: 8)
  if c.isNull == false {
    let len: Int = c.load(fromByteOffset: 8)
    if len + n > rtOutCap {
      rtOutEnqueue(c)
      c = RawPtr.null
    }
  }
  if c.isNull {
    c = rtOutChunk(rtOutCap)
    rtOut.store(c, toByteOffset: 8)
  }
  return c
}

// After bytes ending with `last` went into the current chunk, the buffer's lock held: on a terminal a line goes
// out as it ends. Returns whether anything is queued.
fun rtOutAfter(last: Int) -> Bool {
  if last == 10 && rtOutTerminal() {
    rtOutQueueCurrent()
  }
  let head: RawPtr = rtOut.load(fromByteOffset: 40)
  return head.isNull == false
}

// Write `n` bytes at `p` to stdout, whatever `write` takes at a time; stops at an error.
fun rtOutWrite(p: RawPtr, n: Int) {
  var off = 0
  while off < n {
    let w = Runtime.writeFd(fd: 1, buf: p.advanced(by: off), count: n - off)
    if w <= 0 {
      return
    }
    off = off + w
  }
}

// Write the queue out, holding the write lock, taking each chunk under the buffer's lock. Called with neither lock
// held.
fun rtOutDrainLocked() {
  var go = true
  while go {
    rtSchedMutexLockAt(rtOut)
    let c: RawPtr = rtOut.load(fromByteOffset: 40)
    if c.isNull == false {
      let next: RawPtr = c.load(fromByteOffset: 0)
      rtOut.store(next, toByteOffset: 40)
      if next.isNull {
        rtOut.store(RawPtr.null, toByteOffset: 48)
      }
    }
    rtSchedMutexUnlockAt(rtOut)
    if c.isNull {
      go = false
    } else {
      let len: Int = c.load(fromByteOffset: 8)
      rtOutWrite(c.advanced(by: 16), len)
      c.free()
    }
  }
}

// Write the queue out from a fiber whose frames are anchored at (anchorSp, anchorPc), in C while it waits for the
// write lock and writes (rtEnterC). Its bytes are copied already; it holds no managed address.
fun rtOutDrain(anchorSp: RawPtr, anchorPc: Int) {
  let regs = RawPtr.alloc(bytes: 224, align: 16)
  Runtime.saveContext(regs: regs)                  // from this frame, live until rtExitC
  let inC = rtEnterC(anchorSp, anchorPc, regs)
  rtSchedMutexLockAt(rtOut.advanced(by: 32))
  rtOutDrainLocked()
  rtSchedMutexUnlockAt(rtOut.advanced(by: 32))
  if inC {
    rtExitC()
  }
  regs.free()
}

// `n` bytes at `p`, from compiled code through `__nomu_out_bytes`, which anchors the caller's frame. The bytes are
// copied before any write.
fun nomuOutBytes(sched: RawPtr, p: RawPtr, n: Int, anchorSp: RawPtr, anchorPc: Int) {
  if n <= 0 {
    return
  }
  rtSchedMutexLockAt(rtOut)
  var queued = false
  if n > rtOutCap {
    rtOutQueueCurrent()
    let big = rtOutChunk(n)
    big.advanced(by: 16).copyBytes(from: p, byteCount: n)
    big.store(n, toByteOffset: 8)
    rtOutEnqueue(big)
    queued = true
  } else {
    let c = rtOutRoom(n)
    let len: Int = c.load(fromByteOffset: 8)
    c.advanced(by: 16 + len).copyBytes(from: p, byteCount: n)
    c.store(len + n, toByteOffset: 8)
    let lastByte: UInt8 = p.load(fromByteOffset: n - 1)
    queued = rtOutAfter(lastByte.int)
  }
  if queued == false {
    let head: RawPtr = rtOut.load(fromByteOffset: 40)
    queued = head.isNull == false
  }
  rtSchedMutexUnlockAt(rtOut)
  if queued {
    rtOutDrain(anchorSp, anchorPc)
  }
}

// One byte, through `__nomu_out_byte`.
fun nomuOutByte(sched: RawPtr, b: Int, anchorSp: RawPtr, anchorPc: Int) {
  rtSchedMutexLockAt(rtOut)
  let c = rtOutRoom(1)
  let len: Int = c.load(fromByteOffset: 8)
  c.store((b % 256).uint8, toByteOffset: 16 + len)
  c.store(len + 1, toByteOffset: 8)
  let queued = rtOutAfter(b % 256)
  rtSchedMutexUnlockAt(rtOut)
  if queued {
    rtOutDrain(anchorSp, anchorPc)
  }
}

// `v` in decimal, signed (`%lld`), through `__nomu_out_int`.
fun nomuOutInt(sched: RawPtr, v: Int, anchorSp: RawPtr, anchorPc: Int) {
  rtOutNumber(v, false, anchorSp, anchorPc)
}

// `v`'s 64 bits in decimal, unsigned (`%llu`), through `__nomu_out_uint`.
fun nomuOutUInt(sched: RawPtr, v: Int, anchorSp: RawPtr, anchorPc: Int) {
  rtOutNumber(v, true, anchorSp, anchorPc)
}

fun rtOutNumber(v: Int, unsigned: Bool, anchorSp: RawPtr, anchorPc: Int) {
  rtSchedMutexLockAt(rtOut)
  let c = rtOutRoom(20)
  let len: Int = c.load(fromByteOffset: 8)
  c.store(len + rtOutDecimal(c.advanced(by: 16 + len), v, unsigned), toByteOffset: 8)
  let head: RawPtr = rtOut.load(fromByteOffset: 40)
  rtSchedMutexUnlockAt(rtOut)
  if head.isNull == false {
    rtOutDrain(anchorSp, anchorPc)
  }
}

// `v` in decimal at `at` (at most 20 bytes), its bits unsigned when `unsigned`; returns the length.
fun rtOutDecimal(at: RawPtr, v: Int, unsigned: Bool) -> Int {
  if unsigned && v < 0 {
    // Above Int's range: the bits divided by 10 as the logical shift by one, divided by 5; the last digit is what
    // remains, in 0...9 once the product wraps.
    let q = ((v >> 1) & 9223372036854775807) / 5
    let r = v - q * 10
    let n = rtOutSigned(at, q)
    at.store((48 + r).uint8, toByteOffset: n)
    return n + 1
  }
  return rtOutSigned(at, v)
}

// `v` in decimal at `at`, signed; returns the length. Digits are taken from the value made negative, so the most
// negative Int needs no special case.
fun rtOutSigned(at: RawPtr, v: Int) -> Int {
  var neg = v
  var sign = 0
  if v < 0 {
    sign = 1
  } else {
    neg = 0 - v
  }
  var digits = 1
  var t = neg / 10
  while t != 0 {
    digits = digits + 1
    t = t / 10
  }
  if sign == 1 {
    at.store(45.uint8, toByteOffset: 0)
  }
  var i = sign + digits - 1
  var x = neg
  while i >= sign {
    at.store((48 - x % 10).uint8, toByteOffset: i)
    x = x / 10
    i = i - 1
  }
  return sign + digits
}

// At a normal end, after `main` returns (rtSchedFinish): what is buffered and queued goes out, waiting for a fiber
// still copying or writing. A detached fiber still running may print after it; the exit's flush
// (nomuOutFlushAtExit) takes what it can of that, as Go drops a goroutine's output once `main` returns.
fun nomuOutFlushAtEnd() {
  rtSchedMutexLockAt(rtOut)
  rtOutQueueCurrent()
  rtSchedMutexUnlockAt(rtOut)
  rtSchedMutexLockAt(rtOut.advanced(by: 32))
  rtOutDrainLocked()
  rtSchedMutexUnlockAt(rtOut.advanced(by: 32))
}

// At the program's end (exit, a fatal error, a crash): what is buffered and queued goes out, unless another
// thread holds a lock (a crash inside a print, or a write blocked), where waiting could hang the end.
fun nomuOutFlushAtExit() {
  if rtOut.atomicCas(0, 1, atByteOffset: 0) != 0 {
    return
  }
  rtOutQueueCurrent()
  rtSchedMutexUnlockAt(rtOut)
  if rtOut.atomicCas(0, 1, atByteOffset: 32) != 0 {
    return
  }
  rtOutDrainLocked()
  rtSchedMutexUnlockAt(rtOut.advanced(by: 32))
}
