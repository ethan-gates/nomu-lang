// Nomu runtime prelude — the privileged, self-hosted runtime tier, compiled into every program ahead of
// user code (like the core prelude, but distinct). Every function here is runtime-subset by default
// (task 149): it may not trigger an implicit GC allocation or call outside the subset + raw-memory
// allowlist. This is the interim "designated file" the runtime-subset rules attach to until the module
// system (task 100) makes it a designated module. The self-hosted GC/allocator (task 150) lives here.
//
// Bump allocator (task 150 · rung 1). State lives in a RawPtr control block — metadata in the arena, no
// globals, no heap object. NoGC: it never frees and the heap only grows.
// Control block (24 bytes): { base: RawPtr @0, cursor: Int @8, limit: Int @16 }.

fun rtArenaNew(size: Int) -> RawPtr {
  let ctl = RawPtr.alloc(bytes: 24, align: 8)
  let data = RawPtr.alloc(bytes: size, align: 8)
  ctl.store(data, toByteOffset: 0)     // base
  ctl.store(0, toByteOffset: 8)        // cursor (bytes used)
  ctl.store(size, toByteOffset: 16)    // limit
  return ctl
}

// Bump `n` bytes off the arena; returns the chunk, or RawPtr.null when the block is full.
fun rtBumpAlloc(ctl: RawPtr, n: Int) -> RawPtr {
  let raw: Int = ctl.load(fromByteOffset: 8)
  let bumped = raw + 7
  let slots = bumped / 8
  let cursor = slots * 8                     // 8-align the object start (headers are i64)
  let limit: Int = ctl.load(fromByteOffset: 16)
  if cursor + n > limit {
    return RawPtr.null
  }
  let base: RawPtr = ctl.load(fromByteOffset: 0)
  let obj = base.advanced(by: cursor)
  ctl.store(cursor + n, toByteOffset: 8)
  return obj
}

// Mark-verify tracer (task 150 · rung 2). Trace the live set from a seed root and mark each reachable
// object, without reclaiming or moving anything (the NoGC heap only grows). The mark lives in the object
// header: the 8-byte header holds the type-id in its low 32 bits with the high bits zero, so setting bit
// 32 (adding 2^32) marks the object and leaves the type-id recoverable. Subset code — RawPtr plus the
// gc-leaf type-table reads, no managed allocation. The object model is read through the same per-type-id
// tables the MMTk binding reads (c-types.md §1/§3.2): a fixed object scans its managed-offset map; an
// array buffer { header, cap, elems } scans the per-element map at each of `cap` slots.
//
// 2^32 = 4294967296 (no grouping parens yet, task 114 — kept as intermediate `let`s).

// The type-id of an object, with any mark bit removed.
fun rtObjTypeId(obj: RawPtr) -> Int {
  let h: Int = obj.load(fromByteOffset: 0)
  let hi = h / 4294967296
  let lo = hi * 4294967296
  return h - lo
}

// The address-independent content hash of one object: fold its type-id and its scalar (non-pointer) field
// words into a 64-bit polynomial hash, skipping the header and every managed-pointer slot (so no raw
// address enters the hash). A fixed object scans words in [8, size); an array buffer scans its `cap` word
// then each element's non-managed words. Word granularity — fields are 8-byte aligned (sub-word scalars
// are a later refinement). This is the per-object term the mark-verify fingerprint sums (§6/§9).
fun rtObjHash(obj: RawPtr, tid: Int) -> Int {
  let prime = 1099511628211
  var h = tid + 1
  h = h * prime
  let kind = RawPtr.gcTypeKind(tid)
  let nptr = RawPtr.gcTypeNumPtrs(tid)
  if kind == 0 {
    let size = RawPtr.gcTypeSize(tid)
    var w = 8
    while w < size {
      var managed = false
      var i = 0
      while i < nptr {
        let off = RawPtr.gcTypePtrOffset(tid, i)
        if off == w {
          managed = true
        }
        i = i + 1
      }
      if !managed {
        let word: Int = obj.load(fromByteOffset: w)
        h = h * prime
        h = h + word
      }
      w = w + 8
    }
  } else {
    let ecap: Int = obj.load(fromByteOffset: 8)      // array buffer: { header, cap, elems… }
    h = h * prime
    h = h + ecap
    let stride = RawPtr.gcTypeStride(tid)
    var e = 0
    while e < ecap {
      let elemBase = 16 + e * stride
      var w = 0
      while w < stride {
        var managed = false
        var i = 0
        while i < nptr {
          let off = RawPtr.gcTypePtrOffset(tid, i)
          if off == w {
            managed = true
          }
          i = i + 1
        }
        if !managed {
          let at = elemBase + w
          let word: Int = obj.load(fromByteOffset: at)
          h = h * prime
          h = h + word
        }
        w = w + 8
      }
      e = e + 1
    }
  }
  return h
}

// Mark `obj` if not already marked, tallying its type into `counts` and folding its content hash into the
// running fingerprint `fp` (a summed, order-independent aggregate). Returns true when newly marked.
fun rtTryMark(obj: RawPtr, counts: RawPtr, fp: RawPtr) -> Bool {
  let h: Int = obj.load(fromByteOffset: 0)
  let hi = h / 4294967296
  if hi > 0 {
    return false
  }
  let tid = h                              // unmarked ⇒ high bits zero ⇒ header == type-id
  let marked = h + 4294967296
  obj.store(marked, toByteOffset: 0)
  let slot = tid * 8
  let c: Int = counts.load(fromByteOffset: slot)
  counts.store(c + 1, toByteOffset: slot)
  let oh = rtObjHash(obj, tid)
  let f: Int = fp.load(fromByteOffset: 0)
  fp.store(f + oh, toByteOffset: 0)
  return true
}

// Trace from `root`, marking the transitive live set and tallying per-type-id live counts into `counts`
// (a caller-sized, zeroed Int array indexed by type-id). Returns the total number of live objects.
fun rtMarkVerify(root: RawPtr, counts: RawPtr, fp: RawPtr) -> Int {
  let cap = 1048576
  let bytes = cap * 8
  let work = RawPtr.alloc(bytes: bytes, align: 8)
  var top = 0
  let rootNull = root.eq(RawPtr.null)
  if !rootNull {
    if rtTryMark(root, counts, fp) {
      work.store(root, toByteOffset: 0)
      top = 1
    }
  }
  while top > 0 {
    top = top - 1
    let slot = top * 8
    let obj: RawPtr = work.load(fromByteOffset: slot)
    let tid = rtObjTypeId(obj)
    let kind = RawPtr.gcTypeKind(tid)
    let nptr = RawPtr.gcTypeNumPtrs(tid)
    if kind == 0 {
      var i = 0
      while i < nptr {
        let off = RawPtr.gcTypePtrOffset(tid, i)
        let child: RawPtr = obj.load(fromByteOffset: off)
        let childNull = child.eq(RawPtr.null)
        if !childNull {
          if rtTryMark(child, counts, fp) {
            let dst = top * 8
            work.store(child, toByteOffset: dst)
            top = top + 1
          }
        }
        i = i + 1
      }
    } else {
      let ecap: Int = obj.load(fromByteOffset: 8)       // array buffer: { header, cap, elems… }
      let stride = RawPtr.gcTypeStride(tid)
      var e = 0
      while e < ecap {
        let elemBase = 16 + e * stride
        var i = 0
        while i < nptr {
          let off = RawPtr.gcTypePtrOffset(tid, i)
          let at = elemBase + off
          let child: RawPtr = obj.load(fromByteOffset: at)
          let childNull = child.eq(RawPtr.null)
          if !childNull {
            if rtTryMark(child, counts, fp) {
              let dst = top * 8
              work.store(child, toByteOffset: dst)
              top = top + 1
            }
          }
          i = i + 1
        }
        e = e + 1
      }
    }
  }
  work.free()
  let tcount = RawPtr.gcTypeCount()
  var total = 0
  var t = 0
  while t < tcount {
    let c: Int = counts.load(fromByteOffset: t * 8)
    total = total + c
    t = t + 1
  }
  return total
}

// ---- Stack-map parsing (task 150 · rung 2, the pcsp root walk) ----
// Parse the `__llvm_stackmaps` (v3) section — reached libc-free via the linker section-bracket symbols
// (RawPtr.gcStackmapBase / gcStackmapSize) — to recover, per statepoint, its return address, its
// SP/FP-relative root slots, and its function's frame size. Format: llvm/Object/StackMapParser.h; the C
// runtime parses the same bytes in `nomu_gc_stackmap_init`. Little-endian scalar reads: load 8 bytes and
// take the low 16/32 bits by modulo (2^16 = 65536, 2^32 = 4294967296 — no grouping parens yet, task 114).

fun rtU16(base: RawPtr, off: Int) -> Int {
  let w: Int = base.load(fromByteOffset: off)
  let hi = w / 65536
  return w - hi * 65536
}
fun rtU32(base: RawPtr, off: Int) -> Int {
  let w: Int = base.load(fromByteOffset: off)
  let hi = w / 4294967296
  return w - hi * 4294967296
}
fun rtAlign8(x: Int) -> Int {
  let a = x + 7
  return a / 8 * 8
}

// Parse the whole structure and return the byte offset one past the last record. A structural self-check:
// it equals the section size exactly when every record's variable length was computed correctly. Header
// (16 bytes) + nfuncs StkSizeRecords (24 each) + nconsts constants (8 each), then nrecs records:
//   +0 u64 id, +8 u32 instr-offset, +14 u16 NumLocations, +16 locations (12 each), align8,
//   then u16 NumLiveOuts, live-outs (4 each), align8.
fun rtStackmapEnd() -> Int {
  let base = RawPtr.gcStackmapBase()
  let nfuncs = rtU32(base, 4)
  let nconsts = rtU32(base, 8)
  let nrecs = rtU32(base, 12)
  var cur = 16 + nfuncs * 24 + nconsts * 8
  var k = 0
  while k < nrecs {
    let nloc = rtU16(base, cur + 14)
    let locBytes = 16 + nloc * 12
    let locEnd = rtAlign8(locBytes)
    let nlive = rtU16(base, cur + locEnd)
    let recBytes = locEnd + 2 + nlive * 4
    let recSize = rtAlign8(recBytes)
    cur = cur + recSize
    k = k + 1
  }
  return cur
}

// A signed 32-bit read (stack-slot offsets are signed — FP-relative slots are typically negative).
fun rtI32(base: RawPtr, off: Int) -> Int {
  let u = rtU32(base, off)
  let half = 2147483648
  if u >= half {
    return u - 4294967296
  }
  return u
}

// ---- The pcsp stack walk (task 150 · rung 2) — recover the live roots from a stack ----
// Walk outward one frame at a time, reading each frame's root slots from its stackmap record and stepping
// to the caller by the frame's recorded size. Frame-pointer-free: SP is tracked and advanced by the
// per-function StackSize (the pcsp route, §9). arm64/Mach-O layout — a frame's { saved FP, saved LR } pair
// sits at CFA-16, so with CFA = SP + StackSize the caller's return address is at CFA-8 and the frame pointer
// (for FP-relative slots) is CFA-16.
// Recover the live roots from the current stack, from index `n0`, into `outBuf` (up to `cap`). Anchor on
// rtCollectRoots's caller frame: its SP is this frame's CFA (FP + 16), its PC is our return address — then
// walk outward one frame at a time via the pcsp route (§9), terminating at the first return address with no
// stackmap record (the Nomu→C boundary). Subset code (no managed heap).
//
// The frame-reading loop is deliberately kept in this one function (not factored behind a call): the walk
// reads root slots through a pointer derived from `llvm.frameaddress`, and that memory effect appearing in
// the same function the caller calls is what makes the optimizer keep the *caller's* live GC roots spilled
// at the call statepoint (where the walk reads them). Moving the loop behind an ordinary call drops that
// effect and the caller stops spilling its roots — they vanish from the statepoint (task 150 rung 2).
fun rtCollectRoots(outBuf: RawPtr, cap: Int) -> Int {
  let base = RawPtr.gcStackmapBase()
  let nfuncs = rtU32(base, 4)
  let nconsts = rtU32(base, 8)
  let recStart = 16 + nfuncs * 24 + nconsts * 8
  var n = 0
  let fp0 = RawPtr.gcFrameAddr()
  var sp = fp0.advanced(by: 16)
  var pc = RawPtr.gcReturnAddr()
  var walking = true
  while walking {
    var found = false
    var frameSize = 0
    var recCur = recStart
    var fi = 0
    while fi < nfuncs {
      let fRec = 16 + fi * 24
      let funcAddr: Int = base.load(fromByteOffset: fRec)
      let fStackSize: Int = base.load(fromByteOffset: fRec + 8)
      let recCount: Int = base.load(fromByteOffset: fRec + 16)
      var ri = 0
      while ri < recCount {
        let ioff = rtU32(base, recCur + 8)
        let retAddr = funcAddr + ioff
        let nloc = rtU16(base, recCur + 14)
        let locEnd = rtAlign8(16 + nloc * 12)
        let nlive = rtU16(base, recCur + locEnd)
        let recSize = rtAlign8(locEnd + 2 + nlive * 4)
        if retAddr == pc {
          found = true
          frameSize = fStackSize
          let frameFp = sp.advanced(by: fStackSize - 16)
          var li = 3                              // skip the 3 leading meta locations
          while li < nloc {
            let locOff = recCur + 16 + li * 12
            let w0: Int = base.load(fromByteOffset: locOff)
            let kind = w0 - w0 / 256 * 256          // u8 kind at +0
            if kind == 3 {                          // Indirect [reg + offset] — a stack slot
              let reg = rtU16(base, locOff + 4)
              let slotOff = rtI32(base, locOff + 8)
              var slotBase = sp
              if reg == 29 {                        // DWARF x29 = frame pointer
                slotBase = frameFp
              }
              let slotPtr = slotBase.advanced(by: slotOff)
              let root: RawPtr = slotPtr.load(fromByteOffset: 0)
              let rootNull = root.eq(RawPtr.null)
              if !rootNull {
                if n < cap {
                  outBuf.store(root, toByteOffset: n * 8)
                  n = n + 1
                }
              }
            }
            li = li + 1
          }
        }
        recCur = recCur + recSize
        ri = ri + 1
      }
      fi = fi + 1
    }
    if !found {
      walking = false
    } else {
      let cfa = sp.advanced(by: frameSize)
      let nextPc: Int = cfa.load(fromByteOffset: -8)
      pc = nextPc
      sp = cfa
    }
  }
  return n
}

// ---- Parked-fiber root scan (task 128.3.1) ----
// Scan every parked fiber's stack for GC roots. The C runtime hands us each parked fiber's innermost Nomu
// frame anchor as a (sp, pc) pair (`rt_gc_parked_anchors`) — it crosses the C park frames (swapcontext /
// `rt_sleep_ms`) with its unwinder, which is unavoidable while parking goes through Darwin's asm
// `swapcontext` (no clean frame-pointer chain, no pcsp table for C frames). From each Nomu anchor the pcsp
// walk (`rtWalkFrom`) reads root slots and steps between Nomu frames self-hosted. Oracle: the C
// `nomu_gc_scan_parked_fibers` walk (`gc-smoke-parked` shape), diffed in-process. A fully self-hosted entry
// waits on the self-hosted context switch (128.1); driving this at a real STW over all mutators is 128.3.2.

// The pcsp walk from an explicit (sp, pc) anchor over a *saved* context — a parked fiber now, an STW-stopped
// carrier later — appending live root object addresses into `outBuf` (up to `cap`, from index `n0`), one
// Nomu frame at a time, terminating at the first return address with no record (the Nomu→C boundary).
//
// This is a deliberate copy of rtCollectRoots's loop, not a call from it: rtCollectRoots reads root slots
// through an `llvm.frameaddress`-derived pointer, and that memory effect must appear in the frameaddress
// function's own body to make its live caller spill its roots at the call statepoint (selfhosted-gc.md §9).
// A saved-context anchor carries no such dependency — its frame's roots were already spilled at the fiber's
// park/safepoint — so factoring the loop here is sound; only rtCollectRoots must keep it inline.
fun rtWalkFrom(spIn: RawPtr, pcIn: Int, outBuf: RawPtr, n0: Int, cap: Int) -> Int {
  let base = RawPtr.gcStackmapBase()
  let nfuncs = rtU32(base, 4)
  let nconsts = rtU32(base, 8)
  let recStart = 16 + nfuncs * 24 + nconsts * 8
  var n = n0
  var sp = spIn
  var pc = pcIn
  var walking = true
  while walking {
    var found = false
    var frameSize = 0
    var recCur = recStart
    var fi = 0
    while fi < nfuncs {
      let fRec = 16 + fi * 24
      let funcAddr: Int = base.load(fromByteOffset: fRec)
      let fStackSize: Int = base.load(fromByteOffset: fRec + 8)
      let recCount: Int = base.load(fromByteOffset: fRec + 16)
      var ri = 0
      while ri < recCount {
        let ioff = rtU32(base, recCur + 8)
        let retAddr = funcAddr + ioff
        let nloc = rtU16(base, recCur + 14)
        let locEnd = rtAlign8(16 + nloc * 12)
        let nlive = rtU16(base, recCur + locEnd)
        let recSize = rtAlign8(locEnd + 2 + nlive * 4)
        if retAddr == pc {
          found = true
          frameSize = fStackSize
          let frameFp = sp.advanced(by: fStackSize - 16)
          var li = 3
          while li < nloc {
            let locOff = recCur + 16 + li * 12
            let w0: Int = base.load(fromByteOffset: locOff)
            let kind = w0 - w0 / 256 * 256
            if kind == 3 {
              let reg = rtU16(base, locOff + 4)
              let slotOff = rtI32(base, locOff + 8)
              var slotBase = sp
              if reg == 29 {
                slotBase = frameFp
              }
              let slotPtr = slotBase.advanced(by: slotOff)
              let root: RawPtr = slotPtr.load(fromByteOffset: 0)
              let rootNull = root.eq(RawPtr.null)
              if !rootNull {
                if n < cap {
                  outBuf.store(root, toByteOffset: n * 8)
                  n = n + 1
                }
              }
            }
            li = li + 1
          }
        }
        recCur = recCur + recSize
        ri = ri + 1
      }
      fi = fi + 1
    }
    if !found {
      walking = false
    } else {
      let cfa = sp.advanced(by: frameSize)
      let nextPc: Int = cfa.load(fromByteOffset: -8)
      pc = nextPc
      sp = cfa
    }
  }
  return n
}

// Scan every parked fiber, appending its live roots into `outBuf` (up to `cap`). Returns the total. The C
// runtime hands each parked fiber's innermost Nomu frame anchor as a (sp, pc) pair (`rt_gc_parked_anchors`,
// crossing the C park frames with its unwinder); `rtWalkFrom` runs the pcsp walk from each, self-hosted.
fun rtScanParkedFibers(outBuf: RawPtr, cap: Int) -> Int {
  let anchorCap = 128
  let anchors = RawPtr.alloc(bytes: anchorCap * 8, align: 8)
  let nf = RawPtr.gcParkedAnchors(anchors, anchorCap)
  var n = 0
  var i = 0
  while i < nf {
    let sp: RawPtr = anchors.load(fromByteOffset: i * 16)
    let pc: Int = anchors.load(fromByteOffset: i * 16 + 8)
    n = rtWalkFrom(sp, pc, outBuf, n, cap)
    i = i + 1
  }
  anchors.free()
  return n
}

// ---- Immix region substrate (task 150 · rung 3, increment 150.3.1) ----
// The block/line region structure + side metadata tables over 125 off-heap memory: the geometry, the
// addr↔index math, and the block/line state a collector reads and writes. No allocation policy or
// collection yet (those are 150.3.2+). Geometry matches MMTk Immix (selfhosted-gc.md §10.1): a 32768-byte
// block, a 256-byte line, 128 lines per block. Metadata lives in side tables keyed by block/line index
// (§10.2, Decided), one byte per entry, over the reserved heap range. Entry value 0 is the initial state
// (block FREE / line unmarked), and rt_raw_alloc zero-fills, so the fresh tables start correct.
//
// Space descriptor (120 bytes):
//   { heapBase: RawPtr @0, numBlocks: Int @8, lineTable: RawPtr @16, blockTable: RawPtr @24,
//     freeCursor: Int @32, heapBaseInt: Int @40, allocCursor: Int @48, allocLimit: Int @56,
//     losHead: RawPtr @64, allocBlock: Int @72, allocLine: Int @80, freeList: RawPtr @88,
//     freeListTop: Int @96, scanBlock: Int @104, defragTable: RawPtr @112 }.
// allocCursor/allocLimit are heap-relative byte offsets bounding the current hole (0/0 → refill). freeCursor
// bumps never-used blocks. allocBlock/allocLine track the block being filled + its next line to scan for
// holes (allocBlock −1 = none). freeList is a stack of reclaimed empty block indices (freeListTop entries).
// scanBlock is the next block index the allocator scans for a recyclable block. losHead is the large-object
// list. defragTable is a per-block side table holding each block's live-line count from the last sweep — the
// fragmentation histogram the defrag trigger (150.3.8) selects evacuation sources from (§10.6). Block state
// byte: 0 FREE, 1 RECYCLABLE, 2 UNAVAILABLE, 3 DEFRAG_SOURCE (transient: a block selected for evacuation this
// collection, overwritten by the sweep). Line mark byte: 0 unmarked, 1 marked.

// Reserve a heap of `numBlocks` 32 KiB blocks + its side tables; return the space descriptor.
fun rtImmixNew(numBlocks: Int) -> RawPtr {
  let block = 32768
  let heapBytes = numBlocks * block
  let heap = RawPtr.alloc(bytes: heapBytes, align: block)
  let lineBytes = numBlocks * 128
  let lineTable = RawPtr.alloc(bytes: lineBytes, align: 8)
  let blockTable = RawPtr.alloc(bytes: numBlocks, align: 8)
  let freeList = RawPtr.alloc(bytes: numBlocks * 8, align: 8)
  let defragTable = RawPtr.alloc(bytes: numBlocks, align: 8)
  let ctl = RawPtr.alloc(bytes: 120, align: 8)
  ctl.store(heap, toByteOffset: 0)
  ctl.store(numBlocks, toByteOffset: 8)
  ctl.store(lineTable, toByteOffset: 16)
  ctl.store(blockTable, toByteOffset: 24)
  ctl.store(0, toByteOffset: 32)
  let baseInt = heap.toInt()
  ctl.store(baseInt, toByteOffset: 40)
  ctl.store(0, toByteOffset: 48)     // allocCursor
  ctl.store(0, toByteOffset: 56)     // allocLimit
  ctl.store(0, toByteOffset: 64)     // losHead (null)
  ctl.store(-1, toByteOffset: 72)    // allocBlock (none)
  ctl.store(0, toByteOffset: 80)     // allocLine
  ctl.store(freeList, toByteOffset: 88)
  ctl.store(0, toByteOffset: 96)     // freeListTop
  ctl.store(0, toByteOffset: 104)    // scanBlock
  ctl.store(defragTable, toByteOffset: 112)  // per-block last-sweep live-line count (defrag histogram)
  return ctl
}

// The base address of block `bi`.
fun rtBlockAddr(space: RawPtr, bi: Int) -> RawPtr {
  let heap: RawPtr = space.load(fromByteOffset: 0)
  return heap.advanced(by: bi * 32768)
}

// The block index containing `addr` (addr − heapBase) / block.
fun rtBlockIndexOf(space: RawPtr, addr: RawPtr) -> Int {
  let base: Int = space.load(fromByteOffset: 40)
  let a = addr.toInt()
  let d = a - base
  return d / 32768
}

// The global line index containing `addr` (addr − heapBase) / line.
fun rtLineIndexOf(space: RawPtr, addr: RawPtr) -> Int {
  let base: Int = space.load(fromByteOffset: 40)
  let a = addr.toInt()
  let d = a - base
  return d / 256
}

// Block-state accessors (side table, one byte per block).
fun rtBlockState(space: RawPtr, bi: Int) -> Int {
  let tbl: RawPtr = space.load(fromByteOffset: 24)
  let s: UInt8 = tbl.load(fromByteOffset: bi)
  return s.int
}
fun rtSetBlockState(space: RawPtr, bi: Int, state: Int) {
  let tbl: RawPtr = space.load(fromByteOffset: 24)
  tbl.store(state.uint8, toByteOffset: bi)
}

// Line-mark accessors (side table, one byte per line).
fun rtLineMarked(space: RawPtr, li: Int) -> Int {
  let tbl: RawPtr = space.load(fromByteOffset: 16)
  let m: UInt8 = tbl.load(fromByteOffset: li)
  return m.int
}
fun rtMarkLine(space: RawPtr, li: Int) {
  let tbl: RawPtr = space.load(fromByteOffset: 16)
  tbl.store(1.uint8, toByteOffset: li)
}
fun rtClearLine(space: RawPtr, li: Int) {
  let tbl: RawPtr = space.load(fromByteOffset: 16)
  tbl.store(0.uint8, toByteOffset: li)
}

// Hand out the next never-used block from the pool: bump the free cursor, mark the block UNAVAILABLE, and
// return its base — or RawPtr.null when the pool is exhausted. Reuse of swept blocks is 150.3.5; this is
// the fresh-block source the hole-aware allocator (150.3.2) draws from.
fun rtAcquireBlock(space: RawPtr) -> RawPtr {
  let fc: Int = space.load(fromByteOffset: 32)
  let nb: Int = space.load(fromByteOffset: 8)
  if fc >= nb {
    return RawPtr.null
  }
  let addr = rtBlockAddr(space, fc)
  rtSetBlockState(space, fc, 2)
  space.store(fc + 1, toByteOffset: 32)
  return addr
}

// Large-object space (task 150 · rung 3, increment 150.3.3). An object larger than a 32 KiB block cannot
// fit the block allocator, so it is allocated whole off-heap and never moved. Each LOS chunk carries an
// 8-byte link word ahead of the object: { next: RawPtr @0, object: header + payload @8… }. The chunks form
// a singly-linked list off the space's losHead so reclamation (150.3.5) can walk them; rt_raw_alloc
// zero-fills, so the object is zero-initialized like a block object. The object pointer (chunk + 8) is what
// the seam turns into the managed `p1` — codegen never sees the link word.
fun rtLosAlloc(space: RawPtr, need: Int) -> RawPtr {
  let raw = RawPtr.alloc(bytes: need + 8, align: 8)
  let head: RawPtr = space.load(fromByteOffset: 64)
  raw.store(head, toByteOffset: 0)              // link → previous LOS head
  space.store(raw, toByteOffset: 64)            // new head
  return raw.advanced(by: 8)                    // object starts after the link word
}

// Hand out the next never-used block index (bump freeCursor), or −1 when the heap is exhausted. Unlike
// rtAcquireBlock this sets no state and returns an index — the hole-aware allocator manages state.
fun rtAcquireNeverUsed(space: RawPtr) -> Int {
  let fc: Int = space.load(fromByteOffset: 32)
  let nb: Int = space.load(fromByteOffset: 8)
  if fc >= nb {
    return -1
  }
  space.store(fc + 1, toByteOffset: 32)
  return fc
}

// Choose the next block for the allocator to fill (task 150 · rung 3): a reclaimed empty block off the free
// list first, then a recyclable block (has holes) scanned from scanBlock, then a never-used block. Returns
// the block index, or −1 when the heap is exhausted. Reclaimed + recyclable blocks are why the heap does not
// grow when garbage was collected (150.3.5).
fun rtNextAllocBlock(space: RawPtr) -> Int {
  let top: Int = space.load(fromByteOffset: 96)
  if top > 0 {
    let fl: RawPtr = space.load(fromByteOffset: 88)
    let newTop = top - 1
    let bi: Int = fl.load(fromByteOffset: newTop * 8)
    space.store(newTop, toByteOffset: 96)
    return bi
  }
  var sb: Int = space.load(fromByteOffset: 104)
  let fc: Int = space.load(fromByteOffset: 32)
  var found = -1
  var scanning = true
  while scanning {
    if sb >= fc {
      scanning = false
    } else {
      let st = rtBlockState(space, sb)
      if st == 1 {
        found = sb
        sb = sb + 1
        scanning = false
      } else {
        sb = sb + 1
      }
    }
  }
  space.store(sb, toByteOffset: 104)
  if found >= 0 {
    return found
  }
  return rtAcquireNeverUsed(space)
}

// Advance the allocator to the next hole (a run of free/unmarked lines) big enough for `need` bytes, setting
// allocCursor/allocLimit (heap-relative offsets). Scans the current block's line table forward from
// allocLine; on block exhaustion picks the next block (rtNextAllocBlock). Returns false when the heap is
// exhausted. A run too small for `need` is skipped (a fragmentation cost accepted in the first cut). Because
// the line table is the last collection's liveness (a freshly acquired or reclaimed block reads all-free),
// the same scan serves fresh blocks (one whole-block hole) and recyclable blocks (holes between live lines).
fun rtNextHole(space: RawPtr, need: Int) -> Bool {
  var done = false
  var result = false
  while !done {
    let ab: Int = space.load(fromByteOffset: 72)
    if ab < 0 {
      let nb = rtNextAllocBlock(space)
      if nb < 0 {
        done = true
      } else {
        space.store(nb, toByteOffset: 72)
        space.store(0, toByteOffset: 80)
      }
    } else {
      let al: Int = space.load(fromByteOffset: 80)
      if al >= 128 {
        space.store(-1, toByteOffset: 72)      // block exhausted → pick another next iteration
      } else {
        let firstLine = ab * 128
        let gi = firstLine + al
        if rtLineMarked(space, gi) == 1 {
          space.store(al + 1, toByteOffset: 80)
        } else {
          var e = al
          var run = true
          while run {
            if e >= 128 {
              run = false
            } else {
              let ge = firstLine + e
              if rtLineMarked(space, ge) == 1 {
                run = false
              } else {
                e = e + 1
              }
            }
          }
          space.store(e, toByteOffset: 80)     // advance past this run
          let runLines = e - al
          let holeBytes = runLines * 256
          if holeBytes >= need {
            let startOff = ab * 32768 + al * 256
            let endOff = ab * 32768 + e * 256
            space.store(startOff, toByteOffset: 48)
            space.store(endOff, toByteOffset: 56)
            done = true
            result = true
          }
        }
      }
    }
  }
  return result
}

// Allocate `n` bytes of managed object space (task 150 · rung 3). Hole-aware bump: 8-align the request, bump
// within the current hole, and on exhaustion advance to the next hole/block (rtNextHole), reusing reclaimed
// and recyclable space produced by collection (150.3.5). An object larger than a block routes to the
// large-object space (150.3.3). Returns a RawPtr into the heap (or a LOS chunk), or RawPtr.null when the
// heap is exhausted. This is the target the codegen self-hosted-alloc seam routes to under NOMU_GC_PLAN=nomu.
fun rtImmixAlloc(space: RawPtr, n: Int) -> RawPtr {
  let bumped = n + 7
  let need = bumped / 8 * 8
  if need > 32768 {
    return rtLosAlloc(space, need)             // larger than a block → large-object space (150.3.3)
  }
  var done = false
  var result = RawPtr.null
  while !done {
    let cur: Int = space.load(fromByteOffset: 48)
    let lim: Int = space.load(fromByteOffset: 56)
    if cur + need <= lim {
      let heap: RawPtr = space.load(fromByteOffset: 0)
      result = heap.advanced(by: cur)
      space.store(cur + need, toByteOffset: 48)
      done = true
    } else {
      let ok = rtNextHole(space, need)
      if !ok {
        result = RawPtr.null
        done = true
      }
    }
  }
  return result
}

// ---- Line marking (task 150 · rung 3, increment 150.3.4) ----
// A diagnostic checkpoint: extend the tracer to mark the lines each live object spans, before any
// reclamation uses them (150.3.5). Object marking (header bit 32) is unchanged from rung 2; this adds, per
// live object *in the Immix heap*, a mark on every line its bytes occupy. LOS objects (outside the heap
// range) are marked by header bit only — they are reclaimed as whole units, not by line. The line-mark set
// is then verified (rtLineMarkCheck): every live in-heap object sits on marked lines (completeness) and no
// line is marked beyond the live set's footprint (soundness). The rung-2 fingerprint still holds unchanged.

// Mark every line the object [obj, obj+size) occupies. Skips objects outside the Immix heap (LOS/other).
fun rtMarkObjLines(space: RawPtr, obj: RawPtr, size: Int) {
  let base: Int = space.load(fromByteOffset: 40)
  let nb: Int = space.load(fromByteOffset: 8)
  let heapEnd = base + nb * 32768
  let a = obj.toInt()
  if a < base {
    return
  }
  if a >= heapEnd {
    return
  }
  let first = rtLineIndexOf(space, obj)
  let lastAddr = obj.advanced(by: size - 1)
  let last = rtLineIndexOf(space, lastAddr)
  var li = first
  while li <= last {
    rtMarkLine(space, li)
    li = li + 1
  }
}

// Trace from `root` (as rtMarkVerify) and additionally mark each live in-heap object's lines. Objects are
// marked with header bit 32, counted, and folded into the fingerprint exactly as rung 2; line marking is
// the only addition, applied when each object is popped (size from the type tables: fixed size, or
// 16 + cap*stride for a variable-size buffer). Returns the total live count.
fun rtMarkVerifyImmix(space: RawPtr, root: RawPtr, counts: RawPtr, fp: RawPtr) -> Int {
  let cap = 1048576
  let bytes = cap * 8
  let work = RawPtr.alloc(bytes: bytes, align: 8)
  var top = 0
  let rootNull = root.eq(RawPtr.null)
  if !rootNull {
    if rtTryMark(root, counts, fp) {
      work.store(root, toByteOffset: 0)
      top = 1
    }
  }
  while top > 0 {
    top = top - 1
    let slot = top * 8
    let obj: RawPtr = work.load(fromByteOffset: slot)
    let tid = rtObjTypeId(obj)
    let kind = RawPtr.gcTypeKind(tid)
    let nptr = RawPtr.gcTypeNumPtrs(tid)
    if kind == 0 {
      let size = RawPtr.gcTypeSize(tid)
      rtMarkObjLines(space, obj, size)
      var i = 0
      while i < nptr {
        let off = RawPtr.gcTypePtrOffset(tid, i)
        let child: RawPtr = obj.load(fromByteOffset: off)
        let childNull = child.eq(RawPtr.null)
        if !childNull {
          if rtTryMark(child, counts, fp) {
            let dst = top * 8
            work.store(child, toByteOffset: dst)
            top = top + 1
          }
        }
        i = i + 1
      }
    } else {
      let ecap: Int = obj.load(fromByteOffset: 8)
      let stride = RawPtr.gcTypeStride(tid)
      let size = 16 + ecap * stride
      rtMarkObjLines(space, obj, size)
      var e = 0
      while e < ecap {
        let elemBase = 16 + e * stride
        var i = 0
        while i < nptr {
          let off = RawPtr.gcTypePtrOffset(tid, i)
          let at = elemBase + off
          let child: RawPtr = obj.load(fromByteOffset: at)
          let childNull = child.eq(RawPtr.null)
          if !childNull {
            if rtTryMark(child, counts, fp) {
              let dst = top * 8
              work.store(child, toByteOffset: dst)
              top = top + 1
            }
          }
          i = i + 1
        }
        e = e + 1
      }
    }
  }
  work.free()
  let tcount = RawPtr.gcTypeCount()
  var total = 0
  var t = 0
  while t < tcount {
    let c: Int = counts.load(fromByteOffset: t * 8)
    total = total + c
    t = t + 1
  }
  return total
}

// Count the marked lines in the space's line table.
fun rtCountMarkedLines(space: RawPtr) -> Int {
  let nb: Int = space.load(fromByteOffset: 8)
  let tbl: RawPtr = space.load(fromByteOffset: 16)
  let n = nb * 128
  var count = 0
  var li = 0
  while li < n {
    let m: UInt8 = tbl.load(fromByteOffset: li)
    if m.int == 1 {
      count = count + 1
    }
    li = li + 1
  }
  return count
}

// If `obj` is a non-null marked object (header bit 32 set), clear the mark (restore header to the type-id)
// and return true; else false. The verifier walks by clearing marks, so it visits each live object once.
fun rtUnmarkIfMarked(obj: RawPtr) -> Bool {
  let isNull = obj.eq(RawPtr.null)
  if isNull {
    return false
  }
  let h: Int = obj.load(fromByteOffset: 0)
  let hi = h / 4294967296
  if hi == 0 {
    return false
  }
  let lo = hi * 4294967296
  let tid = h - lo
  obj.store(tid, toByteOffset: 0)
  return true
}

// Verify the line-mark set independently of the marking pass. Re-walk the live set (clearing bit 32 so each
// object is visited once), and for each in-heap object confirm every line it spans is marked (completeness)
// while recording its lines in a scratch table. Then compare the scratch coverage to the actual marked-line
// count (soundness — no line marked beyond the live footprint). Returns 0 when both hold; +1 on an unmarked
// live line, +2 on a count mismatch. Clears all header marks as a side effect.
fun rtLineMarkCheck(space: RawPtr, root: RawPtr) -> Int {
  let nb: Int = space.load(fromByteOffset: 8)
  let base: Int = space.load(fromByteOffset: 40)
  let heapEnd = base + nb * 32768
  let ntot = nb * 128
  let scratch = RawPtr.alloc(bytes: ntot, align: 8)
  let cap = 1048576
  let work = RawPtr.alloc(bytes: cap * 8, align: 8)
  var violations = 0
  var top = 0
  if rtUnmarkIfMarked(root) {
    work.store(root, toByteOffset: 0)
    top = 1
  }
  while top > 0 {
    top = top - 1
    let obj: RawPtr = work.load(fromByteOffset: top * 8)
    let tid = rtObjTypeId(obj)
    let kind = RawPtr.gcTypeKind(tid)
    let nptr = RawPtr.gcTypeNumPtrs(tid)
    var size = 0
    if kind == 0 {
      size = RawPtr.gcTypeSize(tid)
    } else {
      let ecap: Int = obj.load(fromByteOffset: 8)
      let stride = RawPtr.gcTypeStride(tid)
      size = 16 + ecap * stride
    }
    let a = obj.toInt()
    var inHeap = true
    if a < base {
      inHeap = false
    }
    if a >= heapEnd {
      inHeap = false
    }
    if inHeap {
      let first = rtLineIndexOf(space, obj)
      let lastAddr = obj.advanced(by: size - 1)
      let last = rtLineIndexOf(space, lastAddr)
      var li = first
      while li <= last {
        if rtLineMarked(space, li) == 0 {
          violations = violations + 1
        }
        scratch.store(1.uint8, toByteOffset: li)
        li = li + 1
      }
    }
    if kind == 0 {
      var i = 0
      while i < nptr {
        let off = RawPtr.gcTypePtrOffset(tid, i)
        let child: RawPtr = obj.load(fromByteOffset: off)
        if rtUnmarkIfMarked(child) {
          work.store(child, toByteOffset: top * 8)
          top = top + 1
        }
        i = i + 1
      }
    } else {
      let ecap2: Int = obj.load(fromByteOffset: 8)
      let stride2 = RawPtr.gcTypeStride(tid)
      var ee = 0
      while ee < ecap2 {
        let elemBase = 16 + ee * stride2
        var i2 = 0
        while i2 < nptr {
          let off2 = RawPtr.gcTypePtrOffset(tid, i2)
          let at = elemBase + off2
          let child2: RawPtr = obj.load(fromByteOffset: at)
          if rtUnmarkIfMarked(child2) {
            work.store(child2, toByteOffset: top * 8)
            top = top + 1
          }
          i2 = i2 + 1
        }
        ee = ee + 1
      }
    }
  }
  var covered = 0
  var k = 0
  while k < ntot {
    let s: UInt8 = scratch.load(fromByteOffset: k)
    if s.int == 1 {
      covered = covered + 1
    }
    k = k + 1
  }
  work.free()
  scratch.free()
  let actual = rtCountMarkedLines(space)
  var status = 0
  if violations > 0 {
    status = status + 1
  }
  if actual != covered {
    status = status + 2
  }
  return status
}

// ---- Sweep reclamation — the first functioning self-hosted collector (task 150 · rung 3, 150.3.5) ----
// A non-moving mark-sweep collection over the Immix regions: mark the live set from a root (header bit +
// line marks), reclaim by line/block (unmarked lines are free; a block with no live line returns to the
// pool, a mixed block is recyclable), reclaim the LOS by whole chunk, then reset marks and the allocator so
// reclaimed + recyclable space is reused (the hole-aware allocator above). Evacuation is off — objects do
// not move (150.3.7). Driven explicitly (rtImmixCollect) on a deterministic single-thread root set, as
// mark-verify drove the tracer; wiring it at a real STW over all mutators is the scheduler-coupled 128.3.2.

// Set the header mark bit (32) if unmarked; return true when newly marked. Like rtTryMark but without the
// counts/fingerprint bookkeeping (collection needs only the mark).
fun rtTryMarkBare(obj: RawPtr) -> Bool {
  let h: Int = obj.load(fromByteOffset: 0)
  let hi = h / 4294967296
  if hi > 0 {
    return false
  }
  let marked = h + 4294967296
  obj.store(marked, toByteOffset: 0)
  return true
}

// Mark the transitive live set from `root`: header bit 32 on each object, plus line marks for in-heap
// objects (rtMarkObjLines; LOS objects get the header bit only, reclaimed by whole chunk).
fun rtImmixMark(space: RawPtr, root: RawPtr) {
  let cap = 1048576
  let work = RawPtr.alloc(bytes: cap * 8, align: 8)
  var top = 0
  let rootNull = root.eq(RawPtr.null)
  if !rootNull {
    if rtTryMarkBare(root) {
      work.store(root, toByteOffset: 0)
      top = 1
    }
  }
  while top > 0 {
    top = top - 1
    let obj: RawPtr = work.load(fromByteOffset: top * 8)
    let tid = rtObjTypeId(obj)
    let kind = RawPtr.gcTypeKind(tid)
    let nptr = RawPtr.gcTypeNumPtrs(tid)
    var size = 0
    if kind == 0 {
      size = RawPtr.gcTypeSize(tid)
    } else {
      let ecap: Int = obj.load(fromByteOffset: 8)
      let stride = RawPtr.gcTypeStride(tid)
      size = 16 + ecap * stride
    }
    rtMarkObjLines(space, obj, size)
    if kind == 0 {
      var i = 0
      while i < nptr {
        let off = RawPtr.gcTypePtrOffset(tid, i)
        let child: RawPtr = obj.load(fromByteOffset: off)
        let childNull = child.eq(RawPtr.null)
        if !childNull {
          if rtTryMarkBare(child) {
            work.store(child, toByteOffset: top * 8)
            top = top + 1
          }
        }
        i = i + 1
      }
    } else {
      let ecap2: Int = obj.load(fromByteOffset: 8)
      let stride2 = RawPtr.gcTypeStride(tid)
      var e = 0
      while e < ecap2 {
        let elemBase = 16 + e * stride2
        var i = 0
        while i < nptr {
          let off = RawPtr.gcTypePtrOffset(tid, i)
          let at = elemBase + off
          let child: RawPtr = obj.load(fromByteOffset: at)
          let childNull = child.eq(RawPtr.null)
          if !childNull {
            if rtTryMarkBare(child) {
              work.store(child, toByteOffset: top * 8)
              top = top + 1
            }
          }
          i = i + 1
        }
        e = e + 1
      }
    }
  }
  work.free()
}

// Clear every line mark — the start of a collection, before liveness is re-derived.
fun rtClearAllLines(space: RawPtr) {
  let nb: Int = space.load(fromByteOffset: 8)
  let tbl: RawPtr = space.load(fromByteOffset: 16)
  let n = nb * 128
  var i = 0
  while i < n {
    tbl.store(0.uint8, toByteOffset: i)
    i = i + 1
  }
}

// Reclaim by block: for each handed-out block, count its marked (live) lines and set its state — FREE (no
// live line, returned to the free list for reuse), RECYCLABLE (mixed, has holes), or UNAVAILABLE (all live).
// The live-line count is also recorded in defragTable as the next collection's fragmentation histogram — the
// defrag trigger (150.3.8) selects evacuation sources from blocks this sweep found sparsely live (§10.6).
fun rtImmixSweepBlocks(space: RawPtr) {
  let fc: Int = space.load(fromByteOffset: 32)
  space.store(0, toByteOffset: 96)           // reset free list
  let fl: RawPtr = space.load(fromByteOffset: 88)
  let dt: RawPtr = space.load(fromByteOffset: 112)
  var bi = 0
  while bi < fc {
    let firstLine = bi * 128
    var marked = 0
    var li = 0
    while li < 128 {
      let gi = firstLine + li
      if rtLineMarked(space, gi) == 1 {
        marked = marked + 1
      }
      li = li + 1
    }
    dt.store(marked.uint8, toByteOffset: bi)   // record the live-line count for next collection's defrag selection
    if marked == 0 {
      rtSetBlockState(space, bi, 0)
      let top: Int = space.load(fromByteOffset: 96)
      fl.store(bi, toByteOffset: top * 8)
      space.store(top + 1, toByteOffset: 96)
    } else {
      if marked == 128 {
        rtSetBlockState(space, bi, 2)
      } else {
        rtSetBlockState(space, bi, 1)
      }
    }
    bi = bi + 1
  }
}

// Reclaim the large-object space: walk the LOS list, free every unmarked (dead) chunk, and relink the marked
// (live) ones (their marks are cleared later by rtImmixUnmark). Reforms losHead over the survivors.
fun rtImmixSweepLos(space: RawPtr) {
  var cur: RawPtr = space.load(fromByteOffset: 64)
  var newHead = RawPtr.null
  var curNull = cur.eq(RawPtr.null)
  while !curNull {
    let next: RawPtr = cur.load(fromByteOffset: 0)
    let obj = cur.advanced(by: 8)
    let h: Int = obj.load(fromByteOffset: 0)
    let hi = h / 4294967296
    if hi > 0 {
      cur.store(newHead, toByteOffset: 0)
      newHead = cur
    } else {
      cur.free()
    }
    cur = next
    curNull = cur.eq(RawPtr.null)
  }
  space.store(newHead, toByteOffset: 64)
}

// Clear the header mark bit across the live set (re-walk from root). Runs after the sweeps have read the
// marks, so the next collection starts clean. Reaches LOS survivors through the graph too.
fun rtImmixUnmark(root: RawPtr) {
  let cap = 1048576
  let work = RawPtr.alloc(bytes: cap * 8, align: 8)
  var top = 0
  if rtUnmarkIfMarked(root) {
    work.store(root, toByteOffset: 0)
    top = 1
  }
  while top > 0 {
    top = top - 1
    let obj: RawPtr = work.load(fromByteOffset: top * 8)
    let tid = rtObjTypeId(obj)
    let kind = RawPtr.gcTypeKind(tid)
    let nptr = RawPtr.gcTypeNumPtrs(tid)
    if kind == 0 {
      var i = 0
      while i < nptr {
        let off = RawPtr.gcTypePtrOffset(tid, i)
        let child: RawPtr = obj.load(fromByteOffset: off)
        if rtUnmarkIfMarked(child) {
          work.store(child, toByteOffset: top * 8)
          top = top + 1
        }
        i = i + 1
      }
    } else {
      let ecap: Int = obj.load(fromByteOffset: 8)
      let stride = RawPtr.gcTypeStride(tid)
      var e = 0
      while e < ecap {
        let elemBase = 16 + e * stride
        var i = 0
        while i < nptr {
          let off = RawPtr.gcTypePtrOffset(tid, i)
          let at = elemBase + off
          let child: RawPtr = obj.load(fromByteOffset: at)
          if rtUnmarkIfMarked(child) {
            work.store(child, toByteOffset: top * 8)
            top = top + 1
          }
          i = i + 1
        }
        e = e + 1
      }
    }
  }
  work.free()
}

// One non-moving collection from `root`: clear line marks, mark the live set, reclaim by block and by LOS
// chunk, unmark, then reset the allocator so the next allocation reuses reclaimed + recyclable space. The
// heap shrinks: dead blocks return to the pool and dead LOS chunks are freed.
fun rtImmixCollect(space: RawPtr, root: RawPtr) {
  rtClearAllLines(space)
  rtImmixMark(space, root)
  rtImmixSweepBlocks(space)
  rtImmixSweepLos(space)
  rtImmixUnmark(root)
  space.store(-1, toByteOffset: 72)   // allocBlock: none
  space.store(0, toByteOffset: 80)    // allocLine
  space.store(0, toByteOffset: 48)    // allocCursor
  space.store(0, toByteOffset: 56)    // allocLimit
  space.store(0, toByteOffset: 104)   // scanBlock (rescan recyclable from the start)
}

// Blocks handed out from the never-used pool (freeCursor) — the heap's high-water mark in blocks.
fun rtImmixBlocksUsed(space: RawPtr) -> Int {
  return space.load(fromByteOffset: 32)
}

// Reclaimed empty blocks currently on the free list (set by the last sweep).
fun rtImmixFreeBlocks(space: RawPtr) -> Int {
  return space.load(fromByteOffset: 96)
}

// ---- Forwarding word + copy primitive (task 150 · rung 3, increment 150.3.6) ----
// The mechanism evacuation (150.3.7) is built on. The forwarding record is §10.8 (Decided): the new address
// goes in the stale copy's payload word 0 (offset 8), and header bit 33 flags "forwarded". Header layout:
// bits 0–31 type-id, bit 32 mark (150.2.2), bit 33 forwarded. `rtObjTypeId` already strips all high bits, so
// size/kind reads keep working on a marked or forwarded header. Overwriting payload word 0 is sound because
// the object is copied first (size computed before the clobber) and the stale original is only ever read for
// its forwarding pointer afterward. The payload-word-0 slot exists for every managed type — `rtCheckPayloadWord`
// guards that (§10.8): a fixed object is header + ≥1 field (≥16 bytes), an array buffer is header + cap + ….

// The object's total size in bytes from the type tables: fixed size, or 16 + cap*stride for a buffer. Must
// be read before forwarding clobbers payload word 0 (a buffer's cap lives there).
fun rtObjSize(obj: RawPtr) -> Int {
  let tid = rtObjTypeId(obj)
  let kind = RawPtr.gcTypeKind(tid)
  if kind == 0 {
    return RawPtr.gcTypeSize(tid)
  }
  let ecap: Int = obj.load(fromByteOffset: 8)
  let stride = RawPtr.gcTypeStride(tid)
  return 16 + ecap * stride
}

// Copy `bytes` (a multiple of 8) word by word — the whole object including its header.
fun rtCopyWords(dst: RawPtr, src: RawPtr, bytes: Int) {
  var o = 0
  while o < bytes {
    let w: Int = src.load(fromByteOffset: o)
    dst.store(w, toByteOffset: o)
    o = o + 8
  }
}

// Header bit 33 set → the object has been evacuated; payload word 0 holds its new address.
fun rtIsForwarded(obj: RawPtr) -> Bool {
  let h: Int = obj.load(fromByteOffset: 0)
  let hi = h / 4294967296
  let bit33 = hi / 2 - hi / 4 * 2
  if bit33 == 1 {
    return true
  }
  return false
}

// The forwarding address (payload word 0) of an already-forwarded object.
fun rtForwardingPointer(obj: RawPtr) -> RawPtr {
  let p: RawPtr = obj.load(fromByteOffset: 8)
  return p
}

// Flag `obj` forwarded (set header bit 33 if not already) and store its new address in payload word 0.
fun rtSetForwarded(obj: RawPtr, newAddr: RawPtr) {
  let h: Int = obj.load(fromByteOffset: 0)
  let hi = h / 4294967296
  let bit33 = hi / 2 - hi / 4 * 2
  var nh = h
  if bit33 == 0 {
    nh = h + 8589934592
  }
  obj.store(nh, toByteOffset: 0)
  obj.store(newAddr, toByteOffset: 8)
}

// Evacuate `obj`: allocate a fresh slot, copy the object into it, install the forwarding record in the
// original, and return the new address (or null if allocation fails). Size is read before the copy so the
// forwarding clobber of payload word 0 is safe. The copy inherits the original's header (mark bit, no
// forwarded bit — that is set only on the original), which is the end state evacuation wants.
fun rtCopyObject(space: RawPtr, obj: RawPtr) -> RawPtr {
  let size = rtObjSize(obj)
  let dst = rtImmixAlloc(space, size)
  let dstNull = dst.eq(RawPtr.null)
  if dstNull {
    return RawPtr.null
  }
  rtCopyWords(dst, obj, size)
  rtSetForwarded(obj, dst)
  return dst
}

// Count managed types with no payload word (fixed size < 16) — the forwarding record needs payload word 0
// (§10.8). 0 confirms the payload-word-0 forwarding scheme is valid for every managed type in the program.
fun rtCheckPayloadWord() -> Int {
  let tcount = RawPtr.gcTypeCount()
  var bad = 0
  var t = 0
  while t < tcount {
    let kind = RawPtr.gcTypeKind(t)
    if kind == 0 {
      let sz = RawPtr.gcTypeSize(t)
      if sz < 16 {
        bad = bad + 1
      }
    }
    t = t + 1
  }
  return bad
}

// ---- Evacuation + pointer fixup — the moving collector (task 150 · rung 3, 150.3.7 / 150.3.8) ----
// Forward-during-trace (selfhosted-gc.md §10.6/§10.7): as the tracer visits the graph it copies each
// reachable object in a source block into fresh to-space (rtCopyObject, installing the forwarding record of
// §10.8) and rewrites the slot it came through — and the root — to the survivor's new address. One store
// added to the slot walk 150.2 already built. A block is an evacuation source iff its state byte is 3
// (DEFRAG_SOURCE); everything else is marked in place. The two callers differ only in how they set that
// flag: rtImmixEvacCollect (150.3.7) marks every used block a source (force-all); rtImmixCollectDefrag
// (150.3.8) selects only fragmented blocks within a copy-reserve budget. Runs under the runtime subset's
// noSafepoint (149), which is what makes holding raw pointers into the moving heap across the copy sound —
// it closes 125 §3.3's deferred moving-heap gate.

// The post-evacuation address of `obj`. A candidate (in the Immix heap, in a DEFRAG_SOURCE block, not yet
// forwarded) is copied into to-space and its forwarding record installed; an already-forwarded object yields
// its forwarding pointer; a non-candidate (LOS/off-heap, or in a non-source block) is returned unchanged and
// marked in place by the caller.
fun rtEvacuate(space: RawPtr, obj: RawPtr) -> RawPtr {
  if rtIsForwarded(obj) {
    return rtForwardingPointer(obj)
  }
  let base: Int = space.load(fromByteOffset: 40)
  let nb: Int = space.load(fromByteOffset: 8)
  let heapEnd = base + nb * 32768
  let a = obj.toInt()
  if a < base {
    return obj                       // off-heap (LOS): never moves
  }
  if a >= heapEnd {
    return obj
  }
  let d = a - base
  let bi = d / 32768
  if rtBlockState(space, bi) != 3 {
    return obj                       // non-source (marked in place) or a to-space copy — do not move
  }
  let copy = rtCopyObject(space, obj)
  return copy
}

// Forward-during-trace from `root`: evacuate the root and every reachable source-block object into to-space,
// rewriting each managed slot (and the root itself) to the survivor's address as the trace visits it, and
// line-marking each survivor at its final location so the following sweep reclaims the emptied source blocks
// and keeps the marked-in-place survivors. Returns the root's post-evacuation address. Shared children and
// cycles resolve through the forwarded-bit guard in rtEvacuate and the mark-bit guard here, so every object
// is copied and scanned exactly once.
fun rtImmixEvacMark(space: RawPtr, root: RawPtr) -> RawPtr {
  let rootNull = root.eq(RawPtr.null)
  if rootNull {
    return root
  }
  let cap = 1048576
  let work = RawPtr.alloc(bytes: cap * 8, align: 8)
  var top = 0
  let newRoot = rtEvacuate(space, root)
  if rtTryMarkBare(newRoot) {
    work.store(newRoot, toByteOffset: 0)
    top = 1
  }
  while top > 0 {
    top = top - 1
    let obj: RawPtr = work.load(fromByteOffset: top * 8)
    let tid = rtObjTypeId(obj)
    let kind = RawPtr.gcTypeKind(tid)
    let nptr = RawPtr.gcTypeNumPtrs(tid)
    var size = 0
    if kind == 0 {
      size = RawPtr.gcTypeSize(tid)
    } else {
      let ecap: Int = obj.load(fromByteOffset: 8)
      let stride = RawPtr.gcTypeStride(tid)
      size = 16 + ecap * stride
    }
    rtMarkObjLines(space, obj, size)
    if kind == 0 {
      var i = 0
      while i < nptr {
        let off = RawPtr.gcTypePtrOffset(tid, i)
        let child: RawPtr = obj.load(fromByteOffset: off)
        let childNull = child.eq(RawPtr.null)
        if !childNull {
          let nc = rtEvacuate(space, child)
          obj.store(nc, toByteOffset: off)
          if rtTryMarkBare(nc) {
            work.store(nc, toByteOffset: top * 8)
            top = top + 1
          }
        }
        i = i + 1
      }
    } else {
      let ecap2: Int = obj.load(fromByteOffset: 8)
      let stride2 = RawPtr.gcTypeStride(tid)
      var e = 0
      while e < ecap2 {
        let elemBase = 16 + e * stride2
        var i = 0
        while i < nptr {
          let off = RawPtr.gcTypePtrOffset(tid, i)
          let at = elemBase + off
          let child: RawPtr = obj.load(fromByteOffset: at)
          let childNull = child.eq(RawPtr.null)
          if !childNull {
            let nc = rtEvacuate(space, child)
            obj.store(nc, toByteOffset: at)
            if rtTryMarkBare(nc) {
              work.store(nc, toByteOffset: top * 8)
              top = top + 1
            }
          }
          i = i + 1
        }
        e = e + 1
      }
    }
  }
  work.free()
  return newRoot
}

// Point the copy allocator at fresh to-space only for the evacuation trace: reset the bump cursor and skip
// the recyclable scan past every used block, so copies draw from reclaimed-free and never-used blocks (both
// FREE, never a source or a marked-in-place block). Shared setup for both evacuating collectors.
fun rtSetupCopyAllocator(space: RawPtr) {
  let fc: Int = space.load(fromByteOffset: 32)
  space.store(fc, toByteOffset: 104)        // recyclable scan past every used block
  space.store(-1, toByteOffset: 72)         // allocBlock: none → first copy draws a fresh/free block
  space.store(0, toByteOffset: 80)          // allocLine
  space.store(0, toByteOffset: 48)          // allocCursor
  space.store(0, toByteOffset: 56)          // allocLimit
}

// Reset the mutator's allocator after a collection: no current block, rescan recyclable from the start so
// reclaimed + recyclable space is reused by the next allocation.
fun rtResetAllocator(space: RawPtr) {
  space.store(-1, toByteOffset: 72)
  space.store(0, toByteOffset: 80)
  space.store(0, toByteOffset: 48)
  space.store(0, toByteOffset: 56)
  space.store(0, toByteOffset: 104)
}

// One force-all evacuating collection from `root` (150.3.7): mark every used block a source, so every live
// object moves to fresh to-space; fix up all slots and the root; reclaim the emptied from-space by the
// 150.3.5 sweep. Returns the root's new address (the root moves — the caller adopts it). The general
// collector (rtImmixCollectDefrag, 150.3.8) selects sources by fragmentation; this is its evacuate-everything
// special case, kept as a maximal-move stress path.
fun rtImmixEvacCollect(space: RawPtr, root: RawPtr) -> RawPtr {
  rtClearAllLines(space)
  let fc: Int = space.load(fromByteOffset: 32)
  var bi = 0
  while bi < fc {
    rtSetBlockState(space, bi, 3)           // every used block is a source
    bi = bi + 1
  }
  space.store(0, toByteOffset: 96)          // free list empty — to-space is fresh (never-used) only
  rtSetupCopyAllocator(space)
  let newRoot = rtImmixEvacMark(space, root)
  rtImmixSweepBlocks(space)
  rtImmixSweepLos(space)
  rtImmixUnmark(newRoot)
  rtResetAllocator(space)
  return newRoot
}

// ---- Copy reserve + defrag trigger — the general collector (task 150 · rung 3, 150.3.8) ----
// The defrag trigger replaces force-all: only fragmented blocks are evacuated, and only as many as fresh
// to-space can absorb (the copy reserve). Fragmentation is read from defragTable — each block's live-line
// count as of the last sweep (§10.6, MMTk's "previous GC mark histogram drives this GC's defrag"). A block
// is a source iff it holds live data but is sparsely filled (0 < lastLiveLines ≤ threshold). The reserve
// bounds the source count by available empty blocks: each source needs at most one to-space block, so
// selecting at most (available − reserve) sources leaves the reserve free even if a source turned out full —
// the guarantee that evacuation never runs out of to-space mid-collection. When the heap is near-full
// (budget 0) no sources are selected and the collection is non-moving. Selection is deterministic (scan
// order), so the collector diffs against MMTk Immix run to run.

// Half a block — a block with at most this many live lines (more than half holes) is fragmented enough to
// evacuate. The fragmentation threshold; tuning it (and the block-selection order) is the defrag policy knob.
fun rtDefragThreshold() -> Int {
  return 64
}

// Select evacuation sources for this collection and mark them DEFRAG_SOURCE (state 3). A block qualifies
// when the last sweep found it sparsely live (0 < count ≤ threshold) and it is still a used block (state
// RECYCLABLE/UNAVAILABLE). At most `budget` blocks are selected — budget is the available empty-block count
// (free list + never-used) minus the copy reserve — so to-space can always absorb the survivors. Returns the
// number selected (0 ⇒ the collection runs non-moving). Freshly allocated blocks with no histogram (count 0)
// are never sources; the first collection therefore never evacuates and only seeds defragTable.
fun rtSelectDefragSources(space: RawPtr) -> Int {
  let fc: Int = space.load(fromByteOffset: 32)
  let nb: Int = space.load(fromByteOffset: 8)
  let flTop: Int = space.load(fromByteOffset: 96)
  let neverUsed = nb - fc
  let available = flTop + neverUsed
  var reserve = available / 16
  if reserve < 1 {
    reserve = 1
  }
  var budget = available - reserve
  if budget < 0 {
    budget = 0
  }
  let threshold = rtDefragThreshold()
  let dt: RawPtr = space.load(fromByteOffset: 112)
  var selected = 0
  var bi = 0
  while bi < fc {
    if selected < budget {
      let cnt: UInt8 = dt.load(fromByteOffset: bi)
      let live = cnt.int
      if live > 0 {
        if live <= threshold {
          let st = rtBlockState(space, bi)
          if st != 0 {
            rtSetBlockState(space, bi, 3)   // DEFRAG_SOURCE for this collection
            selected = selected + 1
          }
        }
      }
    }
    bi = bi + 1
  }
  return selected
}

// One collection from `root`, the general Immix collector (150.3.8): select fragmented blocks as evacuation
// sources within the copy reserve, evacuate their live objects to fresh to-space while marking every other
// live object in place, then reclaim the emptied sources + dead blocks by the 150.3.5 sweep (which also
// records the next collection's fragmentation histogram). Returns the root's post-collection address — the
// root moves only if it sat in a source block, so the caller adopts the returned pointer. With zero sources
// this is exactly the non-moving collector (rtImmixCollect); with every used block a source it is force-all
// (rtImmixEvacCollect) — one path, the evacuation set chosen by fragmentation.
fun rtImmixCollectDefrag(space: RawPtr, root: RawPtr) -> RawPtr {
  let nSources = rtSelectDefragSources(space)
  rtClearAllLines(space)
  rtSetupCopyAllocator(space)
  let newRoot = rtImmixEvacMark(space, root)
  rtImmixSweepBlocks(space)
  rtImmixSweepLos(space)
  rtImmixUnmark(newRoot)
  rtResetAllocator(space)
  return newRoot
}

// ---- Scheduler root (task 128.3.1) ----
// The global scheduled-mailbox queue head (`rt_sched_head`) is a single managed GC root: rooting it keeps
// the whole `sched_next` chain — every queued mailbox, its pending messages, and each receiver actor — alive
// even when the actor is otherwise unreferenced, so fire-and-forget outstanding work survives GC. The C root
// scan (`nomu_gc_scan_parked_fibers`) reports it alongside the parked fibers; this reads the same global
// self-hosted (`RawPtr.gcSchedHead()` loads it directly) and appends it into `outBuf` when the queue is
// non-empty. Returns the new count. The chain past the head is reached through the mailbox pointer map (a
// scanned field), so reporting the head alone suffices — the tracer follows `sched_next` from there.
fun rtScanSchedRoot(outBuf: RawPtr, n0: Int, cap: Int) -> Int {
  var n = n0
  let head = RawPtr.gcSchedHead()
  let headNull = head.eq(RawPtr.null)
  if !headNull {
    if n < cap {
      outBuf.store(head, toByteOffset: n * 8)
      n = n + 1
    }
  }
  return n
}

// ---- Self-hosted M:N scheduler (task 128.1.9 — the production scheduler behind NOMU_SCHED=nomu) ----
// The machinery proved rung-by-rung in the examples/scheduler_*.nomu fixtures, consolidated here into one
// canonical scheduler that runs real GC-registered user programs. The C entry points fiber_spawn /
// spawn_join / main (runtime.c) dispatch into the `nomuSched*` functions below when the Nomu plan is
// selected; codegen is unchanged. Scope for this rung is NoGC — the default MMTk plan never collects, so
// there is no stop-the-world over these carriers yet (that is 128.3.2, which adds a Nomu-readable saved
// context and drives rtWalkFrom over the live-fiber registry).
//
// The lock protocol is the lock-coupled park (concurrency.md §2): the carrier switches into a fiber with
// the scheduler lock HELD; the fiber releases it only after switch-in, runs lock-free, then re-acquires it
// to suspend/complete and switches back to the carrier while holding it — so a fiber's context is fully
// saved before any waker (which must hold the same lock to enqueue) can re-queue it.
//
// Off-heap layouts (byte offsets):
//   Sched (256B): 0 runq-head · 8 runq-tail · 16 mutex-word · 24 wake-gen · 32 active · 40 stopping
//                 · 48 timer-mutex · 56 timer-gen · 64 timer-count · 72 timer-entries (ptr)
//                 · 80 mbox-sched-head · 88 mbox-sched-tail · 96 active-drains · 104 mbfiber-free
//                 · 112 mbfiber-count · 120 drain-fn-ptr (nomu_actor_drain) · 128 registry-head
//                 · 136 stw-request · 144 stw-ack · 152 stw-gen · 160 ncarriers   (STW handshake, 128.3.2)
//   Timer entry (16B): 0 expiry-ns · 8 fiber
//   Mailbox (ABI, runtime.h): 0 header · 8 mb_head · 16 mb_tail · 24 scheduled · 32 sched_next
//   Message (ABI, runtime.h): 0 header · 8 next · 16 thunk · 24 self · args…
//   Fiber (288B): 0..167 ctx buffer · 168 state · 176 next-link · 184 entry · 192 arg · 200 sched
//                 · 208 stackBase · 216 result · 224 joiner · 232 carrierCtx · 240 reg-next · 248 reg-prev
//                 · 256 pool-next · 264 anchor-sp · 272 anchor-pc
//   state: 0 ready · 1 running · 2 parked · 3 done      mutex-word: 0 unlocked · 1 locked · 2 contended
//   anchor-sp/anchor-pc (task 128.3.2): the user-frame (sp, pc) captured by the C dispatch shim at the
//   point the fiber stopped (a park at join/sleep, or a safepoint poll) — a statepoint return address the
//   pcsp walk (rtWalkFrom) can match. Set before the fiber parks; the STW walk reads it. This retires the
//   C libunwind crossing (gcParkedAnchors) that 128.3.1 used while the scheduler was still C.

// A 3-state futex mutex on the word at `m` (Drepper "mutex1": uncontended CAS fast path, a __ulock_wait
// slow path). Used for both the scheduler lock (sched+16) and the timer lock (sched+48).
fun rtSchedMutexLockAt(m: RawPtr) {
  var c: Int = m.atomicCas(0, 1, atByteOffset: 0)
  if c != 0 {
    if c != 2 {
      c = m.atomicExchange(2, atByteOffset: 0)
    }
    while c != 0 {
      m.futexWait(expected: 2, timeoutMicros: 0)
      c = m.atomicExchange(2, atByteOffset: 0)
    }
  }
}

fun rtSchedMutexUnlockAt(m: RawPtr) {
  let prev: Int = m.atomicExchange(0, atByteOffset: 0)
  if prev == 2 {
    m.futexWake(all: false)
  }
}

// The scheduler lock (sched+16). Held continuously across the carrier↔fiber boundary; user bodies run free.
fun rtSchedLock(sched: RawPtr) {
  rtSchedMutexLockAt(sched.advanced(by: 16))
}

fun rtSchedUnlock(sched: RawPtr) {
  rtSchedMutexUnlockAt(sched.advanced(by: 16))
}

// Make `fib` runnable and wake a carrier for it (a plain unpark, no in-flight save to race — used by the
// timer thread to fire a sleeper it has already removed from the heap).
fun rtSchedUnpark(sched: RawPtr, fib: RawPtr) {
  rtSchedLock(sched)
  fib.store(0, toByteOffset: 168)
  rtSchedEnqueue(sched, fib)
  rtSchedUnlock(sched)
  rtSchedWake(sched, false)
}

// Intrusive run queue (head at sched+0, tail at sched+8, link at fib+176). Touched only under the lock.
fun rtSchedEnqueue(sched: RawPtr, fib: RawPtr) {
  fib.store(RawPtr.null, toByteOffset: 176)
  let tail: RawPtr = sched.load(fromByteOffset: 8)
  if tail.isNull {
    sched.store(fib, toByteOffset: 0)
    sched.store(fib, toByteOffset: 8)
  } else {
    tail.store(fib, toByteOffset: 176)
    sched.store(fib, toByteOffset: 8)
  }
}

fun rtSchedDequeue(sched: RawPtr) -> RawPtr {
  let h: RawPtr = sched.load(fromByteOffset: 0)
  if h.isNull {
    return h
  }
  let nx: RawPtr = h.load(fromByteOffset: 176)
  sched.store(nx, toByteOffset: 0)
  if nx.isNull {
    sched.store(RawPtr.null, toByteOffset: 8)
  }
  h.store(RawPtr.null, toByteOffset: 176)
  return h
}

// Bump the wake-generation word (closes the unlock→futexWait window) and wake idle carrier(s).
fun rtSchedWake(sched: RawPtr, all: Bool) {
  let gw = sched.advanced(by: 24)
  gw.atomicFetchAdd(1, atByteOffset: 0)
  gw.futexWake(all: all)
}

// Wake the timer thread (it waits on the timer-gen word at sched+56): bump the word, then futexWake.
fun rtSchedWakeTimer(sched: RawPtr) {
  let tg = sched.advanced(by: 56)
  tg.atomicFetchAdd(1, atByteOffset: 0)
  tg.futexWake(all: false)
}

// Raise the stop flag and wake everyone (idle carriers + the timer thread) so they exit for the join.
fun rtSchedSignalStop(sched: RawPtr) {
  sched.atomicStore(1, toByteOffset: 40)
  rtSchedWake(sched, true)
  rtSchedWakeTimer(sched)
}

// ---- Timer heap (min-heap on the timer-entries buffer; entry i at i*16: expiry +0, fiber +8). Touched
// only under the timer lock at sched+48. Backs fiberSleep, mirroring the C rt_timer_thread / rt_sleep_ms. ----

fun rtSchedHeapSwap(ents: RawPtr, a: Int, b: Int) {
  let ea = a * 16
  let eb = b * 16
  let x1: Int = ents.load(fromByteOffset: ea)
  let f1: RawPtr = ents.load(fromByteOffset: ea + 8)
  let x2: Int = ents.load(fromByteOffset: eb)
  let f2: RawPtr = ents.load(fromByteOffset: eb + 8)
  ents.store(x2, toByteOffset: ea)
  ents.store(f2, toByteOffset: ea + 8)
  ents.store(x1, toByteOffset: eb)
  ents.store(f1, toByteOffset: eb + 8)
}

fun rtSchedTimerPush(sched: RawPtr, expiry: Int, fib: RawPtr) {
  let ents: RawPtr = sched.load(fromByteOffset: 72)
  var i: Int = sched.load(fromByteOffset: 64)
  sched.store(i + 1, toByteOffset: 64)
  ents.store(expiry, toByteOffset: i * 16)
  ents.store(fib, toByteOffset: i * 16 + 8)
  var go = true
  while go {
    if i == 0 {
      go = false
    } else {
      let p = (i - 1) / 2
      let ep: Int = ents.load(fromByteOffset: p * 16)
      let ei: Int = ents.load(fromByteOffset: i * 16)
      if ep <= ei {
        go = false
      } else {
        rtSchedHeapSwap(ents, p, i)
        i = p
      }
    }
  }
}

// Remove the earliest-deadline entry (caller checked count > 0); writes its expiry/fiber to out+0 / out+8.
fun rtSchedTimerPopMin(sched: RawPtr, out: RawPtr) {
  let ents: RawPtr = sched.load(fromByteOffset: 72)
  let x0: Int = ents.load(fromByteOffset: 0)
  let f0: RawPtr = ents.load(fromByteOffset: 8)
  out.store(x0, toByteOffset: 0)
  out.store(f0, toByteOffset: 8)
  var n: Int = sched.load(fromByteOffset: 64) - 1
  sched.store(n, toByteOffset: 64)
  if n > 0 {
    let xl: Int = ents.load(fromByteOffset: n * 16)
    let fl: RawPtr = ents.load(fromByteOffset: n * 16 + 8)
    ents.store(xl, toByteOffset: 0)
    ents.store(fl, toByteOffset: 8)
    var i = 0
    var go = true
    while go {
      let l = 2 * i + 1
      let r = 2 * i + 2
      var s = i
      let es: Int = ents.load(fromByteOffset: s * 16)
      if l < n {
        let el: Int = ents.load(fromByteOffset: l * 16)
        if el < es {
          s = l
        }
      }
      let es2: Int = ents.load(fromByteOffset: s * 16)
      if r < n {
        let er: Int = ents.load(fromByteOffset: r * 16)
        if er < es2 {
          s = r
        }
      }
      if s == i {
        go = false
      } else {
        rtSchedHeapSwap(ents, i, s)
        i = s
      }
    }
  }
}

// The timer thread: sleep on the timer-gen futex until the earliest deadline (or a push), then unpark the
// due fiber. Exits on the stop flag. A raw thread that touches only off-heap memory (no user code), so it
// needs no mutator registration (NoGC scope). Mirrors the C rt_timer_thread.
fun rtSchedTimerMain(sched: RawPtr) -> RawPtr {
  let out = RawPtr.alloc(bytes: 16, align: 8)
  var go = true
  while go {
    let stp: Int = sched.atomicLoad(fromByteOffset: 40)
    if stp != 0 {
      go = false
    } else {
      rtSchedMutexLockAt(sched.advanced(by: 48))
      let count: Int = sched.load(fromByteOffset: 64)
      if count == 0 {
        let tg = sched.advanced(by: 56)
        let gen: Int = tg.atomicLoad(fromByteOffset: 0)
        rtSchedMutexUnlockAt(sched.advanced(by: 48))
        tg.futexWait(expected: gen, timeoutMicros: 1000000)
      } else {
        let ents: RawPtr = sched.load(fromByteOffset: 72)
        let next: Int = ents.load(fromByteOffset: 0)
        let now: Int = RawPtr.monotonicNanos()
        if next <= now {
          rtSchedTimerPopMin(sched, out)
          rtSchedMutexUnlockAt(sched.advanced(by: 48))
          let f: RawPtr = out.load(fromByteOffset: 8)
          rtSchedUnpark(sched, f)
        } else {
          let tg = sched.advanced(by: 56)
          let gen: Int = tg.atomicLoad(fromByteOffset: 0)
          rtSchedMutexUnlockAt(sched.advanced(by: 48))
          let waitUs: Int = (next - now) / 1000
          tg.futexWait(expected: gen, timeoutMicros: waitUs)
        }
      }
    }
  }
  return sched
}

// Allocate + seed a fresh fiber: a 128 KB stack (matching the C RT_STACK_SIZE) and a handle whose first
// switch-in lands in rtSchedFiberMain. Created parked; the spawner readies and enqueues it.
fun rtSchedFiberNew(sched: RawPtr, entry: RawPtr, arg: RawPtr) -> RawPtr {
  let stack = RawPtr.alloc(bytes: 131072, align: 16)
  let stackTop = stack.advanced(by: 131072)
  let fib = RawPtr.alloc(bytes: 288, align: 16)
  fib.store(2, toByteOffset: 168)
  fib.store(RawPtr.null, toByteOffset: 176)
  fib.store(entry, toByteOffset: 184)
  fib.store(arg, toByteOffset: 192)
  fib.store(sched, toByteOffset: 200)
  fib.store(stack, toByteOffset: 208)
  fib.store(RawPtr.null, toByteOffset: 216)
  fib.store(RawPtr.null, toByteOffset: 224)
  fib.store(RawPtr.null, toByteOffset: 232)
  fib.store(RawPtr.null, toByteOffset: 240)   // reg-next
  fib.store(RawPtr.null, toByteOffset: 248)   // reg-prev
  fib.store(RawPtr.null, toByteOffset: 256)   // pool-next
  fib.store(RawPtr.null, toByteOffset: 264)   // anchor-sp
  fib.store(0, toByteOffset: 272)             // anchor-pc
  fib.fiberInit(stackTop: stackTop, entry: RawPtr.ofFunc(rtSchedFiberMain), arg: fib)
  return fib
}

// Fiber trampoline: resume with the lock held, release it, run the user body (via callEntry — the subset
// scheduler → non-subset user body boundary), re-acquire to record completion, wake any joiner, drive the
// active count to quiescence, and switch back to the carrier that ran us (holding the lock).
fun rtSchedFiberMain(fib: RawPtr) -> RawPtr {
  let sched: RawPtr = fib.load(fromByteOffset: 200)
  rtSchedUnlock(sched)
  let entry: RawPtr = fib.load(fromByteOffset: 184)
  let arg: RawPtr = fib.load(fromByteOffset: 192)
  let res = entry.callEntry(arg)
  rtSchedLock(sched)
  fib.store(res, toByteOffset: 216)
  fib.store(3, toByteOffset: 168)
  rtSchedRegRemove(sched, fib)          // done fibers hold no roots; drop from the registry
  let joiner: RawPtr = fib.load(fromByteOffset: 224)
  if joiner.isNull {
  } else {
    joiner.store(0, toByteOffset: 168)
    rtSchedEnqueue(sched, joiner)
    rtSchedWake(sched, false)
  }
  let r: Int = sched.atomicFetchAdd(-1, atByteOffset: 32)
  if r == 1 {
    let ad: Int = sched.atomicLoad(fromByteOffset: 96)     // stay alive while actor drains are outstanding
    if ad == 0 {
      rtSchedSignalStop(sched)
    }
  }
  let carrierCtx: RawPtr = fib.load(fromByteOffset: 232)
  fib.ctxSwitchTo(carrierCtx)
  return fib
}

// The carrier loop: hold the lock, switch into each ready fiber (recording this carrier + rt_current), or
// sleep on the wake-gen futex when the queue is empty. Exit when the stop flag is raised.
fun rtSchedLoop(sched: RawPtr, myCtx: RawPtr) {
  rtSchedLock(sched)
  var go = true
  while go {
    let stp: Int = sched.atomicLoad(fromByteOffset: 40)
    if stp != 0 {
      go = false
    } else {
      let stwReq: Int = sched.atomicLoad(fromByteOffset: 136)
      if stwReq != 0 {
        // Stop-the-world in progress: this carrier is quiescent (no fiber on-CPU), so ack and wait.
        rtSchedUnlock(sched)
        rtSchedStwParkCarrier(sched)
        rtSchedLock(sched)
      } else {
        let fib = rtSchedDequeue(sched)
        if fib.isNull {
          let gw = sched.advanced(by: 24)
          let gen: Int = gw.atomicLoad(fromByteOffset: 0)
          rtSchedUnlock(sched)
          gw.futexWait(expected: gen, timeoutMicros: 1000000)
          rtSchedLock(sched)
        } else {
          fib.store(myCtx, toByteOffset: 232)
          fib.store(1, toByteOffset: 168)
          RawPtr.tlsSet(fib)
          myCtx.ctxSwitchTo(fib)
          // If the fiber stopped at a safepoint for STW (state 4), this carrier acks and waits, then
          // switches back into it to resume past the poll — repeating if another STW round follows.
          var fst: Int = fib.load(fromByteOffset: 168)
          while fst == 4 {
            rtSchedUnlock(sched)
            rtSchedStwParkCarrier(sched)
            rtSchedLock(sched)
            fib.store(1, toByteOffset: 168)
            RawPtr.tlsSet(fib)
            myCtx.ctxSwitchTo(fib)
            fst = fib.load(fromByteOffset: 168)
          }
        }
      }
    }
  }
  rtSchedUnlock(sched)
}

// A carrier thread's entry (started via threadCreate). `carg` is [0] sched · [8] context buffer.
fun rtSchedCarrierMain(carg: RawPtr) -> RawPtr {
  let sched: RawPtr = carg.load(fromByteOffset: 0)
  let ctx: RawPtr = carg.load(fromByteOffset: 8)
  rtSchedLoop(sched, ctx)
  return carg
}

// ---- Actor mailbox + capped mailbox-fiber pool (task 128.1.8 machinery, consolidated). Fire-and-forget
// message send: nomuSchedActorSend enqueues a message and returns; a pool of ≤64 reusable mailbox fibers
// drains scheduled mailboxes by running the codegen-emitted nomu_actor_drain (which pops via the C
// rt_mailbox_pop → nomuSchedMailboxPop and runs each message's thunk). Mirrors the C rt_actor_send /
// rt_mailbox_pool. The mailbox/message byte offsets are the runtime.h ABI (codegen allocates them).
// NoGC scope: the global scheduled-mailbox queue lives in the Sched here rather than the C rt_sched_head
// GC root — reconciling the root for a moving collection is 128.3.2 (there is no GC scan under NoGC). ----

// Pop the head of the global scheduled-mailbox queue (mailbox sched_next at +32), or null. Caller holds
// the scheduler lock; the returned mailbox stays scheduled — the caller is now its drainer.
fun rtSchedMboxSchedPop(sched: RawPtr) -> RawPtr {
  let mb: RawPtr = sched.load(fromByteOffset: 80)
  if mb.isNull {
    return mb
  }
  let nx: RawPtr = mb.load(fromByteOffset: 32)
  sched.store(nx, toByteOffset: 80)
  if nx.isNull {
    sched.store(RawPtr.null, toByteOffset: 88)
  }
  mb.store(RawPtr.null, toByteOffset: 32)
  return mb
}

// A mailbox fiber: seeded to land here on first switch-in, resumed inside the loop thereafter. Unlike a
// user fiber, it runs with the scheduler lock HELD at every loop top (the C rt_mailbox_fiber_main
// invariant): it pops a scheduled mailbox under the lock, drops the lock to drain it, re-takes it; when
// none remain it parks on the free-list (switching to the carrier holding the lock).
fun rtSchedMailboxFiberMain(fib: RawPtr) -> RawPtr {
  let sched: RawPtr = fib.load(fromByteOffset: 200)
  let drainPtr: RawPtr = sched.load(fromByteOffset: 120)
  var go = true
  while go {
    let mb = rtSchedMboxSchedPop(sched)
    if mb.isNull {
      let freeHead: RawPtr = sched.load(fromByteOffset: 104)
      fib.store(freeHead, toByteOffset: 256)                          // pool_next = free
      sched.store(fib, toByteOffset: 104)                             // free = self
      fib.store(2, toByteOffset: 168)                                 // parked
      fib.store(RawPtr.null, toByteOffset: 264)                       // idle: no roots — STW walk skips it
      let carrierCtx: RawPtr = fib.load(fromByteOffset: 232)
      fib.ctxSwitchTo(carrierCtx)                                     // hand lock to scheduler; resume with it held
    } else {
      rtSchedUnlock(sched)
      drainPtr.callEntry(mb)                                          // nomu_actor_drain(mb), lock-free
      rtSchedLock(sched)
    }
  }
  return fib
}

// Allocate a fresh mailbox fiber, seeded to enter rtSchedMailboxFiberMain. Infrastructure — not counted
// in `active`. Caller holds the scheduler lock.
fun rtSchedMailboxFiberNew(sched: RawPtr) -> RawPtr {
  let stack = RawPtr.alloc(bytes: 131072, align: 16)
  let stackTop = stack.advanced(by: 131072)
  let fib = RawPtr.alloc(bytes: 288, align: 16)
  fib.store(0, toByteOffset: 168)
  fib.store(RawPtr.null, toByteOffset: 176)
  fib.store(sched, toByteOffset: 200)
  fib.store(stack, toByteOffset: 208)
  fib.store(RawPtr.null, toByteOffset: 232)
  fib.store(RawPtr.null, toByteOffset: 256)
  fib.store(RawPtr.null, toByteOffset: 264)   // anchor-sp (set when a handler parks / stops at a safepoint)
  fib.store(0, toByteOffset: 272)             // anchor-pc
  rtSchedRegInsert(sched, fib)                // in the registry so a handler stopped mid-drain is STW-walked
  fib.fiberInit(stackTop: stackTop, entry: RawPtr.ofFunc(rtSchedMailboxFiberMain), arg: fib)
  return fib
}

// Ensure a mailbox fiber will service the scheduled queue: wake a free one, else create one up to the cap
// (64). At the cap with all busy, the mailbox simply waits — a busy fiber pops it when it frees. Caller
// holds the scheduler lock; called on the 0→1 schedule edge.
fun rtSchedMailboxDispatch(sched: RawPtr) {
  let f: RawPtr = sched.load(fromByteOffset: 104)
  if f.isNull {
    let cnt: Int = sched.load(fromByteOffset: 112)
    if cnt < 64 {
      let nf = rtSchedMailboxFiberNew(sched)
      sched.store(cnt + 1, toByteOffset: 112)
      nf.store(0, toByteOffset: 168)
      rtSchedEnqueue(sched, nf)
      rtSchedWake(sched, false)
    }
  } else {
    let pn: RawPtr = f.load(fromByteOffset: 256)
    sched.store(pn, toByteOffset: 104)                           // free = f->pool_next
    f.store(RawPtr.null, toByteOffset: 256)
    f.store(0, toByteOffset: 168)
    rtSchedEnqueue(sched, f)
    rtSchedWake(sched, false)
  }
}

// ---- Live-fiber registry + self-hosted STW root walk (task 128.3.2). The registry (head at sched+128,
// intrusive doubly-linked through fib reg-next/reg-prev) tracks every live user fiber so a stop-the-world
// can enumerate them; each parked fiber carries a user-frame anchor its C dispatch shim captured, which
// rtWalkFrom reads directly — no libunwind. Maintained under the scheduler lock (insert on spawn, remove
// on completion). ----

fun rtSchedRegInsert(sched: RawPtr, fib: RawPtr) {
  let head: RawPtr = sched.load(fromByteOffset: 128)
  fib.store(RawPtr.null, toByteOffset: 248)   // prev = null (new head)
  fib.store(head, toByteOffset: 240)          // next = old head
  if head.isNull {
  } else {
    head.store(fib, toByteOffset: 248)        // old head's prev = fib
  }
  sched.store(fib, toByteOffset: 128)
}

fun rtSchedRegRemove(sched: RawPtr, fib: RawPtr) {
  let prev: RawPtr = fib.load(fromByteOffset: 248)
  let next: RawPtr = fib.load(fromByteOffset: 240)
  if prev.isNull {
    sched.store(next, toByteOffset: 128)      // fib was the head
  } else {
    prev.store(next, toByteOffset: 240)
  }
  if next.isNull {
  } else {
    next.store(prev, toByteOffset: 248)
  }
}

// Store the user-frame anchor (captured by a C dispatch shim) into the current fiber. Called from a Nomu
// park path just before ctxSwitchTo, so the STW walk finds a valid anchor on every parked fiber.
fun rtSchedSetAnchor(fib: RawPtr, anchorSp: RawPtr, anchorPc: Int) {
  fib.store(anchorSp, toByteOffset: 264)
  fib.store(anchorPc, toByteOffset: 272)
}

// A carrier acknowledges the stop-the-world and waits for resume. Called by a carrier that has reached a
// quiescent point under an active STW (idle at the loop top, or after its running fiber parked at a
// safepoint). Bumps the ack count (waking the initiator, which waits on it) and sleeps on the stw-gen
// futex until the initiator clears the request. One ack per carrier per STW.
fun rtSchedStwParkCarrier(sched: RawPtr) {
  let ack = sched.advanced(by: 144)
  ack.atomicFetchAdd(1, atByteOffset: 0)
  ack.futexWake(all: true)                       // the initiator waits on the ack count
  var g: Int = sched.atomicLoad(fromByteOffset: 152)
  while sched.atomicLoad(fromByteOffset: 136) != 0 {
    let gw = sched.advanced(by: 152)
    gw.futexWait(expected: g, timeoutMicros: 1000000)
    g = sched.atomicLoad(fromByteOffset: 152)
  }
}

// The safepoint slow path under the Nomu plan (called from __nomu_gc_poll_slow when __nomu_stop_world is
// set). The running fiber records the user-frame anchor its C poll shim captured, marks itself
// safepoint-stopped (state 4), and switches to its carrier — which then acks the STW and waits. On resume
// the carrier switches back in and this returns, so the fiber continues past the poll. The carrier holds
// the scheduler lock across the switch (the lock-coupled protocol), released here after switch-back-in.
fun nomuSchedSafepoint(sched: RawPtr, anchorSp: RawPtr, anchorPc: Int) {
  let self = RawPtr.tlsGet()
  rtSchedSetAnchor(self, anchorSp, anchorPc)
  rtSchedLock(sched)
  self.store(4, toByteOffset: 168)               // safepoint-stopped
  let carrierCtx: RawPtr = self.load(fromByteOffset: 232)
  self.ctxSwitchTo(carrierCtx)
  rtSchedUnlock(sched)
}

// Walk every parked fiber's roots from its stored user-frame anchor (rtWalkFrom, the self-hosted pcsp
// walk). Appends roots into outBuf; returns the count. Skips running fibers (their roots are the caller's
// live stack, reached differently) and fibers with no anchor. Caller has stopped the world (all target
// fibers parked at a safepoint), so the registry + anchors are stable.
fun nomuSchedWalkParked(sched: RawPtr, outBuf: RawPtr, cap: Int) -> Int {
  var n = 0
  var cur: RawPtr = sched.load(fromByteOffset: 128)
  while cur.isNull == false {
    let st: Int = cur.load(fromByteOffset: 168)
    var stopped = false
    if st == 2 { stopped = true }        // parked at sleep/join
    if st == 4 { stopped = true }        // stopped at a safepoint poll (STW)
    if stopped {
      let sp: RawPtr = cur.load(fromByteOffset: 264)
      if sp.isNull == false {
        let pc: Int = cur.load(fromByteOffset: 272)
        n = rtWalkFrom(sp, pc, outBuf, n, cap)
      }
    }
    cur = cur.load(fromByteOffset: 240)
  }
  return n
}

// ---- C-callable entry points (symbols nomu_fn_nomuSched*; runtime.c dispatches to these) ----

// Allocate + init a scheduler. Returns the opaque Sched handle the C side stashes as rt_nomu_sched.
fun nomuSchedNew() -> RawPtr {
  let sched = RawPtr.alloc(bytes: 256, align: 16)
  sched.store(RawPtr.null, toByteOffset: 0)
  sched.store(RawPtr.null, toByteOffset: 8)
  sched.store(0, toByteOffset: 16)
  sched.store(0, toByteOffset: 24)
  sched.store(0, toByteOffset: 32)
  sched.store(0, toByteOffset: 40)
  sched.store(0, toByteOffset: 48)                       // timer-mutex
  sched.store(0, toByteOffset: 56)                       // timer-gen
  sched.store(0, toByteOffset: 64)                       // timer-count
  let ents = RawPtr.alloc(bytes: 256 * 16, align: 8)     // timer heap (256 entries, matching the C runtime)
  sched.store(ents, toByteOffset: 72)
  sched.store(RawPtr.null, toByteOffset: 80)             // mbox-sched-head
  sched.store(RawPtr.null, toByteOffset: 88)             // mbox-sched-tail
  sched.store(0, toByteOffset: 96)                       // active-drains
  sched.store(RawPtr.null, toByteOffset: 104)            // mbfiber-free (pool free-list)
  sched.store(0, toByteOffset: 112)                      // mbfiber-count
  sched.store(RawPtr.null, toByteOffset: 120)            // drain-fn-ptr (set at boot)
  sched.store(RawPtr.null, toByteOffset: 128)            // live-fiber registry head
  sched.store(0, toByteOffset: 136)                      // stw-request
  sched.store(0, toByteOffset: 144)                      // stw-ack
  sched.store(0, toByteOffset: 152)                      // stw-gen
  sched.store(0, toByteOffset: 160)                      // ncarriers (set at boot)
  return sched
}

// Sleep the current fiber for `ms` milliseconds: register the deadline on the timer heap and park, holding
// the scheduler lock across both so the timer thread's unpark cannot re-queue us before our context is
// saved (lock-handoff spanning scheduler↔timer). Returns `ms`. The C rt_sleep_ms shim dispatches here.
fun nomuSchedSleep(sched: RawPtr, ms: Int, anchorSp: RawPtr, anchorPc: Int) -> Int {
  let self = RawPtr.tlsGet()
  rtSchedSetAnchor(self, anchorSp, anchorPc)   // user-frame anchor for the STW walk (128.3.2)
  let expiry: Int = RawPtr.monotonicNanos() + ms * 1000000
  rtSchedLock(sched)
  rtSchedMutexLockAt(sched.advanced(by: 48))
  rtSchedTimerPush(sched, expiry, self)
  rtSchedMutexUnlockAt(sched.advanced(by: 48))
  rtSchedWakeTimer(sched)
  self.store(2, toByteOffset: 168)
  let carrierCtx: RawPtr = self.load(fromByteOffset: 232)
  self.ctxSwitchTo(carrierCtx)
  rtSchedUnlock(sched)
  return ms
}

// Spawn a runnable fiber over the given C-ABI entry (void*(void*)). Returns the fiber handle, which the C
// spawn_join shim passes back to nomuSchedJoin. Bumps the active count and wakes an idle carrier.
fun nomuSchedSpawn(sched: RawPtr, entry: RawPtr, arg: RawPtr) -> RawPtr {
  let fib = rtSchedFiberNew(sched, entry, arg)
  sched.atomicFetchAdd(1, atByteOffset: 32)
  rtSchedLock(sched)
  fib.store(0, toByteOffset: 168)
  rtSchedRegInsert(sched, fib)          // track in the live-fiber registry (STW enumeration, 128.3.2)
  rtSchedEnqueue(sched, fib)
  rtSchedUnlock(sched)
  rtSchedWake(sched, false)
  return fib
}

// Await a fiber and return its result. Called from within the joining fiber, which parks lock-coupled
// (identifying itself via rt_current) if the target has not completed.
fun nomuSchedJoin(sched: RawPtr, target: RawPtr, anchorSp: RawPtr, anchorPc: Int) -> RawPtr {
  rtSchedLock(sched)
  let st: Int = target.load(fromByteOffset: 168)
  if st == 3 {
    rtSchedUnlock(sched)
  } else {
    let me = RawPtr.tlsGet()
    rtSchedSetAnchor(me, anchorSp, anchorPc)   // user-frame anchor for the STW walk (128.3.2)
    target.store(me, toByteOffset: 224)
    me.store(2, toByteOffset: 168)
    let carrierCtx: RawPtr = me.load(fromByteOffset: 232)
    me.ctxSwitchTo(carrierCtx)
    rtSchedUnlock(sched)
  }
  return target.load(fromByteOffset: 216)
}

// Fire-and-forget send: enqueue `msg` on `mailbox` (runtime.h ABI offsets) and return. On the 0→1
// schedule edge, append the mailbox to the global scheduled queue, bump active-drains, and dispatch a
// mailbox fiber. The C rt_actor_send shim dispatches here.
fun nomuSchedActorSend(sched: RawPtr, mailbox: RawPtr, msg: RawPtr) {
  rtSchedLock(sched)
  msg.store(RawPtr.null, toByteOffset: 8)              // msg->next = null
  let tail: RawPtr = mailbox.load(fromByteOffset: 16) // mb_tail
  if tail.isNull {
    mailbox.store(msg, toByteOffset: 8)               // mb_head = msg
  } else {
    tail.store(msg, toByteOffset: 8)                  // mb_tail->next = msg
  }
  mailbox.store(msg, toByteOffset: 16)                // mb_tail = msg
  let sch: Int = mailbox.load(fromByteOffset: 24)     // scheduled
  if sch == 0 {
    mailbox.store(1, toByteOffset: 24)
    mailbox.store(RawPtr.null, toByteOffset: 32)      // sched_next = null
    let stail: RawPtr = sched.load(fromByteOffset: 88)
    if stail.isNull {
      sched.store(mailbox, toByteOffset: 80)
      sched.store(mailbox, toByteOffset: 88)
    } else {
      stail.store(mailbox, toByteOffset: 32)
      sched.store(mailbox, toByteOffset: 88)
    }
    sched.atomicFetchAdd(1, atByteOffset: 96)          // active-drains++
    rtSchedMailboxDispatch(sched)
  }
  rtSchedUnlock(sched)
}

// Pop the next message from `mailbox` (FIFO), or null when empty. On empty, clear scheduled and drop
// active-drains; if that reaches quiescence (no drains, no user fibers), stop. Called from codegen's
// nomu_actor_drain via the C rt_mailbox_pop shim.
fun nomuSchedMailboxPop(sched: RawPtr, mailbox: RawPtr) -> RawPtr {
  rtSchedLock(sched)
  let msg: RawPtr = mailbox.load(fromByteOffset: 8)   // mb_head
  if msg.isNull {
    mailbox.store(0, toByteOffset: 24)                // scheduled = 0 (1→0 edge)
    let r: Int = sched.atomicFetchAdd(-1, atByteOffset: 96)
    if r == 1 {
      let act: Int = sched.atomicLoad(fromByteOffset: 32)
      if act == 0 {
        rtSchedSignalStop(sched)
      }
    }
    rtSchedUnlock(sched)
    return RawPtr.null
  }
  let nx: RawPtr = msg.load(fromByteOffset: 8)        // msg->next
  mailbox.store(nx, toByteOffset: 8)                  // mb_head = next
  if nx.isNull {
    mailbox.store(RawPtr.null, toByteOffset: 16)      // mb_tail = null
  }
  rtSchedUnlock(sched)
  return msg
}

// Boot the scheduler: record the actor drain function, spawn the main fiber over the user entry, start
// ncarriers-1 carrier threads + the timer thread, run the scheduler loop on the calling thread too, and
// return once quiescent (all carriers exited). Called from C main when NOMU_SCHED=nomu.
fun nomuSchedBoot(sched: RawPtr, entryFn: RawPtr, ncarriers: Int, drainFn: RawPtr) {
  sched.store(drainFn, toByteOffset: 120)             // nomu_actor_drain, called by mailbox fibers
  sched.store(ncarriers, toByteOffset: 160)           // total carriers, for the STW ack count (128.3.2)
  nomuSchedSpawn(sched, entryFn, RawPtr.null)
  let handles = RawPtr.alloc(bytes: 8 * ncarriers, align: 8)
  var c = 1
  while c < ncarriers {
    let ctx = RawPtr.alloc(bytes: 168, align: 16)
    let carg = RawPtr.alloc(bytes: 16, align: 8)
    carg.store(sched, toByteOffset: 0)
    carg.store(ctx, toByteOffset: 8)
    let h = handles.advanced(by: 8 * c)
    h.threadCreate(entry: RawPtr.ofFunc(rtSchedCarrierMain), arg: carg)
    c = c + 1
  }
  // The timer thread (wakeup feeder): one raw thread draining the deadline heap.
  let th = RawPtr.alloc(bytes: 8, align: 8)
  th.threadCreate(entry: RawPtr.ofFunc(rtSchedTimerMain), arg: sched)
  let mainCtx = RawPtr.alloc(bytes: 168, align: 16)
  rtSchedLoop(sched, mainCtx)
  var k = 1
  while k < ncarriers {
    let h = handles.advanced(by: 8 * k)
    h.threadJoin()
    k = k + 1
  }
  th.threadJoin()
}
