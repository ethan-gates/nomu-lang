load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "frontend",
    srcs = glob(["*.swift"]),
    module_name = "frontend",
    visibility = ["//visibility:public"],
)

swift_test(
    name = "frontend_tests",
    srcs = glob(["*.swift"]) + glob(["Tests/**/*.swift"]),
    module_name = "frontend",
)
