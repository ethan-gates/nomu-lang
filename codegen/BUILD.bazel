load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "codegen",
    srcs = glob(["*.swift"]),
    module_name = "codegen",
    deps = ["//frontend"],
    visibility = ["//visibility:public"],
)

swift_test(
    name = "codegen_tests",
    srcs = glob(["*.swift"]) + glob(["Tests/**/*.swift"]),
    module_name = "codegen",
    deps = ["//frontend"],
)
